        <mxCell id="access-entry-code" value="aws eks create-access-entry \&#10;  --cluster-name my-cluster \&#10;  --principal-arn arn:aws:iam::123456789012:user/developer \&#10;  --type STANDARD&#10;&#10;aws eks associate-access-policy \&#10;  --cluster-name my-cluster \&#10;  --principal-arn arn:aws:iam::123456789012:user/developer \&#10;  --policy-arn arn:aws:eks::aws:cluster-access-policy/AmazonEKSViewPolicy \&#10;  --access-scope type=namespace,namespaces=default" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;spacingTop=5;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1">
