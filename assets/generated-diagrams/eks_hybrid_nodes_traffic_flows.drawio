                <!-- EKS Control Plane -->
                <mxCell id="30" value="&lt;b&gt;EKS Control Plane&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=5;" vertex="1" parent="20">
                    <mxGeometry x="600" y="45" width="300" height="100" as="geometry" />
                </mxCell>
                <mxCell id="31" value="&lt;b&gt;API Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;port 443&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1565C0;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="20">
                    <mxGeometry x="620" y="75" width="120" height="45" as="geometry" />
