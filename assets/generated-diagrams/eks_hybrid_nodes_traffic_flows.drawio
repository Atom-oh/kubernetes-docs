                <mxCell id="32" value="&lt;b&gt;Controller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1565C0;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="20">
                    <mxGeometry x="760" y="75" width="120" height="45" as="geometry" />
                </mxCell>

                <!-- VPC with ENIs -->
                <mxCell id="33" value="&lt;b&gt;VPC&lt;/b&gt; (API Server ENIs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;verticalAlign=top;spacingTop=5;" vertex="1" parent="20">
                    <mxGeometry x="600" y="180" width="300" height="70" as="geometry" />
                </mxCell>
                <mxCell id="34" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#E65100&quot;&gt;ENI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1;" vertex="1" parent="20">
                    <mxGeometry x="620" y="210" width="50" height="25" as="geometry" />
