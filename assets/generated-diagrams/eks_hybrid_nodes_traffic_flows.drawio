                <mxCell id="35" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#E65100&quot;&gt;ENI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1;" vertex="1" parent="20">
                    <mxGeometry x="690" y="210" width="50" height="25" as="geometry" />
                </mxCell>
                <mxCell id="36" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#E65100&quot;&gt;ENI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1;" vertex="1" parent="20">
                    <mxGeometry x="760" y="210" width="50" height="25" as="geometry" />
                </mxCell>
                <mxCell id="37" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#E65100&quot;&gt;ENI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=1;" vertex="1" parent="20">
                    <mxGeometry x="830" y="210" width="50" height="25" as="geometry" />
                </mxCell>

                <!-- Cloud Pod -->
                <mxCell id="38" value="&lt;b&gt;Cloud Pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(on EC2 node in VPC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=2;fontSize=11;" vertex="1" parent="20">
                    <mxGeometry x="1050" y="180" width="160" height="60" as="geometry" />
                </mxCell>

                <!-- TGW -->
                <mxCell id="39" value="TGW / VGW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="20">
                    <mxGeometry x="670" y="290" width="150" height="35" as="geometry" />
                </mxCell>

                <!-- Arrow CP to VPC -->
                <mxCell id="40" value="" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=1;strokeColor=#999999;" edge="1" parent="20">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="750" y="145" as="sourcePoint" />
                        <mxPoint x="750" y="180" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <!-- Arrow VPC to TGW -->
                <mxCell id="41" value="" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=1;strokeColor=#999999;" edge="1" parent="20">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="750" y="250" as="sourcePoint" />
                        <mxPoint x="750" y="290" as="targetPoint" />
                    </mxGeometry>
                </mxCell>

                <!-- ==================== VPN / DX Zone ==================== -->
                <mxCell id="50" value="&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#8C4FFF&quot;&gt;&lt;b&gt;VPN / Direct Connect&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="680" y="455" width="200" height="25" as="geometry" />
                </mxCell>

                <!-- ==================== On-Premises ==================== -->
                <mxCell id="60" value="&lt;b&gt;On-Premises&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;fontSize=14;fontStyle=0;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
                    <mxGeometry x="30" y="490" width="1540" height="260" as="geometry" />
                </mxCell>

                <!-- Hybrid Node -->
                <mxCell id="61" value="&lt;b&gt;Hybrid Node&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=5;" vertex="1" parent="60">
                    <mxGeometry x="250" y="40" width="320" height="100" as="geometry" />
                </mxCell>
                <mxCell id="62" value="&lt;b&gt;kubelet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;port 10250&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1565C0;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="60">
                    <mxGeometry x="270" y="65" width="100" height="45" as="geometry" />
                </mxCell>
                <mxCell id="63" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;iptables/DNAT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1565C0;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="60">
                    <mxGeometry x="385" y="65" width="100" height="45" as="geometry" />
                </mxCell>

                <!-- On-Prem Pod -->
                <mxCell id="64" value="&lt;b&gt;Hybrid Pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(on hybrid node)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;" vertex="1" parent="60">
                    <mxGeometry x="250" y="160" width="160" height="60" as="geometry" />
                </mxCell>

                <!-- Webhook Pod -->
                <mxCell id="65" value="&lt;b&gt;Webhook Pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;port 8443&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=2;fontSize=11;" vertex="1" parent="60">
                    <mxGeometry x="450" y="160" width="160" height="60" as="geometry" />
                </mxCell>

                <!-- Another Hybrid Pod (for pod-pod) -->
                <mxCell id="66" value="&lt;b&gt;Hybrid Pod B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(different node)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;" vertex="1" parent="60">
                    <mxGeometry x="660" y="160" width="160" height="60" as="geometry" />
                </mxCell>

                <!-- ==================== Traffic Flow Arrows ==================== -->

                <!-- Flow 1: Kubelet → API Server (blue) -->
                <mxCell id="100" value="&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#1565C0&quot;&gt;&lt;b&gt;① Kubelet → API Server&lt;/b&gt;&lt;br&gt;TCP 443&lt;/font&gt;" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#1565C0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1">
                    <mxGeometry x="-0.3" y="-15" relative="1" as="geometry">
                        <mxPoint x="350" y="555" as="sourcePoint" />
                        <mxPoint x="660" y="310" as="targetPoint" />
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- Flow 2: API Server → Kubelet (orange) -->
                <mxCell id="101" value="&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#E65100&quot;&gt;&lt;b&gt;② API Server → Kubelet&lt;/b&gt;&lt;br&gt;TCP 10250&lt;/font&gt;" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#E65100;" edge="1" parent="1">
                    <mxGeometry x="-0.3" y="15" relative="1" as="geometry">
                        <mxPoint x="680" y="310" as="sourcePoint" />
                        <mxPoint x="380" y="555" as="targetPoint" />
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- Flow 3: Pod → API Server (green) -->
                <mxCell id="102" value="&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#2E7D32&quot;&gt;&lt;b&gt;③ Pod → API Server&lt;/b&gt;&lt;br&gt;TCP 443 (DNAT via kube-proxy)&lt;/font&gt;" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2E7D32;" edge="1" parent="1">
                    <mxGeometry x="-0.2" y="-15" relative="1" as="geometry">
                        <mxPoint x="310" y="650" as="sourcePoint" />
                        <mxPoint x="640" y="310" as="targetPoint" />
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- Flow 4: API Server → Webhook Pod (red) -->
                <mxCell id="103" value="&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#C62828&quot;&gt;&lt;b&gt;④ API Server → Webhook&lt;/b&gt;&lt;br&gt;TCP 8443 (routable pod CIDR)&lt;/font&gt;" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#C62828;" edge="1" parent="1">
                    <mxGeometry x="-0.2" y="15" relative="1" as="geometry">
                        <mxPoint x="700" y="310" as="sourcePoint" />
                        <mxPoint x="530" y="650" as="targetPoint" />
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- Flow 5: Hybrid Pod ↔ Hybrid Pod VXLAN (purple) -->
                <mxCell id="104" value="&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#7B1FA2&quot;&gt;&lt;b&gt;⑤ Hybrid Pod ↔ Hybrid Pod&lt;/b&gt;&lt;br&gt;UDP 8472 (VXLAN encap)&lt;/font&gt;" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=3;strokeColor=#7B1FA2;" edge="1" parent="1">
                    <mxGeometry y="15" relative="1" as="geometry">
                        <mxPoint x="410" y="690" as="sourcePoint" />
                        <mxPoint x="660" y="690" as="targetPoint" />
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- Flow 6: Cloud Pod ↔ Hybrid Pod (teal) -->
                <mxCell id="105" value="&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#00695C&quot;&gt;&lt;b&gt;⑥ Cloud Pod ↔ Hybrid Pod&lt;/b&gt;&lt;br&gt;East-west via VPC route&lt;/font&gt;" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=3;strokeColor=#00695C;" edge="1" parent="1">
                    <mxGeometry x="0.1" y="-15" relative="1" as="geometry">
                        <mxPoint x="1080" y="310" as="sourcePoint" />
                        <mxPoint x="800" y="650" as="targetPoint" />
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- ==================== Legend ==================== -->
                <mxCell id="110" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Traffic Flow Legend&lt;/b&gt;&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=1;fontSize=11;fontStyle=0;startSize=22;rounded=1;arcSize=10;" vertex="1" parent="1">
                    <mxGeometry x="30" y="770" width="1540" height="200" as="geometry" />
                </mxCell>

                <!-- Flow descriptions -->
                <mxCell id="111" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1565C0&quot;&gt;① Kubelet → API Server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Node status reporting, pod status updates.&lt;br&gt;Path: Kubelet → VPN/DX → VPC ENI → API Server (TCP 443)&lt;br&gt;Or via public internet if endpoint is public.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1;verticalAlign=top;spacingTop=5;spacingLeft=8;align=left;fontSize=11;" vertex="1" parent="110">
                    <mxGeometry x="15" y="30" width="360" height="75" as="geometry" />
                </mxCell>
                <mxCell id="112" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#E65100&quot;&gt;② API Server → Kubelet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Log/exec/port-forward requests.&lt;br&gt;Path: API Server → VPC ENI → VPN/DX → Kubelet (TCP 10250)&lt;br&gt;Requires outbound SG rule to remote node CIDR.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;verticalAlign=top;spacingTop=5;spacingLeft=8;align=left;fontSize=11;" vertex="1" parent="110">
                    <mxGeometry x="390" y="30" width="360" height="75" as="geometry" />
                </mxCell>
                <mxCell id="113" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;③ Pod → API Server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Service account tokens, API calls from pods.&lt;br&gt;Path: Pod → kube-proxy DNAT → VPN/DX → VPC ENI → API (TCP 443)&lt;br&gt;Requires SG inbound from remote pod CIDR.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;verticalAlign=top;spacingTop=5;spacingLeft=8;align=left;fontSize=11;" vertex="1" parent="110">
                    <mxGeometry x="765" y="30" width="370" height="75" as="geometry" />
                </mxCell>
                <mxCell id="114" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C62828&quot;&gt;④ API Server → Webhook Pod&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Admission webhooks, conversion webhooks.&lt;br&gt;Path: API Server → VPC ENI → VPN/DX → Pod (TCP 8443)&lt;br&gt;&lt;b&gt;Requires routable pod CIDR.&lt;/b&gt; Not possible with unroutable pods.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1;verticalAlign=top;spacingTop=5;spacingLeft=8;align=left;fontSize=11;" vertex="1" parent="110">
                    <mxGeometry x="15" y="115" width="360" height="75" as="geometry" />
                </mxCell>
                <mxCell id="115" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;⑤ Hybrid Pod ↔ Hybrid Pod&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Pod-to-pod communication across on-prem nodes.&lt;br&gt;Path: Pod → Cilium VXLAN encap (UDP 8472) → other node → Pod&lt;br&gt;Stays within on-premises network.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1;verticalAlign=top;spacingTop=5;spacingLeft=8;align=left;fontSize=11;" vertex="1" parent="110">
                    <mxGeometry x="390" y="115" width="360" height="75" as="geometry" />
                </mxCell>
                <mxCell id="116" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#00695C&quot;&gt;⑥ Cloud Pod ↔ Hybrid Pod&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;East-west traffic between cloud and on-prem pods.&lt;br&gt;Path: Cloud Pod → VPC route → TGW/VGW → VPN/DX → Hybrid Pod&lt;br&gt;&lt;b&gt;Requires routable pod CIDR&lt;/b&gt; and VPC route table entries.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;verticalAlign=top;spacingTop=5;spacingLeft=8;align=left;fontSize=11;" vertex="1" parent="110">
                    <mxGeometry x="765" y="115" width="370" height="75" as="geometry" />
                </mxCell>

            </root>
        </mxGraphModel>
    </diagram>
</mxfile>