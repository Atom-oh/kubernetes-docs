    <diagram id="eks_hybrid_traffic" name="EKS Hybrid Nodes - Traffic Flow Patterns">
        <mxGraphModel dx="1822" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0" />
