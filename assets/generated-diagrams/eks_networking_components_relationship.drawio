        <mxCell id="practice4" value="비용 최적화" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="520" width="240" height="30" as="geometry" />
