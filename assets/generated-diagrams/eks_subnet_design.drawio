        </mxCell>
        
        <mxCell id="public-desc" value="용도:&#xa;• 퍼블릭 로드 밸런서 (ALB/NLB)&#xa;• NAT 게이트웨이&#xa;• 바스티온 호스트&#xa;• 인터넷 게이트웨이 직접 연결&#xa;&#xa;크기: /24 (256개 IP)&#xa;특징: 인터넷 직접 접근 가능" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingTop=5;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="200" height="90" as="geometry" />
        </mxCell>
        
        <!-- Private Subnet Guide -->
