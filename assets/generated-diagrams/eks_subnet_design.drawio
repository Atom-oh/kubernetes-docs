          <mxGeometry x="320" y="760" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="private-desc" value="용도:&#xa;• EKS 워커 노드&#xa;• 내부 로드 밸런서&#xa;• 데이터베이스&#xa;• NAT 게이트웨이를 통한 인터넷 접근&#xa;&#xa;크기: /22 (1,024개 IP)&#xa;특징: 높은 보안, 대용량 IP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingTop=5;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="800" width="200" height="90" as="geometry" />
        </mxCell>
        
