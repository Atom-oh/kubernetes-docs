        <mxCell id="post-upgrade-items" value="✓ 클러스터 상태 확인&#10;✓ 노드 상태 검증&#10;✓ 시스템 포드 상태 확인&#10;✓ 애플리케이션 동작 테스트&#10;✓ 네트워킹 연결성 확인&#10;✓ 모니터링 및 로깅 검증" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacingTop=5;spacingLeft=10;strokeWidth=2;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1">
