                <mxCell id="67" value="&lt;b&gt;Hybrid Node 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;10.80.0.2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;strokeWidth=1;fontSize=11;" vertex="1" parent="65">
