                <!-- Security Group -->
                <mxCell id="41" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;EKS Cluster Security Group&lt;/b&gt;&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Inbound (auto):&lt;/b&gt; TCP 443 ← Remote Node/Pod CIDR&lt;br&gt;&lt;b&gt;Outbound (manual):&lt;/b&gt;&lt;br&gt;TCP 10250 → Remote Node CIDR (kubelet)&lt;br&gt;TCP 8443 → Remote Pod CIDR (webhooks)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalAlign=top;spacingTop=2;spacingLeft=8;fontSize=11;align=left;" vertex="1" parent="30">
