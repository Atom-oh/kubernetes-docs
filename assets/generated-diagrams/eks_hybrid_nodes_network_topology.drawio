                    <mxGeometry x="350" y="40" width="130" height="50" as="geometry" />
                </mxCell>
                <mxCell id="69" value="&lt;b&gt;GPU Node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;10.80.0.4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1;fontSize=11;" vertex="1" parent="65">
                    <mxGeometry x="510" y="40" width="130" height="50" as="geometry" />
                </mxCell>

                <!-- Pod Network -->
                <mxCell id="70" value="&lt;b&gt;Pod Network&lt;/b&gt; — Pod CIDR: 10.85.0.0/16 (Cilium VXLAN)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#558B2F;strokeWidth=2;fontSize=12;fontStyle=0;startSize=25;rounded=1;arcSize=6;" vertex="1" parent="60">
                    <mxGeometry x="150" y="120" width="700" height="80" as="geometry" />
                </mxCell>
