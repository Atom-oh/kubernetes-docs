  "cards": [
    {
      "dot": "cyan",
      "title": "Layering",
      "items": [
        "Kubernetes declares Pods, Services, and NetworkPolicies and delegates through the CNI contract",
        "The Cilium agent compiles those declarations into eBPF programs and maps",
        "Packet processing happens in the kernel, bypassing iptables chains"
      ]
    },
    {
      "dot": "emerald",
      "title": "What eBPF buys you",
      "items": [
        "Lookups are hash-map based, so performance degrades gently as rules grow",
        "It can replace kube-proxy and handle Service load balancing in the kernel",
        "Policy reaches beyond L3/L4 into L7 (HTTP, gRPC, Kafka)"
      ]
    },
    {
      "dot": "amber",
      "title": "Hubble",
      "items": [
        "It collects the flow events Cilium emits and renders service dependencies",
        "Traffic dropped by policy shows up with the reason attached",
        "You query it either through the CLI (hubble observe) or the UI"
      ]
    }
  ]
