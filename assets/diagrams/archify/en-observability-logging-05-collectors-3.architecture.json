  "cards": [
    {
      "dot": "orange",
      "title": "Processor order",
      "items": [
        "memory_limiter goes first to protect Collector memory",
        "k8sattributes attaches Pod and namespace metadata",
        "batch comes last, after filter and transform, to group the send unit"
      ]
    },
    {
      "dot": "cyan",
      "title": "Delivery conditions to verify",
      "items": [
        "Offsets and exporter queues are distinct state",
        "Test retries, duplicates, shutdown and backend records",
        "Do not promise fixed compression or message-count savings",
        "Offsets apply to file readers; queue state applies to exporters."
      ]
    }
