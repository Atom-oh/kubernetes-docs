  "cards": [
    {
      "dot": "rose",
      "title": "OPA Gatekeeper",
      "items": [
        "ConstraintTemplate: a template that defines the policy logic (Rego)",
        "Constraint: an instance of a ConstraintTemplate that applies the policy to specific resources",
        "Runs as an admission controller, intercepting requests sent to the API server and applying policies"
      ]
    },
    {
      "dot": "cyan",
      "title": "Kyverno · Kubewarden",
      "items": [
        "Kyverno: YAML-based ClusterPolicy/Policy — no need to learn Rego",
        "Kyverno additionally supports Verify Images and Clean Up policy types",
        "Kubewarden: policies written in various languages are compiled to Wasm modules and run on its policy server"
      ]
    },
    {
      "dot": "violet",
      "title": "Policy types",
      "items": [
        "Validate: checks that resources meet specific conditions — all three engines",
        "Mutate: automatically modifies resources — all three engines",
        "Generate: automatically creates other resources when a resource is created — Kyverno only"
      ]
    }
  ]
