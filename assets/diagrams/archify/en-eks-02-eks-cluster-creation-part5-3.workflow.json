  "cards": [
    {
      "dot": "cyan",
      "title": "Pre-upgrade checklist",
      "items": [
        "Review the removed and deprecated APIs between the current and target versions",
        "Check whether application manifests use API versions that were removed",
        "Upgrade dev and staging first and prepare a rollback plan"
      ]
    },
    {
      "dot": "emerald",
      "title": "Order and commands",
      "items": [
        "Start with the control plane: aws eks update-cluster-version --name my-cluster --kubernetes-version 1.31",
        "Raise node groups with aws eks update-nodegroup-version (cordon and drain are automatic)",
        "Finally align the VPC CNI, CoreDNS, and kube-proxy add-ons with the cluster version",
        "Move one minor version at a time (1.29 → 1.30 → 1.31)"
      ]
    },
    {
      "dot": "rose",
      "title": "Rollback constraints",
      "items": [
        "The EKS control plane cannot be downgraded",
        "Only node groups can be rolled back to an earlier version",
        "Assume it is irreversible and put the weight on prior testing and backups"
      ]
    }
  ]
