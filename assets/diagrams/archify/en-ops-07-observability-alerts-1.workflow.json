{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Rule state and resolution updates",
    "output": "en-ops-07-observability-alerts-1.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "legend": {
      "mode": "auto",
      "entries": {
        "external": {
          "label": "Waiting state"
        },
        "backend": {
          "label": "Evaluating state"
        },
        "security": {
          "label": "Firing state"
        }
      }
    },
    "locale": "en"
  },
  "lanes": [
    {
      "id": "state",
      "label": "Rule state"
    }
  ],
  "mainPath": [
    "inactive",
    "pending",
    "firing"
  ],
  "nodes": [
    {
      "id": "inactive",
      "lane": "state",
      "col": 0,
      "type": "external",
      "label": "Inactive",
      "sublabel": "condition not met",
      "width": 220
    },
    {
      "id": "pending",
      "lane": "state",
      "col": 1,
      "type": "backend",
      "label": "Pending",
      "sublabel": "for interval",
      "width": 220
    },
    {
      "id": "firing",
      "lane": "state",
      "col": 2,
      "type": "security",
      "label": "Firing",
      "sublabel": "delivery is separate",
      "width": 220
    }
  ],
  "edges": [
    {
      "id": "t1",
      "from": "inactive",
      "to": "pending",
      "label": "Condition met"
    },
    {
      "id": "t2",
      "from": "pending",
      "to": "firing",
      "label": "for elapsed"
    },
    {
      "id": "t4",
      "from": "pending",
      "to": "inactive",
      "label": "cleared early",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "t5",
      "from": "firing",
      "to": "inactive",
      "label": "firing ends",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Evaluation states",
      "items": [
        "Inactive: no currently active alert instance",
        "Pending: waiting for a continuously satisfied for duration",
        "Firing: the rule instance is active"
      ]
    },
    {
      "dot": "emerald",
      "title": "Timing and missing data",
      "items": [
        "A zero for duration can fire on the first matching evaluation",
        "keep_firing_for optionally holds firing after the condition clears",
        "A missing series is not proof that the service recovered"
      ]
    },
    {
      "dot": "amber",
      "title": "Resolved is a delivery update",
      "items": [
        "When firing ends, Prometheus can send a resolution update",
        "External recovery messages depend on send_resolved and routing",
        "ALERTS observes Pending/Firing and is not a complete audit trail"
      ]
    }
  ]
}
