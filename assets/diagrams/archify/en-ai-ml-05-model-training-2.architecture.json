  "cards": [
    {
      "dot": "cyan",
      "title": "Slurm Control Plane",
      "items": [
        "slurmctld: central controller for jobs, partitions, and resources (StatefulSet with PVC)",
        "slurmdbd: job accounting and cluster state (StatefulSet with MySQL/MariaDB)",
        "slurmrestd: REST API for programmatic job submission (Deployment with Service)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Compute and Storage",
      "items": [
        "slurmd: compute daemon running on GPU nodes (DaemonSet)",
        "SlurmNodeSet gpu-a100: 4x p4d.24xlarge, 8x A100 GPU each",
        "FSx for Lustre mounted at /shared and shared by every compute pod"
      ]
    },
    {
      "dot": "amber",
      "title": "Access and Operations",
      "items": [
        "Login Pod: SSH access point exposed through the NLB",
        "JupyterHub submits jobs through the slurmrestd REST API",
        "ArgoCD GitOps deployment, Karpenter GPU NodePool auto scaling"
      ]
    }
  ]
