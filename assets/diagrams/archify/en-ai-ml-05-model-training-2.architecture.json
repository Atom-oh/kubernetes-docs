        "note": "Users SSH into the login pod through the NLB, or submit jobs from JupyterHub via the slurmrestd REST API."
      },
      {
        "id": "job-scheduling",
        "label": "Job scheduling",
        "focus": [
          "slurmctld",
          "slurmdbd",
          "slurmrestd",
          "slurmd",
          "fsx"
        ],
        "note": "slurmctld dispatches jobs to the GPU slurmd pods, records accounting in slurmdbd, and keeps data and checkpoints on FSx for Lustre."
      },
      {
        "id": "deploy-scale",
        "label": "Deployment and scaling",
        "focus": [
          "argocd",
          "ecr",
          "karpenter",
          "nodepool",
          "slurmd"
        ],
        "note": "ArgoCD deploys the Slurm control plane via GitOps, Karpenter grows compute through the GPU NodePool, and images come from Amazon ECR."
      }
    ]
