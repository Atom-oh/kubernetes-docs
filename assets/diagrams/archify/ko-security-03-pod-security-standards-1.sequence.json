    "views": [
      {
        "id": "admission",
        "label": "Admission 검증",
        "focus": [
          "user",
          "api",
          "psa",
          "ns"
        ],
        "note": "API Server가 Pod 요청을 PSA Controller에 넘기고, PSA는 네임스페이스 레이블로 적용 수준을 읽는다."
      },
      {
        "id": "allow",
        "label": "정책 준수",
        "focus": [
          "psa",
          "api",
          "etcd",
          "user"
        ],
        "note": "restricted 수준을 만족하면 승인되어 etcd에 저장되고 201 Created를 받는다."
      },
      {
        "id": "deny",
        "label": "정책 위반",
        "focus": [
          "psa",
          "api",
          "user"
        ],
        "note": "enforce 모드에서 위반한 Pod는 거부되고 403 Forbidden으로 응답한다."
      }
    ]
  },
