    "views": [
      {
        "id": "settings",
        "label": "Requests and limits",
        "focus": [
          "requests",
          "limits",
          "pod"
        ],
        "note": "requests is the minimum amount of resources guaranteed to the container; limits is the maximum it can use."
      },
      {
        "id": "qos",
        "label": "QoS class assignment",
        "focus": [
          "pod",
          "qos",
          "besteffort",
          "burstable",
          "guaranteed"
        ],
        "note": "Kubernetes automatically assigns a QoS class based on the pod's requests and limits settings."
      },
      {
        "id": "order",
        "label": "Eviction order",
        "focus": [
          "besteffort",
          "burstable",
          "guaranteed",
          "eviction"
        ],
        "note": "When resources run short, BestEffort pods are evicted first, Burstable next, and Guaranteed pods last."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Resource settings"
        },
