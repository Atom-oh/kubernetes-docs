{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Sidecar Injection Workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "webhook",
        "label": "Admission Webhook call",
        "focus": [
          "request",
          "webhook",
          "check"
        ],
        "note": "A pod creation request at the API server calls the Proxy Injector's admission webhook (8443), which starts checking injection conditions."
      },
      {
        "id": "conditions",
        "label": "Check injection conditions",
        "focus": [
          "check",
          "ns",
          "podann",
          "workload"
        ],
        "note": "The namespace annotation, pod annotation (linkerd.io/inject), and workload type decide whether the sidecar is injected."
      },
      {
        "id": "inject",
        "label": "Inject sidecar and create pod",
        "focus": [
          "ns",
          "podann",
          "workload",
          "inject",
          "create"
        ],
        "note": "If the conditions are met, the linkerd-proxy sidecar is added to the pod spec and pod creation proceeds with it."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Pod request / result"
        },
        "backend": {
          "label": "Proxy Injector"
        },
        "cloud": {
          "label": "Injection condition"
        },
        "security": {
          "label": "Sidecar injection"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "apiserver",
      "label": "API Server"
    },
    {
      "id": "injector",
      "label": "Proxy Injector (Admission Webhook)"
    },
    {
      "id": "conditions",
      "label": "Injection Conditions"
    },
    {
      "id": "result",
      "label": "Injection Done · Pod Creation"
    }
  ],
  "groups": [
    {
      "id": "cond_group",
