  "edges": [
    {
      "from": "step1",
      "to": "step2",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "step2",
      "to": "step3",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "step2",
      "to": "analysisStart",
      "label": "start in background",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "analysisStart",
      "to": "measure",
      "label": "runs in parallel",
      "role": "async"
    },
    {
      "from": "measure",
      "to": "rollback",
      "label": "failure",
      "variant": "security",
      "role": "error"
    }
