          "label": "Rollout step"
        },
        "cloud": {
          "label": "Analysis start"
        },
        "database": {
          "label": "Metric measurement"
        },
        "security": {
          "label": "Rollback"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "canary",
      "label": "Canary steps (Rollout steps)"
    },
    {
      "id": "analysis",
      "label": "Background Analysis"
