{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Background Analysis Behavior",
    "locale": "en",
    "output": "public/archmaps/en-service-mesh-istio-advanced-08-argo-rollouts-5.html",
    "animation": "trace",
