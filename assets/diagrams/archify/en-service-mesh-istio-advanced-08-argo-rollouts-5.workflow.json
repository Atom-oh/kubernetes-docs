      }
    ],
    "requiredPaths": [
      {
        "from": "step1",
        "to": "step3"
      },
      {
        "from": "step2",
        "to": "rollback"
      }
    ]
  },
  "nodes": [
    {
      "id": "step1",
      "lane": "canary",
      "col": 0,
      "type": "backend",
      "label": "Step 1",
      "sublabel": "setWeight 10 · wait 2m",
      "width": 150
    },
    {
      "id": "step2",
      "lane": "canary",
      "col": 1,
      "type": "backend",
      "label": "Step 2",
      "sublabel": "setWeight 30 · wait 2m",
      "tag": "startingStep: 2",
      "width": 150
    },
    {
      "id": "step3",
      "lane": "canary",
      "col": 2,
      "type": "backend",
      "label": "Step 3",
      "sublabel": "setWeight 50",
      "width": 150
    },
    {
      "id": "analysisStart",
      "lane": "analysis",
      "col": 2,
      "type": "cloud",
      "label": "Analysis start",
      "sublabel": "AnalysisRun created",
      "width": 150
    },
    {
      "id": "measure",
      "lane": "analysis",
      "col": 3,
      "type": "database",
      "label": "Measure every 30s",
      "sublabel": "success-rate template",
      "width": 180
    },
    {
      "id": "rollback",
      "lane": "analysis",
      "col": 4,
      "type": "security",
      "label": "Immediate rollback on failure",
      "sublabel": "Canary aborted",
      "width": 250
    }
