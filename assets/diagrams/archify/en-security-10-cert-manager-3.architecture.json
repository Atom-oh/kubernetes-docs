    "views": [
      {
        "id": "csr-path",
        "label": "1-2. CSR request",
        "focus": [
          "envoy",
          "csr-agent",
          "cm-controller",
          "cert-request"
        ],
        "note": "The Envoy sidecar sends a CSR to istio-csr, which creates a CertificateRequest in cert-manager."
      },
      {
        "id": "issue-path",
        "label": "3-4. Issuance",
        "focus": [
          "cert-request",
          "cluster-issuer",
          "ca-backend",
          "svid"
        ],
        "note": "The CertificateRequest is signed through the ClusterIssuer (istio-ca) by the external PKI, producing a SPIFFE SVID certificate."
      },
      {
        "id": "return-path",
        "label": "5. Return and mTLS",
        "focus": [
          "svid",
          "envoy",
          "app"
        ],
        "note": "The issued SVID returns to Envoy, which uses it to establish mTLS between workloads."
      }
    ]
  },
