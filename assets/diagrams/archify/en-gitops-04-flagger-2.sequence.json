      "from": 292,
      "to": 756,
      "type": "backend"
    },
    {
      "participant": "prom",
      "from": 390,
      "to": 442,
      "type": "database"
    },
    {
      "participant": "prom",
      "from": 492,
      "to": 506,
      "type": "database"
    }
  ]
}