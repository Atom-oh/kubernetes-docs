        "focus": [
          "start",
          "weight",
          "localpref",
          "origin_local",
          "aspath"
        ],
        "note": "Weight is Cisco-specific and applies only to the local router; LOCAL_PREF expresses preference inside the AS (default 100)."
      },
      {
        "id": "steps-5-8",
        "label": "Steps 5-8",
        "focus": [
          "origin",
          "med",
          "ebgp",
          "igp"
        ],
        "note": "Origin type is preferred in the order IGP(i) > EGP(e) > Incomplete(?); MED is the Multi-Exit Discriminator."
      },
      {
        "id": "steps-9-11",
        "label": "Steps 9-11 and selection",
        "focus": [
          "oldest",
          "routerid",
          "neighborip",
          "best"
        ],
        "note": "If every earlier step ties, the oldest route, then the lowest Router ID, then the lowest neighbor IP settles the choice."
      }
    ]
  },
