    {
      "dot": "emerald",
      "title": "Developer interface",
      "items": [
        "Claim (XC) is a namespace-scoped projection of a Composite Resource",
        "A developer in team-alpha can create a DatabaseClaim without cluster-level permissions"
      ]
    },
    {
      "dot": "amber",
      "title": "Platform abstraction",
      "items": [
        "XRD defines the schema for both the XR and its Claim",
        "Composition is the recipe: given an XR, create these Managed Resources and patch XR spec values into MR fields"
      ]
    },
    {
      "dot": "violet",
      "title": "Cloud provider layer",
      "items": [
        "Managed Resource is a 1:1 cluster-scoped representation of an external cloud resource",
        "Provider controllers continuously reconcile MRs against the AWS API"
      ]
    }
