        "id": "control-plane",
        "label": "Four control-plane services",
        "focus": [
          "dag-processor",
          "scheduler",
          "api-server",
          "triggerer",
          "postgres"
        ],
        "note": "Four single-purpose services read and write the PostgreSQL metadata database as shared state."
      },
      {
        "id": "k8s-executor",
        "label": "KubernetesExecutor path",
        "focus": [
          "scheduler",
          "k8s-pod"
        ],
        "note": "The scheduler creates one Kubernetes pod per task directly. No Redis is needed."
      },
      {
        "id": "celery-executor",
        "label": "CeleryExecutor path",
        "focus": [
          "scheduler",
          "redis",
          "celery-worker"
        ],
        "note": "The scheduler queues tasks to the Redis broker and Celery worker pods consume them. Redis is required only here."
      }
    ]
  },
