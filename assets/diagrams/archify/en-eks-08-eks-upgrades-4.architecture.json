  "cards": [
    {
      "dot": "orange",
      "title": "AWS Managed Add-on Procedure",
      "items": [
        "List installed managed add-ons with aws eks list-addons",
        "Check current and available versions with describe-addon / describe-addon-versions",
        "Upgrade with aws eks update-addon --resolve-conflicts PRESERVE or eksctl update addon --preserve"
      ]
    },
    {
      "dot": "rose",
      "title": "Common Issues",
      "items": [
        "Configuration conflicts: custom configuration vs. the new version",
        "Compatibility issues: add-on vs. Kubernetes version",
        "Resource constraints: not enough resources for the upgrade"
      ]
    },
    {
      "dot": "slate",
      "title": "Troubleshooting Steps",
      "items": [
        "Check add-on status with aws eks describe-addon",
        "Check add-on logs with kubectl logs -n kube-system",
        "Check events with kubectl get events -n kube-system"
      ]
    }
  ]
