{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How the Spark Operator Works",
    "locale": "en",
    "output": "en-data-on-eks-spark-02-spark-operator-0.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "submit",
        "label": "Submit and watch",
        "focus": [
          "apply",
          "watch",
          "webhook",
          "driver"
        ],
        "note": "kubectl apply creates the SparkApplication CR; the Controller watches it and creates the driver Pod through the webhook."
      },
      {
        "id": "run",
        "label": "Driver-led execution",
        "focus": [
          "driver",
          "executor",
          "run"
        ],
        "note": "The Operator only touches the driver Pod directly; the driver requests executor Pods from the Kubernetes API itself."
      },
      {
        "id": "loop",
        "label": "Status reporting loop",
        "focus": [
          "run",
          "status",
          "watch"
        ],
        "note": "Progress is written back to the CR .status and control returns to the Controller's watch loop."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "User submission"
        },
        "backend": {
          "label": "Spark Operator"
        },
        "security": {
          "label": "Mutating Webhook"
        },
        "database": {
          "label": "CR .status write"
        },
        "cloud": {
          "label": "Spark Pods"
        }
      }
    }
  },
