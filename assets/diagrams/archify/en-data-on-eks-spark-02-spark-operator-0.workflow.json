        "id": "submit",
        "label": "Submit and admit",
        "focus": [
          "apply",
          "watch",
          "webhook",
          "driver"
        ],
        "note": "The controller invokes spark-submit; Kubernetes admission processes the pod request."
      },
      {
        "id": "run",
        "label": "Run Spark tasks",
        "focus": [
          "driver",
          "executor",
          "run"
        ],
        "note": "The driver requests executors and assigns Spark tasks; Kubernetes places the pods."
      },
      {
        "id": "loop",
        "label": "Reconcile and retry",
        "focus": [
          "driver",
          "executor",
          "status",
          "watch"
        ],
        "note": "The operator observes driver and executor state, updates the CR, and manages retries and cleanup."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "User submission"
        },
        "backend": {
          "label": "Spark Operator"
        },
        "security": {
          "label": "Mutating Webhook"
        },
        "database": {
          "label": "CR .status write"
        },
        "cloud": {
          "label": "Spark Pods"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "user",
      "label": "User"
    },
    {
      "id": "operator",
      "label": "Kubeflow Controller"
    },
    {
      "id": "admission",
      "label": "Kubernetes Admission"
    },
    {
      "id": "spark",
      "label": "Spark Pods on Kubernetes"
    }
  ],
  "mainPath": [
