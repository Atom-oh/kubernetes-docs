    {
      "dot": "cyan",
      "title": "Inbound · outbound",
      "items": [
        "Inbound flows IGW → load balancer in the public subnet → worker nodes in the private subnet",
        "Outbound flows worker nodes → NAT Gateway → IGW → internet",
        "Worker nodes and the EKS control plane use a direct path governed by security groups"
      ]
    },
    {
      "dot": "emerald",
      "title": "High-availability design",
      "items": [
        "Use at least two Availability Zones with a public and a private subnet in each",
        "Put a NAT Gateway in every AZ to remove the single point of failure",
        "Spread load balancers across multiple AZs"
      ]
    },
    {
      "dot": "amber",
      "title": "Security · cost",
      "items": [
        "Keep worker nodes in private subnets and apply least privilege to security groups",
        "Reach AWS services through VPC endpoints to cut NAT data-processing charges",
        "Minimize unnecessary cross-AZ traffic"
      ]
    }
