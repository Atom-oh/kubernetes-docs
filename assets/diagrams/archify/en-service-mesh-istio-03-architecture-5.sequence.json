          "init",
          "iptables"
        ],
        "note": "The Init Container sets up the iptables NAT rules first, then exits."
      },
      {
        "id": "start-phase",
        "label": "Container startup",
        "focus": [
          "k8s",
          "app",
          "envoy"
        ],
        "note": "Only after the rules are in place do the application and Envoy containers start."
      },
      {
        "id": "intercept-phase",
        "label": "Outbound interception",
        "focus": [
          "app",
          "iptables",
          "envoy"
        ],
        "note": "App requests are redirected to 15001; only Envoy's own requests (UID 1337) bypass iptables."
      }
    ]
