  "cards": [
    {
      "dot": "cyan",
      "title": "One shared NLB, two target groups",
      "items": [
        "A single NLB splits traffic across the Blue and Green target groups by weight",
        "DNS never changes, so there is no TTL propagation to wait out",
        "Weights take effect immediately at the listener rule level"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shift procedure",
      "items": [
        "Bring up the Green cluster and get its target group passing health checks",
        "Raise the Green weight in stages: 20% → 50% → 100%",
        "If the metrics stay clean, drop Blue to 0 and tear it down later"
      ]
    },
    {
      "dot": "amber",
      "title": "Watch out for",
      "items": [
        "Each cluster has its own EBS volumes, so stateful workloads need a separate migration plan",
        "If Blue and Green share a database, verify schema compatibility first",
        "Rollback is just reverting the weights, so do not delete Blue too early"
      ]
    }
  ]
