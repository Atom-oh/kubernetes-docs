          "label": "Shared hub"
        }
      }
    },
    "views": [
      {
        "id": "install",
        "label": "Install and configure",
        "focus": [
          "install",
          "config"
        ],
        "note": "Deploy Calico (Tigera Operator, manifests or Helm), then tune the Installation resource: IP pools, encapsulation, MTU, dataplane."
      },
      {
        "id": "observe",
        "label": "Monitor and troubleshoot",
        "focus": [
          "config",
          "monitor",
          "troubleshoot"
        ],
        "note": "Felix, BIRD and Typha metrics plus log analysis drive troubleshooting of pod IP, connectivity, policy and BGP issues."
      },
      {
        "id": "feedback",
        "label": "Feedback to the hub",
        "focus": [
          "troubleshoot",
          "upgrade",
          "config"
        ],
        "note": "Fixes and post-upgrade retuning both land back in the shared configuration hub."
      },
      {
        "id": "protect",
        "label": "Backup and DR",
        "focus": [
          "config",
          "backup"
        ],
        "note": "Export Calico resources and the Installation CR with calicoctl/kubectl so the configuration can be restored in dependency order."
      }
    ]
  },
