  "cards": [
    {
      "dot": "cyan",
      "title": "Installation",
      "items": [
        "Tigera Operator is the recommended production method",
        "Manifest and Helm installs are also supported",
        "Installation resource sets IP pools, encapsulation, MTU and dataplane"
      ]
    },
    {
      "dot": "amber",
      "title": "Monitoring & troubleshooting",
      "items": [
        "Felix, BIRD and Typha expose Prometheus metrics",
        "Alert rules and Grafana dashboards watch dataplane health",
        "Common issues: pod IPs, communication failures, policy, BGP peering"
      ]
    },
    {
      "dot": "emerald",
      "title": "Upgrades & backup",
      "items": [
        "Pre-upgrade checklist, then Operator or Helm upgrade with rollback",
        "Back up Calico resources (IP pools, BGP config, policies, Felix config) and the Installation CR",
        "Restore procedure returns the cluster to the saved configuration"
      ]
    }
  ]
