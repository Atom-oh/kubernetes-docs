  "cards": [
    {
      "dot": "cyan",
      "title": "Service connection fails",
      "items": [
        "If the Service selector and pod labels disagree, the EndpointSlice is empty and connections fail",
        "kubectl get endpointslices confirms whether the target pods are actually registered",
        "A failing readinessProbe removes the pod from the endpoints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Load balancer creation fails",
      "items": [
        "Missing subnet tags are the most common cause (role/elb, role/internal-elb)",
        "Check the controller's IAM permissions and its service account (IRSA) setup",
        "The events on kubectl describe ingress or service carry the failure reason"
      ]
    },
    {
      "dot": "amber",
      "title": "Health checks fail",
      "items": [
        "Confirm the target group health check path and port match the application",
        "Node and pod security groups must allow health check traffic from the load balancer",
        "In IP target mode you also have to check the pod security groups"
      ]
    }
  ]
