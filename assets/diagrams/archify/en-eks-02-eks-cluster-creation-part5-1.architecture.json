    {
      "dot": "cyan",
      "title": "EKS access entry",
      "items": [
        "Managed through a native AWS API, so CloudTrail auditing and IaC come easily",
        "Access policies grant admin, edit, or view levels directly",
        "Works with authenticationMode set to API or API_AND_CONFIG_MAP"
      ]
    },
    {
      "dot": "rose",
      "title": "Limits of the aws-auth ConfigMap",
      "items": [
        "It is hand-edited, so one YAML mistake can lock everyone out",
        "The ConfigMap size limit makes many principals hard to manage",
        "It is not an AWS API surface, so changes are hard to trace"
      ]
    },
    {
      "dot": "emerald",
      "title": "Migration stance",
      "items": [
        "Start new clusters in API mode with access entries only",
        "Move existing clusters to API_AND_CONFIG_MAP, then migrate to entries gradually",
        "Once migrated, remove the aws-auth entries and pin the cluster to API mode"
      ]
    }
