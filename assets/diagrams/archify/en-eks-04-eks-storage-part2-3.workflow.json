  "cards": [
    {
      "dot": "cyan",
      "title": "Prerequisites",
      "items": [
        "The StorageClass must set allowVolumeExpansion: true for the request to be accepted",
        "You request expansion by raising the PVC's spec.resources.requests.storage",
        "Shrinking is not supported, so plan sizes rather than over-provisioning up front"
      ]
    },
    {
      "dot": "emerald",
      "title": "Online versus offline",
      "items": [
        "With a recent kernel and CSI driver, expansion happens online while the pod runs",
        "Without online support, the pod must restart before the file system grows",
        "The PVC's FileSystemResizePending condition shows which stage it is in"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational best practices",
      "items": [
        "Track usage with metrics such as kubelet_volume_stats_available_bytes",
        "Alert at an 80% threshold so you do not miss the moment to expand",
        "Expand incrementally rather than in one jump, and account for the 6-hour EBS modification cooldown"
      ]
    }
  ]
