        "label": "Alternative path",
        "focus": [
          "q_micro",
          "q_count",
          "not_needed",
          "alternatives"
        ],
        "note": "Without microservices, or with fewer than 10 services, alternatives such as an Ingress Controller, NetworkPolicy, or a CNI are sufficient."
      },
      {
        "id": "careful-path",
        "label": "Careful review",
        "focus": [
          "q_needs",
          "q_ops",
          "careful"
        ],
        "note": "If needs are not complex or ops resources are lacking, start small and consider Ambient Mode."
