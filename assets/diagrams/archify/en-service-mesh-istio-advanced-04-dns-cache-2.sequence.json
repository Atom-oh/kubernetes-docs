    "animation": "trace",
    "views": [
      {
        "id": "prealloc",
        "label": "Virtual IP pre-allocation",
        "focus": [
          "istiod",
          "envoy"
        ],
        "note": "When a ServiceEntry is registered, Istiod pushes the virtual IP configuration to Envoy ahead of time via xDS."
      },
      {
        "id": "dns",
        "label": "DNS query response",
        "focus": [
          "app",
          "envoy"
        ],
        "note": "Envoy DNS Proxy answers immediately with a virtual IP from the 240.240.0.0/16 range, with no external lookup."
      },
      {
        "id": "http",
        "label": "Forward to the real host",
        "focus": [
          "app",
          "envoy",
          "external"
        ],
        "note": "HTTP requests sent to the virtual IP are mapped to the real host, forwarded to its real IP, and the response is returned."
      }
    ]
  },
  "participants": [
