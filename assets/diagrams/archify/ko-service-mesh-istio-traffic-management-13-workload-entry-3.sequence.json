          "pod",
          "dns"
        ],
        "note": "파드가 api.legacy.internal을 조회하면 Istio DNS가 ServiceEntry의 addresses 값인 가상 IP를 돌려준다."
      },
      {
        "id": "match",
        "label": "WorkloadEntry 매칭",
        "focus": [
          "pod",
          "envoy"
        ],
        "note": "Envoy가 ServiceEntry의 workloadSelector 레이블(app: legacy-api)로 등록된 WorkloadEntry를 찾는다."
      },
      {
        "id": "connect",
        "label": "VM으로 mTLS 연결",
        "focus": [
          "envoy",
          "vm",
          "pod"
        ],
        "note": "찾아낸 WorkloadEntry 주소 192.168.1.100:8080으로 mTLS 연결을 맺고 응답을 파드에 돌려준다."
      }
    ],
    "legend": {
