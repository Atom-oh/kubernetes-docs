{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "VPC CNI + Calico Traffic Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1040,
      580
    ],
    "views": [
      {
        "id": "egress",
        "label": "Egress packet and policy evaluation",
        "focus": [
          "pod",
          "felix",
          "ipt"
        ],
        "note": "The Source Pod's packet hits the iptables rules programmed by Calico Felix, where NetworkPolicy is evaluated."
      },
      {
        "id": "allow",
        "label": "Policy allowed path",
        "focus": [
          "ipt",
          "eni",
          "vpc",
          "dest"
        ],
        "note": "If allowed, the packet leaves through the VPC ENI, the AWS VPC routes it, and it reaches the destination."
      },
      {
        "id": "deny",
        "label": "Policy denied path",
        "focus": [
          "ipt",
          "pod"
        ],
        "note": "If denied, iptables drops the packet so it never leaves the Source Pod."
      }
    ],
    "column_fit": "spread"
  },
