    {
      "dot": "cyan",
      "title": "Common causes of Node NotReady",
      "items": [
        "kubelet Issues: kubelet service is not running or has errors",
        "Node Network Issues: node network configuration issues",
        "Node Resource Exhaustion: CPU, memory or disk exhausted",
        "Node Health Check Failure: node health checks failing",
        "Node Disk Pressure: node disk space exhaustion"
      ]
    },
    {
      "dot": "emerald",
      "title": "Common causes of Pod Not Running",
      "items": [
        "Image Pull Failure: container image pull failure",
        "Resource Request Issues: insufficient resources for requests",
        "Pod Configuration Error: pod specification errors",
        "Scheduling Failure: pod could not be scheduled",
        "Volume Mount Failure: volume mount failure"
      ]
    },
    {
      "dot": "amber",
      "title": "Common causes of resource constraints",
      "items": [
        "Insufficient CPU: insufficient CPU resources",
        "Insufficient Memory: insufficient memory resources",
        "Insufficient Disk: insufficient disk space",
        "Resource Quotas: resource quota limits reached",
        "Limit Ranges: container limit ranges exceeded"
      ]
    }
  ]
