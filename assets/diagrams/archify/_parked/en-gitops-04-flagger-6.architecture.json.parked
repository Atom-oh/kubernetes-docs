  "connections": [
    {
      "id": "hr-to-source",
      "from": "helmrelease",
      "to": "source-controller",
      "label": "Git sync",
      "variant": "emphasis"
    },
    {
      "id": "source-to-helm",
      "from": "source-controller",
      "to": "helm-controller",
      "label": "chart artifact",
      "variant": "emphasis",
      "labelDy": 24
    },
    {
      "id": "helm-to-deployment",
      "from": "helm-controller",
      "to": "deployment",
      "label": "apply release",
      "variant": "emphasis"
    },
    {
      "id": "crd-to-flagger",
      "from": "canary-crd",
      "to": "flagger",
      "label": "watches",
      "labelDy": 24
    },
    {
      "id": "flagger-to-deployment",
      "from": "flagger",
      "to": "deployment",
      "label": "clones primary · controls",
      "labelDy": 24
    },
    {
      "id": "flagger-to-primary",
      "from": "flagger",
      "to": "primary-service"
    },
    {
      "id": "flagger-to-canary",
      "from": "flagger",
      "to": "canary-service"
    },
    {
      "id": "flagger-to-mesh",
      "from": "flagger",
      "to": "service-mesh",
      "label": "weighted routing"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Managed by Flux",
      "items": [
        "Flagger itself is installed as a HelmRelease in the flagger-system namespace",
        "The application HelmRelease creates and updates the Deployment"
      ]
    },
    {
      "dot": "emerald",
      "title": "Managed by Flagger",
      "items": [
        "The Canary CRD names the target Deployment and its analysis conditions",
        "Adjusts primary/canary Services and mesh routing (meshProvider: istio)"
      ]
    }
  ]
}