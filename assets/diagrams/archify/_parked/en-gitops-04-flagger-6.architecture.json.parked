{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "FluxCD HelmRelease + Flagger Canary Workflow",
    "locale": "en",
    "output": "en-gitops-04-flagger-6.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "legend": {
      "entries": {
        "external": {
          "label": "Declared state in Git"
        },
        "backend": {
          "label": "Controllers / workloads"
        },
        "frontend": {
          "label": "Traffic routing"
        }
      }
    },
    "views": [
      {
        "id": "gitops-path",
        "label": "GitOps delivery path",
        "focus": [
          "helmrelease",
          "source-controller",
          "helm-controller",
          "deployment"
        ],
        "note": "FluxCD fetches the HelmRelease from Git and applies it as a Deployment."
      },
      {
        "id": "progressive-delivery",
        "label": "Flagger progressive delivery",
        "focus": [
          "canary-crd",
          "flagger",
          "deployment",
          "primary-service",
          "canary-service",
          "service-mesh"
        ],
        "note": "Flagger watches the Canary CRD and controls the primary/canary Services and mesh routing."
      }
    ]
  },
  "components": [
