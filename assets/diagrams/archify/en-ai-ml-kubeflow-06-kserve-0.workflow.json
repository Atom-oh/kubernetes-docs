      "title": "InferenceService components",
      "items": [
        "Predictor (required): loads the model artifact and answers inference requests",
        "Transformer (optional): pre/post-processing in front of the predictor",
        "Explainer (optional): produces model explanations such as feature importance"
      ]
    },
    {
      "dot": "emerald",
      "title": "Serverless mode (Knative)",
      "items": [
        "Knative Serving manages the pod lifecycle",
        "Scales to zero pods when there is no traffic",
        "Cold-start latency when scaling up from zero"
      ]
    },
    {
      "dot": "amber",
      "title": "Raw Deployment mode",
      "items": [
        "Manages a plain Deployment · Service · HPA directly",
        "No Knative dependency, no cold start",
        "Minimum replicas always run, so no scale-to-zero"
      ]
