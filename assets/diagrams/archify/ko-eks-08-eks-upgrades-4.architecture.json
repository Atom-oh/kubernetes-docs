  "cards": [
    {
      "dot": "orange",
      "title": "AWS 관리형 애드온 절차",
      "items": [
        "aws eks list-addons로 설치된 관리형 애드온 확인",
        "describe-addon / describe-addon-versions로 현재·사용 가능 버전 확인",
        "aws eks update-addon --resolve-conflicts PRESERVE 또는 eksctl update addon --preserve로 업그레이드"
      ]
    },
    {
      "dot": "rose",
      "title": "일반적인 문제",
      "items": [
        "구성 충돌: 사용자 정의 구성과 새 버전 간의 충돌",
        "호환성 문제: 애드온과 Kubernetes 버전 간의 호환성",
        "리소스 제약: 업그레이드에 필요한 리소스 부족"
      ]
    },
    {
      "dot": "slate",
      "title": "문제 해결 단계",
      "items": [
        "aws eks describe-addon으로 애드온 상태 확인",
        "kubectl logs -n kube-system으로 애드온 로그 확인",
        "kubectl get events -n kube-system으로 이벤트 확인"
      ]
    }
  ]
