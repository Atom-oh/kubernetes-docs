          "packet",
          "sec",
          "plat",
          "app",
          "def"
        ],
        "note": "order가 낮은 Tier부터 평가하며 Pass가 나오면 다음 Tier로 넘어갑니다."
      },
      {
        "id": "immediate-exit",
        "label": "매치 시 즉시 종료",
        "focus": [
          "sec_exit",
          "plat_exit",
          "app_exit",
          "def_exit"
        ],
        "note": "어느 Tier에서든 Allow 또는 Deny 규칙에 매치되면 평가가 바로 끝납니다."
      },
      {
        "id": "fallthrough",
        "label": "최종 기본 동작",
        "focus": [
          "def",
          "def_exit",
          "profile"
        ],
        "note": "Default Tier의 K8s NetworkPolicy에는 Pass가 없고, 매치되는 정책이 없으면 Profile 기본 동작이 적용됩니다."
      }
    ],
