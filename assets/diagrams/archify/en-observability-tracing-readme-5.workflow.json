{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Tail-based Sampling Flow",
    "locale": "en",
    "output": "en-observability-tracing-readme-5.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "collect-all",
        "label": "Buffer received spans",
        "focus": [
          "receive",
          "collect",
          "analyze"
        ],
        "note": "The collector waits a bounded decision interval over received spans, not a guaranteed request-completion signal."
      },
      {
        "id": "keep-or-drop",
        "label": "Keep or drop",
        "focus": [
          "analyze",
          "keep",
          "drop"
        ],
        "note": "Policies use available data: error or slow traces may be retained, with probabilistic sampling of other traces."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Request input"
        },
        "messagebus": {
          "label": "Span buffer"
        },
        "security": {
          "label": "Sampling decision"
        },
        "database": {
          "label": "Trace storage"
        },
        "backend": {
          "label": "Drop handling"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "trace",
      "label": "Request handling · Trace collection"
    },
    {
      "id": "discard",
      "label": "Not selected",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "receive",
    "collect",
    "analyze",
    "keep"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "receive"
    ],
    "allowedTerminals": [
      "keep",
      "drop"
    ],
    "requiredPaths": [
      {
        "from": "receive",
        "to": "keep"
      },
      {
        "from": "receive",
        "to": "drop"
      }
    ]
  },
  "nodes": [
    {
      "id": "receive",
      "lane": "trace",
      "col": 0,
      "type": "frontend",
      "label": "Spans received",
      "sublabel": "after upstream sampling",
      "width": 168
    },
    {
      "id": "collect",
      "lane": "trace",
      "col": 1,
      "type": "messagebus",
      "label": "Bounded buffer",
      "sublabel": "trace-ID affinity needed",
      "tag": "decision_wait",
      "width": 168
    },
    {
      "id": "analyze",
      "lane": "trace",
      "col": 2,
      "type": "security",
      "label": "Analyze",
      "sublabel": "error? latency?",
      "tag": "decision_wait",
      "width": 168
    },
    {
      "id": "keep",
      "lane": "trace",
      "col": 3,
      "type": "database",
      "label": "Keep",
      "sublabel": "export selected data",
      "width": 168
    },
    {
      "id": "drop",
      "lane": "discard",
      "col": 3,
      "type": "backend",
      "label": "Drop",
      "sublabel": "spans discarded",
      "width": 168
    }
  ],
  "edges": [
    {
      "from": "receive",
      "to": "collect",
      "role": "main"
    },
    {
      "from": "collect",
      "to": "analyze",
      "label": "decision interval",
      "role": "main"
    },
    {
      "from": "analyze",
      "to": "keep",
      "label": "policy selected",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "analyze",
      "to": "drop",
      "label": "not selected",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Example policy",
      "items": [
        "Evaluate received ERROR spans or latency above 1,000 ms",
        "Other traces may be sampled at 10%; not every normal trace is dropped"
      ]
    },
    {
      "dot": "rose",
      "title": "Limits",
      "items": [
        "Upstream sampling, late spans, overflow or failure can lose important data",
        "Scaling needs trace affinity, capacity and failure-state planning"
      ]
    }
  ]
}
