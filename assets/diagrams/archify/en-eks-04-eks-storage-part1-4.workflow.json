  "cards": [
    {
      "dot": "cyan",
      "title": "Request stage",
      "items": [
        "The pod manifest references the PVC and mounts it into the container with volumeMounts",
        "The PVC declares the size, access mode, and storageClassName it needs",
        "The StorageClass provisioner decides which CSI driver handles it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Volume binding modes",
      "items": [
        "Immediate provisions and binds a PV as soon as the PVC is created",
        "WaitForFirstConsumer delays provisioning until a pod is scheduled",
        "For AZ-bound volumes like EBS, WaitForFirstConsumer is effectively mandatory"
      ]
    },
    {
      "dot": "amber",
      "title": "Reclaim policies",
      "items": [
        "Delete removes the PV and the underlying AWS volume along with the PVC",
        "Retain keeps the PV so the data can be recovered by hand",
        "For production data, Retain plus a separate deletion procedure is the safer choice"
      ]
    }
  ]
