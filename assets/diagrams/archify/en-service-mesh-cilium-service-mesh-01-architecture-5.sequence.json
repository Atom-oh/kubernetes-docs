{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "L7 Processing Flow through the Node Envoy",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      660
    ],
    "animation": "trace",
    "views": [
      {
        "id": "request-leg",
        "label": "Request leg",
        "focus": [
          "client",
          "ebpf",
          "envoy"
        ],
        "note": "eBPF checks the L4 policy and redirects only requests that need L7 policy to the node Envoy."
      },
      {
        "id": "server-hop",
        "label": "Server hop",
        "focus": [
          "ebpf",
          "server"
        ],
        "note": "The processed packet is delivered to the destination Server Pod, which returns the HTTP response."
      },
      {
        "id": "response-leg",
        "label": "Response leg",
        "focus": [
          "server",
          "ebpf",
          "envoy",
          "client"
        ],
        "note": "The response also passes through Envoy only when L7 policy is required, then reaches the Client Pod."
      }
    ]
  },
  "participants": [
