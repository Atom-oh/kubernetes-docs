    {
      "dot": "cyan",
      "title": "Metrics",
      "items": [
        "Measures request count, response time, error rate, and resource utilization",
        "Used for system health monitoring, SLO/SLI tracking, and capacity planning",
        "Tools: Prometheus, Grafana, VictoriaMetrics"
      ]
    },
    {
      "dot": "violet",
      "title": "Distributed Tracing",
      "items": [
        "Tracks the complete path of a single request and each service's processing time",
        "Used for bottleneck identification, root cause analysis, and microservices debugging",
        "Tools: Jaeger, Zipkin, Grafana Tempo"
      ]
    },
    {
      "dot": "amber",
      "title": "Logging",
      "items": [
        "Records all HTTP requests/responses, errors, and security events",
        "Used for detailed debugging, security audits, and compliance",
        "Tools: Grafana Loki, Elasticsearch, Fluentd"
      ]
    }
