{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Harbor Proxy Cache 동작 흐름",
    "output": "public/archmaps/ko-container-registry-03-harbor-2.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "cache-hit",
        "label": "Cache Hit",
        "focus": [
          "pull",
          "lookup",
          "respond"
        ],
        "note": "요청한 이미지가 Harbor에 이미 캐시되어 있으면 업스트림에 접근하지 않고 즉시 반환한다."
      },
      {
        "id": "cache-miss",
        "label": "Cache Miss",
        "focus": [
          "pull",
          "lookup",
          "fetch",
          "store",
          "respond"
        ],
        "note": "캐시에 없으면 업스트림 레지스트리에서 가져와 Harbor에 저장한 뒤 클라이언트에 반환한다."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "클라이언트"
        },
        "backend": {
          "label": "Harbor"
        },
        "database": {
          "label": "캐시 스토리지"
        },
        "external": {
          "label": "외부 레지스트리"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "clientLane",
      "label": "클라이언트 (Docker / containerd)"
    },
    {
      "id": "harborLane",
      "label": "Harbor 프록시 캐시 프로젝트"
    },
    {
      "id": "upstreamLane",
      "label": "외부 레지스트리"
    }
  ],
  "mainPath": [
    "pull",
    "lookup",
    "fetch",
    "store",
    "respond"
  ],
  "nodes": [
    {
      "id": "pull",
      "lane": "clientLane",
      "col": 0,
      "type": "frontend",
      "label": "이미지 Pull 요청",
      "sublabel": "Docker / containerd",
      "width": 160
    },
    {
      "id": "lookup",
      "lane": "harborLane",
      "col": 1,
      "type": "backend",
      "label": "Harbor Proxy Cache",
      "sublabel": "캐시 조회",
      "tag": "hit / miss",
      "width": 160
    },
    {
      "id": "fetch",
      "lane": "upstreamLane",
      "col": 2,
      "type": "external",
      "label": "Upstream Registry",
      "sublabel": "Docker Hub 등",
      "width": 160
    },
    {
      "id": "store",
      "lane": "harborLane",
      "col": 3,
      "type": "database",
      "label": "Harbor에 캐시 저장",
      "sublabel": "프록시 캐시 프로젝트에 저장",
      "width": 160
    },
    {
      "id": "respond",
      "lane": "clientLane",
      "col": 4,
      "type": "frontend",
      "label": "캐시된 이미지 반환",
      "sublabel": "클라이언트로 응답",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "pull-to-lookup",
      "from": "pull",
      "to": "lookup",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "hit",
      "from": "lookup",
      "to": "respond",
      "label": "Cache Hit",
      "role": "branch",
      "variant": "dashed",
      "fromSide": "right"
    },
    {
      "id": "miss",
      "from": "lookup",
      "to": "fetch",
      "label": "Cache Miss",
      "variant": "emphasis"
    },
    {
      "id": "fetch-to-store",
      "from": "fetch",
      "to": "store"
    },
    {
      "id": "store-to-respond",
      "from": "store",
      "to": "respond"
    }
  ]
}
