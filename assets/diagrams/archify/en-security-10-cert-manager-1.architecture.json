  "cards": [
    {
      "dot": "rose",
      "title": "Issuer vs ClusterIssuer",
      "items": [
        "Issuer: a per-team/app issuer usable only within a single namespace",
        "ClusterIssuer: a shared, cluster-wide issuer (for example Let's Encrypt)",
        "A Certificate selects one of them with issuerRef.kind"
      ]
    },
    {
      "dot": "emerald",
      "title": "Resulting Secret",
      "items": [
        "The certificate is stored in the Secret named by spec.secretName",
        "It holds tls.crt and tls.key, referenced by Ingress and others",
        "Renewed automatically at renewBefore, replacing the Secret contents"
      ]
    }
