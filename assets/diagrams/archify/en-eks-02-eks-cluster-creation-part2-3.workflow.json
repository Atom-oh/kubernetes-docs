    {
      "dot": "cyan",
      "title": "Create and configure",
      "items": [
        "Create with eksctl create cluster --name=my-cluster, or -f cluster.yaml",
        "Add node groups with eksctl create nodegroup --cluster=my-cluster",
        "Add Fargate profiles with eksctl create fargateprofile --cluster=my-cluster"
      ]
    },
    {
      "dot": "emerald",
      "title": "Updates",
      "items": [
        "Raise the control plane with eksctl upgrade cluster --name=my-cluster --version=1.31",
        "Raise nodes with eksctl upgrade nodegroup --cluster=my-cluster --name=my-nodegroup",
        "Refresh add-ons with eksctl update addon --cluster=my-cluster --name=vpc-cni",
        "Upgrade the control plane first and keep nodes within one minor version of it"
      ]
    },
    {
      "dot": "amber",
      "title": "Before deleting",
      "items": [
        "eksctl delete cluster --name=my-cluster removes things stack by stack",
        "Clean up external resources such as PVCs and load balancers first",
        "Snapshot important data and confirm it can actually be restored"
      ]
    }
