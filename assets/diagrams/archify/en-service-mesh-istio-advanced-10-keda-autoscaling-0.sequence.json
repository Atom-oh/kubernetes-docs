{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Metrics-based Scaling Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1000,
      680
    ],
    "animation": "trace",
    "legend": {
      "entries": {
        "emphasis": {
          "label": "scale decision"
        },
        "dashed": {
          "label": "async Pod creation"
        }
      }
    },
    "views": [
      {
        "id": "collect",
        "label": "Metric collection",
        "focus": [
          "app",
          "envoy",
          "prom"
        ],
        "note": "Prometheus collects and stores the Istio metrics generated by the Envoy sidecar."
      },
      {
        "id": "poll",
        "label": "KEDA polling",
        "focus": [
          "keda",
          "prom"
        ],
        "note": "Every pollingInterval, KEDA runs the PromQL query and fetches the current RPS."
      },
      {
        "id": "scale",
        "label": "Scale out",
        "focus": [
          "keda",
          "hpa",
          "k8s",
          "app"
        ],
        "note": "When the threshold is exceeded, the HPA target is updated and new Pods are created."
      }
    ]
  },
  "participants": [
    {
      "id": "app",
      "type": "frontend",
      "label": "Application Pod",
      "sublabel": "workload"
    },
    {
      "id": "envoy",
      "type": "backend",
      "label": "Envoy Sidecar",
      "sublabel": "istio-proxy"
    },
    {
      "id": "prom",
      "type": "database",
      "label": "Prometheus",
      "sublabel": ":9090"
    },
    {
      "id": "keda",
      "type": "cloud",
      "label": "KEDA Operator",
      "sublabel": "ScaledObject"
    },
    {
      "id": "hpa",
      "type": "backend",
      "label": "HPA",
      "sublabel": "autoscaling/v2"
    },
    {
      "id": "k8s",
      "type": "security",
      "label": "Kubernetes API",
      "sublabel": "ReplicaSet"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 262,
      "label": "Generate, collect and store metrics"
    },
    {
      "from": 285,
      "to": 385,
      "label": "Runs every pollingInterval"
    },
    {
      "from": 405,
      "to": 560,
      "label": "Over 1,000 RPS threshold → scale out · re-evaluate after cooldownPeriod"
    }
  ],
  "messages": [
    {
      "id": "http",
      "from": "app",
      "to": "envoy",
      "y": 190,
      "label": "HTTP request processing"
    },
    {
      "id": "expose",
      "from": "envoy",
      "to": "prom",
      "y": 240,
      "label": "Expose metrics :15090/stats/prometheus",
      "note": "istio_requests_total · istio_request_duration_milliseconds"
    },
    {
      "id": "query",
      "from": "keda",
      "to": "prom",
      "y": 315,
      "label": "PromQL rate(istio_requests_total[1m])"
    },
    {
      "id": "rps",
      "from": "prom",
      "to": "keda",
      "y": 362,
      "label": "Return current RPS (e.g. 1,500)",
      "variant": "return"
    },
    {
      "id": "desired",
      "from": "keda",
      "to": "hpa",
      "y": 440,
      "label": "Update target replicas 10 → 15",
      "variant": "emphasis",
      "note": "threshold 1,000 < current 1,500 → scale out needed"
    },
    {
      "id": "rs",
      "from": "hpa",
      "to": "k8s",
      "y": 490,
      "label": "Update ReplicaSet"
    },
    {
      "id": "pods",
      "from": "k8s",
      "to": "app",
      "y": 538,
      "label": "Create 5 new Pods",
      "variant": "dashed",
      "note": "Wait cooldownPeriod, then evaluate next scaling"
    }
  ],
  "activations": [
    {
      "participant": "envoy",
      "from": 185,
      "to": 246,
      "type": "backend"
    },
    {
      "participant": "prom",
      "from": 235,
      "to": 368,
      "type": "database"
    },
    {
      "participant": "keda",
      "from": 310,
      "to": 446,
      "type": "cloud"
    },
    {
      "participant": "hpa",
      "from": 435,
      "to": 496,
      "type": "backend"
    },
    {
      "participant": "k8s",
      "from": 485,
      "to": 544,
      "type": "security"
    }
  ]
}
