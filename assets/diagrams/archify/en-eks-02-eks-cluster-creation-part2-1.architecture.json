  "cards": [
    {
      "dot": "cyan",
      "title": "What a managed node group handles",
      "items": [
        "It picks the EKS-optimized AMI and injects the bootstrap script for you",
        "On update it performs a rolling replacement, including cordon and drain",
        "It applies the eks.amazonaws.com tags and labels to nodes automatically"
      ]
    },
    {
      "dot": "emerald",
      "title": "Capacity and scaling",
      "items": [
        "min, max, and desired define the Auto Scaling group's range",
        "Capacity type, on-demand or spot, is chosen per node group",
        "Cluster Autoscaler adjusts this ASG; Karpenter creates nodes directly without node groups"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational cautions",
      "items": [
        "Editing the launch template by hand can drift from the version the node group tracks",
        "Set PodDisruptionBudgets before a node group upgrade to protect availability",
        "Put taints and labels in the node group definition to steer workload placement"
      ]
    }
  ]
