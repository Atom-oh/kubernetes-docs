      {
        "id": "admission",
        "label": "Admission validation",
        "focus": [
          "user",
          "api",
          "psa",
          "ns"
        ],
        "note": "The API Server hands the Pod request to the PSA Controller, which reads the enforcement level from the namespace labels."
      },
      {
        "id": "allow",
        "label": "Policy compliant",
        "focus": [
          "psa",
          "api",
          "etcd",
          "user"
        ],
        "note": "A Pod that satisfies the restricted level is approved, stored in etcd, and answered with 201 Created."
      },
      {
        "id": "deny",
        "label": "Policy violation",
        "focus": [
          "psa",
          "api",
          "user"
        ],
        "note": "In enforce mode a violating Pod is denied and the request returns 403 Forbidden."
      }
    ]
  },
