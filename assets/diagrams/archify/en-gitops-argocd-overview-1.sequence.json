  "cards": [
    {
      "dot": "cyan",
      "title": "Application creation",
      "items": [
        "API Server handles the request, authentication, and RBAC",
        "Repo Server clones the source repo and generates manifests",
        "Rendered manifests are cached for later comparisons"
      ]
    },
    {
      "dot": "orange",
      "title": "Reconciliation loop",
      "items": [
        "Application Controller fetches desired state from the Repo Server",
        "It reads the actual state from the target Kubernetes cluster",
        "On drift it applies the desired manifests and updates the Application status"
      ]
    }
  ]
