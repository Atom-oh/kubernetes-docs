    "views": [
      {
        "id": "iptables-path",
        "label": "iptables packet path",
        "focus": [
          "nic-ipt",
          "prerouting",
          "forward",
          "kubeproxy",
          "postrouting",
          "pod-ipt"
        ],
        "note": "One packet walks the PREROUTING → FORWARD → POSTROUTING chains in turn. O(N) rule evaluation grows with the rule count, so latency climbs."
      },
      {
        "id": "ebpf-path",
        "label": "eBPF packet path",
        "focus": [
          "nic-ebpf",
          "tc-hook",
          "bpf-maps",
          "connect-lb",
          "pod-ebpf"
        ],
        "note": "A single BPF program at the TC hook looks up BPF maps in O(1) and handles policy and routing in one pass. Latency stays low."
      },
      {
        "id": "kube-proxy-replacement",
        "label": "kube-proxy replacement",
        "focus": [
          "kubeproxy",
          "bpf-maps",
          "connect-lb"
        ],
        "note": "iptables mode relies on kube-proxy rules for Service LB; eBPF mode uses socket-level connect-time LB instead, so kube-proxy is not needed."
      }
    ],
