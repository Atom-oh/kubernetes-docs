  "cards": [
    {
      "dot": "amber",
      "title": "iptables mode",
      "items": [
        "Every packet traverses multiple chains, so latency is high",
        "Rules are matched sequentially, so performance degrades as the rule count grows (O(N))",
        "kube-proxy NAT rules grow in proportion to the number of Services and endpoints"
      ]
    },
    {
      "dot": "emerald",
      "title": "eBPF mode",
      "items": [
        "Hash-based BPF map lookup gives O(1) matching regardless of scale",
        "One BPF program at the TC hook handles policy, NAT, and routing in a single pass, keeping latency low",
        "Socket-level LB picks the backend at connect() time, before any packet exists, so Services work without kube-proxy and DSR is supported"
      ]
    },
    {
      "dot": "slate",
      "title": "Performance comparison",
      "items": [
        "Latency: iptables higher / eBPF lower",
        "CPU usage: iptables higher / eBPF lower",
        "Rule scalability: iptables limited / eBPF excellent"
      ]
    }
  ]
