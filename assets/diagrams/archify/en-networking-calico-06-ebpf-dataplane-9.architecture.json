          "prerouting",
          "forward",
          "kubeproxy",
          "postrouting",
          "pod-ipt"
        ],
        "note": "One packet walks the PREROUTING → FORWARD → POSTROUTING chains in turn. O(N) rule evaluation grows with the rule count, so latency climbs."
      },
      {
        "id": "ebpf-path",
        "label": "eBPF packet path",
        "focus": [
          "src-pod",
          "connect-lb",
          "nic-tc",
          "bpf-maps",
          "pod-ebpf"
        ],
        "note": "Socket-level connect-time LB picks the backend first; then one BPF program at the TC hook does O(1) map lookups for policy and routing."
      },
      {
        "id": "kube-proxy-replacement",
        "label": "kube-proxy replacement",
        "focus": [
          "kubeproxy",
          "connect-lb",
          "bpf-maps"
        ],
        "note": "iptables mode needs kube-proxy rules for Service LB; eBPF mode picks the backend in the cgroup connect() hook before any packet exists."
      }
    ],
