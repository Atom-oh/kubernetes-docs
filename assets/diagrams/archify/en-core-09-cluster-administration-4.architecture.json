  "cards": [
    {
      "dot": "cyan",
      "title": "Authentication Methods",
      "items": [
        "X.509 Certificates: authentication using client certificates",
        "Service Account Tokens: JWT tokens associated with service accounts",
        "OpenID Connect (OIDC): authentication through external identity providers",
        "Webhook Token Authentication: token verification through external services",
        "Authentication Proxy: request processing through an authentication proxy"
      ]
    },
    {
      "dot": "violet",
      "title": "Authorization Modes",
      "items": [
        "RBAC: role-based access control (most common)",
        "ABAC: attribute-based access control",
        "Node: node authorization",
        "Webhook: authorization through external services"
      ]
    }
