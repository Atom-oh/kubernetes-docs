    {
      "dot": "amber",
      "title": "IPIP — MTU 1480",
      "items": [
        "Packet: outer IP header (10.0.1.10 → 10.0.1.11) + inner IP header (192.168.1.10 → 192.168.2.10) + original payload",
        "Overhead 20 bytes (one IP header)",
        "Use case: cross-subnet routing when BGP is not available"
      ]
    },
    {
      "dot": "orange",
      "title": "VXLAN — MTU 1450",
      "items": [
        "Packet: outer IP + UDP 4789 + VXLAN header (VNI) + inner IP header + original payload",
        "Overhead 50 bytes (IP + UDP + VXLAN)",
        "Use case: cloud environments, works through most firewalls"
      ]
    },
    {
      "dot": "emerald",
      "title": "Direct / BGP — MTU 1500",
      "items": [
        "Packet: IP header (192.168.1.10 → 192.168.2.10) + original payload, no encapsulation",
        "Overhead 0 bytes",
        "Use case: best performance, requires a BGP-capable network"
      ]
    }
  ]
