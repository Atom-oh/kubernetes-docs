      "label": "DNAT → Pod A"
    },
    {
      "id": "data1",
      "from": "app",
      "to": "kp",
      "y": 262,
      "label": "DATA · FIN → VIP:80"
    },
    {
      "id": "dnat2",
      "from": "kp",
      "to": "poda",
      "y": 296,
      "label": "per-packet DNAT + conntrack"
    },
    {
      "id": "conn",
      "from": "app",
      "to": "sock",
      "y": 385,
