  "cards": [
    {
      "dot": "cyan",
      "title": "One principle",
      "items": [
        "Writes must reach the leader or primary, so cross-AZ hops can happen",
        "Send reads only to a replica in the same AZ and the inter-AZ charge disappears",
        "The gain is largest for read-heavy workloads: caches, lookup queries, consumers"
      ]
    },
    {
      "dot": "emerald",
      "title": "How a pod learns its own AZ",
      "items": [
        "The pod or a sidecar queries placement/availability-zone from EC2 IMDS",
        "A mutating policy such as Kyverno copies the node's topology.k8s.aws/zone-id into a pod annotation",
        "Use an operator that treats rack awareness as a first-class feature, as Strimzi does"
      ]
    },
    {
      "dot": "amber",
      "title": "Per-service settings",
      "items": [
        "Kafka reads from a same-rack broker through KIP-392 follower fetch",
        "Redis enables the AZ-affinity read option in the GLIDE client",
        "Aurora points at the same-AZ instance endpoint instead of the reader endpoint"
      ]
    }
  ]
