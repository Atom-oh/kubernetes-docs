{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Self-Service Dev Environments in IDP",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "column_fit": "spread",
    "viewBox": [
      1080,
      690
    ],
    "views": [
      {
        "id": "request",
        "label": "Request via portal",
        "focus": [
          "developer",
          "backstage",
          "gitops"
        ],
        "note": "The developer never touches the host cluster: Backstage turns the form into a GitOps pull request."
      },
      {
        "id": "provision",
        "label": "GitOps provisioning",
        "focus": [
          "gitops",
          "host",
          "vcluster"
        ],
        "note": "ArgoCD syncs the merged PR, creates the namespace and waits for the vCluster API to become healthy."
      },
      {
        "id": "handoff",
        "label": "Kubeconfig hand-off",
        "focus": [
          "backstage",
          "developer",
          "vcluster",
          "host"
        ],
        "note": "Status flows back to the portal; the developer receives a kubeconfig and uses the vCluster like a normal cluster."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "default": {
          "label": "call"
        },
        "emphasis": {
          "label": "headline step"
        },
        "return": {
          "label": "return"
        },
        "dashed": {
          "label": "syncer sync"
        }
      }
    }
  },
  "participants": [
    {
      "id": "developer",
      "type": "external",
