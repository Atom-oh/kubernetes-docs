  "cards": [
    {
      "dot": "cyan",
      "title": "Pod IP allocation fails",
      "items": [
        "Symptom: pods stay in ContainerCreating with an IP allocation failure message",
        "Cause: the node is out of free IPs, or it hit the ENI limit",
        "Fix: raise WARM_IP_TARGET, move to a larger instance type, or use custom networking",
        "Diagnose: kubectl describe node · kubectl logs -n kube-system -l k8s-app=aws-node"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pod-to-pod traffic and DNS",
      "items": [
        "Symptom: pod-to-pod connections fail, time out, or service names do not resolve",
        "Cause: a network policy blocks it, a security group rule, or CoreDNS trouble",
        "Diagnose: kubectl get networkpolicy, then run ping and nslookup through kubectl exec",
        "Check CoreDNS pod status and logs together"
      ]
    },
    {
      "dot": "amber",
      "title": "Load balancers and tooling",
      "items": [
        "For load balancer creation failures, check subnet tags, security groups, and IAM permissions first",
        "Required tags: kubernetes.io/role/elb=1 (public), kubernetes.io/role/internal-elb=1 (private)",
        "Run tcpdump and traceroute from a netshoot pod, then confirm the path with VPC Flow Logs"
      ]
    }
  ]
}