  "cards": [
    {
      "dot": "cyan",
      "title": "Matrix generator",
      "items": [
        "Combines two child generators into a Cartesian product",
        "Generator 1: clusters with label environment=production",
        "Generator 2: git directories matching apps/*"
      ]
    },
    {
      "dot": "emerald",
      "title": "Template per pair",
      "items": [
        "name: {{name}}-{{path.basename}}",
        "destination server: {{server}}",
        "namespace and path: {{path.basename}} / {{path}}"
      ]
    }
  ]
