  "cards": [
    {
      "dot": "cyan",
      "title": "Pod Deletion Cost Concept",
      "items": [
        "Introduced in Kubernetes 1.22",
        "Assigns a cost value to each pod through the controller.kubernetes.io/pod-deletion-cost annotation",
        "Controls which pods are deleted first when a ReplicaSet, Deployment, or StatefulSet scales down"
      ]
    },
    {
      "dot": "amber",
      "title": "Key Features",
      "items": [
        "Default value: 0",
        "Range: -2147483648 to 2147483647 (int32)",
        "Higher value = more important pod (deleted later)",
        "Lower value = less important pod (deleted first)"
      ]
    }
  ]
