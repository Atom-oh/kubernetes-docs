  "cards": [
    {
      "dot": "cyan",
      "title": "JobManager (JM)",
      "items": [
        "Control plane of the Flink cluster — runs as its own pod",
        "Builds the job graph, coordinates checkpoints, schedules work onto TaskManagers",
        "Serves the REST API and Web UI"
      ]
    },
    {
      "dot": "emerald",
      "title": "TaskManager (TM)",
      "items": [
        "Worker process that actually executes the job — one pod per TaskManager",
        "Offers one or more task slots; each slot runs one operator subtask",
        "With slot sharing, the slots a job needs is usually its maximum operator parallelism"
      ]
    },
    {
      "dot": "orange",
      "title": "Kubernetes ResourceManager",
      "items": [
        "Talks to the Kubernetes API server to request and release TaskManager pods",
        "Used only in native Kubernetes deployment — absent in standalone-on-Kubernetes"
      ]
    }
  ]
