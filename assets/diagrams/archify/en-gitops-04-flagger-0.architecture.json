        "id": "automation",
        "label": "Image automation and alerts",
        "focus": [
          "imageauto",
          "git",
          "notification",
          "flagger"
        ],
        "note": "Image controllers update marked YAML on a branch; PR merging is separate. A configured receiver handles Flagger events."
      }
