{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "acks=1 vs acks=all — the path of a produce request to commit",
    "quality_profile": "showcase",
    "locale": "en",
    "animation": "trace",
    "viewBox": [
      1600,
      960
    ],
    "column_fit": "spread",
    "views": [
      {
        "id": "acks1",
        "label": "acks=1 — leader only",
        "focus": [
          "producer",
          "leader",
          "pagecache"
        ],
        "note": "Responds as soon as the leader's local log (page cache) has the record. Measured p99 17 ms at 20k rec/s (B2)."
      },
      {
        "id": "acksall",
        "label": "acks=all — commit after ISR replication",
        "focus": [
          "producer",
          "leader",
          "follower1",
          "follower2"
        ],
        "note": "Both followers replicate by pulling and the HW must advance before the response. Same p50 (3 ms) but p99 126 ms (B1)."
      },
      {
        "id": "flush",
        "label": "Disk flush is asynchronous",
        "focus": [
          "pagecache",
          "ebs"
        ],
        "note": "No fsync by default — the OS flushes in the background. At saturation the RF3 ceiling ≈130–135 MiB/s = one gp3 volume's write cap (F1)."
      }
    ]
  },
  "participants": [
    {
      "id": "producer",
      "type": "external",
      "label": "Producer"
    },
    {
      "id": "leader",
      "type": "backend",
      "label": "kafka-0 (leader)"
    },
    {
      "id": "follower1",
      "type": "backend",
      "label": "kafka-1 (follower, ISR)"
    },
    {
      "id": "follower2",
      "type": "backend",
      "label": "kafka-2 (follower, ISR)"
    },
    {
      "id": "pagecache",
      "type": "database",
      "label": "Page cache (kafka-0 log)"
    },
    {
      "id": "ebs",
      "type": "cloud",
      "label": "EBS gp3 (kafka-0 volume)"
    }
  ],
  "segments": [
    {
      "from": 165,
      "to": 312,
      "label": "acks=1 — respond as soon as the leader's local log has it · measured at 20k rec/s: p50 3 ms · p99 17 ms (B2)"
    },
    {
      "from": 332,
      "to": 735,
      "label": "acks=all + min.insync.replicas=2 — commit only after the followers have pulled the records · measured at 20k rec/s: p50 3 ms · p99 126 ms (B1) — the cost is in the tail, not p50"
    },
    {
      "from": 755,
      "to": 825,
      "label": "Durability comes from replication — disk flush is asynchronous · at saturation the RF3 ingest ceiling ≈130–135 MiB/s = one gp3 volume's write cap (F1)"
    }
  ],
