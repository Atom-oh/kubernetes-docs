{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Acknowledgements: append, replication and writeback",
    "quality_profile": "showcase",
    "locale": "en",
    "animation": "trace",
    "viewBox": [
      1600,
      960
    ],
    "column_fit": "spread",
    "views": [
      {
        "id": "acks1",
        "label": "acks=1 — leader only",
        "focus": [
          "producer",
          "leader",
          "pagecache"
        ],
        "note": "Respond after leader append, without waiting for followers. B2's p99 of 17 ms is a single-run report."
      },
      {
        "id": "acksall",
        "label": "acks=all — commit after ISR replication",
        "focus": [
          "producer",
          "leader",
          "follower1",
          "follower2"
        ],
        "note": "This trace assumes a stable three-member ISR. A batch ending at offset r requires next offset r+1."
      },
      {
        "id": "flush",
        "label": "Disk flush is asynchronous",
        "focus": [
          "pagecache",
          "ebs"
        ],
        "note": "OS writeback can overlap other stages. An ack is not a per-record fsync guarantee on each replica."
      }
    ]
  },
