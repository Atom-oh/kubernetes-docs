{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Outlier Detection Process",
    "output": "public/archmaps/en-service-mesh-istio-resilience-01-outlier-detection-1.html",
    "animation": "trace",
