    "views": [
      {
        "id": "detect",
        "label": "Error detection",
        "focus": [
          "start",
          "check",
          "count",
          "threshold"
        ],
        "note": "Each request is checked for an error and the consecutive error count is compared with the consecutiveErrors threshold."
      },
      {
        "id": "eject-recover",
        "label": "Ejection and recovery",
        "focus": [
          "threshold",
          "eject",
          "wait",
          "retry",
          "start"
        ],
        "note": "An instance over the threshold is ejected for baseEjectionTime, then retried and returned to the request cycle."
      }
    ],
    "locale": "en",
    "legend": {
      "entries": {
        "frontend": {
          "label": "Request entry"
        },
        "backend": {
          "label": "Processing step"
        },
        "security": {
          "label": "Decision"
        },
        "external": {
          "label": "Ejected from pool"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "request",
      "label": "Request evaluation"
    },
    {
      "id": "healthy",
      "label": "Normal processing"
    },
    {
      "id": "ejection",
      "label": "Ejection · recovery",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "start",
    "check",
    "count",
    "threshold",
    "eject",
    "wait",
    "retry"
  ],
