  "activations": [
    {
      "participant": "prometheus",
      "from": 175,
      "to": 240,
      "type": "backend"
    },
    {
      "participant": "alertmanager",
      "from": 230,
      "to": 455,
      "type": "messagebus"
    },
    {
      "participant": "receiver",
      "from": 395,
      "to": 450,
      "type": "external"
    }
  ],
  "cards": [
    {
      "dot": "orange",
      "title": "Evaluation and delivery",
      "items": [
        "Positive for uses Pending; zero for can fire immediately",
        "Send alert updates directly to every Alertmanager replica"
      ]
    },
    {
      "dot": "violet",
      "title": "Notification pipeline",
      "items": [
        "After routing/grouping: timers, inhibition, silences and nflog deduplication",
        "Failures, partitions and retries can produce duplicate notifications"
      ]
    }
  ]
