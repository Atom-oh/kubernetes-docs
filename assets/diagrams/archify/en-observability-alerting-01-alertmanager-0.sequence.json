{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Prometheus Alert Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      900,
      560
    ],
    "animation": "trace",
    "views": [
      {
        "id": "evaluate",
        "label": "Evaluate and fire",
        "focus": [
          "prometheus",
          "alertmanager"
        ],
        "note": "A zero-for rule may fire at its matching evaluation. Prometheus sends alert updates to every replica."
      },
      {
        "id": "pipeline",
        "label": "Alertmanager pipeline",
        "focus": [
          "alertmanager"
        ],
        "note": "Select routes and aggregate groups before timers, notification suppression and deduplication."
      },
      {
        "id": "notify",
        "label": "Receiver notification",
        "focus": [
          "alertmanager",
          "receiver"
        ],
        "note": "The notification goes to the routed receiver, which returns the delivery result."
      }
    ]
  },
  "participants": [
    {
      "id": "prometheus",
      "type": "backend",
      "label": "Prometheus",
      "sublabel": "alert rule evaluation"
    },
    {
      "id": "alertmanager",
      "type": "messagebus",
      "label": "Alertmanager",
      "sublabel": "alert pipeline"
    },
    {
      "id": "receiver",
      "type": "external",
      "label": "Receiver",
      "sublabel": "Slack / PagerDuty"
    }
  ],
  "segments": [
    {
      "from": 165,
      "to": 270,
      "label": "Rule evaluation and state updates"
    },
    {
      "from": 290,
      "to": 360,
      "label": "Route selection → aggregation → notification pipeline"
    },
    {
      "from": 380,
      "to": 465,
      "label": "Receiver notification"
    }
  ],
  "messages": [
    {
      "id": "post-alerts",
      "from": "prometheus",
      "to": "alertmanager",
      "y": 230,
      "label": "POST /api/v2/alerts",
      "variant": "emphasis",
      "note": "firing and resolved updates"
    },
    {
      "id": "notify",
      "from": "alertmanager",
      "to": "receiver",
      "y": 400,
      "label": "send notification",
      "variant": "emphasis",
      "note": "to the routed receiver after the pipeline"
    },
    {
      "id": "result",
      "from": "receiver",
      "to": "alertmanager",
      "y": 445,
      "label": "send result",
      "variant": "return"
    }
