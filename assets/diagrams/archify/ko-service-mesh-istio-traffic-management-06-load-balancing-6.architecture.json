    {
      "dot": "cyan",
      "title": "트래픽 패턴별 선택",
      "items": [
        "균일한 작은 요청(< 10ms) → ROUND_ROBIN",
        "불균일한 요청(10ms ~ 1s+) → LEAST_REQUEST",
        "매우 큰 트래픽(10,000+ RPS) → RANDOM",
        "세션 기반(사용자 상태) → consistentHash.httpCookie",
        "Multi-region → LEAST_REQUEST + localityLbSetting"
      ]
    },
    {
      "dot": "emerald",
      "title": "서비스 유형별 권장",
      "items": [
        "REST / GraphQL / gRPC API → LEAST_REQUEST",
        "웹 프론트엔드 → CONSISTENT_HASH (cookie)",
        "WebSocket, 캐시 서비스 → CONSISTENT_HASH (header)",
        "분석/로그 수집 → RANDOM",
        "Static Content → ROUND_ROBIN"
      ]
    }
  ]
