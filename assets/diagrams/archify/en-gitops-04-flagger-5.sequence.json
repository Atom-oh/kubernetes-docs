    {
      "id": "spec-changed",
      "from": "kubernetes",
      "to": "flagger",
      "y": 286,
      "label": "Deployment spec changed",
      "variant": "return"
    },
    {
      "id": "create-canary",
      "from": "flagger",
      "to": "kubernetes",
      "y": 326,
      "label": "scale original canary"
    },
    {
      "id": "promote",
      "from": "flagger",
      "to": "kubernetes",
