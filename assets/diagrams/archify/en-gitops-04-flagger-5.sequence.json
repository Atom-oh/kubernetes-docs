    ],
    "views": [
      {
        "id": "flux-sync",
        "label": "Flux reconciles Git",
        "focus": [
          "developer",
          "git",
          "flux",
          "kubernetes"
        ],
        "note": "Source fetches Git/charts; Kustomize applies HelmRelease and Helm reconciles the target workload."
      },
      {
        "id": "canary-analysis",
        "label": "Flagger canary analysis",
        "focus": [
          "kubernetes",
          "flagger"
        ],
        "note": "Flagger manages how the change is rolled out: it initializes the canary, creates canary pods, and runs the analysis."
      },
      {
        "id": "outcome",
        "label": "Promote or rollback",
        "focus": [
          "flagger",
          "kubernetes",
          "developer"
        ],
        "note": "Final checks permit primary update/readiness/promotion. Reached pre-promotion failure limits restore primary."
      }
    ],
    "legend": {
      "mode": "hidden"
    }
  },
  "participants": [
    {
