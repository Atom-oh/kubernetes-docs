    },
    {
      "id": "notify-ok",
      "from": "flagger",
      "to": "developer",
      "y": 416,
      "label": "notify: deployment succeeded",
      "variant": "return"
    },
    {
      "id": "rollback",
      "from": "flagger",
      "to": "kubernetes",
      "y": 466,
