      "label": "Flagger",
      "sublabel": "canary controller"
    },
    {
      "id": "kubernetes",
      "type": "cloud",
      "label": "Kubernetes",
      "sublabel": "Deployment + pods"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 254,
      "label": "Flux applies the target workload"
    },
    {
      "from": 266,
      "to": 344,
      "label": "Flagger starts canary analysis"
    },
    {
      "from": 356,
      "to": 434,
      "label": "Alternative: final checks pass"
    },
    {
      "from": 446,
