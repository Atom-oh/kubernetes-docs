    },
    {
      "id": "stage",
      "lane": "registry",
      "col": 2,
      "type": "database",
      "label": "myapp-stage",
      "sublabel": "1.2.3-rc.1",
      "tag": "immutable"
    },
    {
      "id": "prod",
      "lane": "registry",
      "col": 3,
      "type": "database",
      "label": "myapp-prod",
