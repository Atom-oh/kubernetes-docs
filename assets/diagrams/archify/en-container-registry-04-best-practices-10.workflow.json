      "id": "build_phase",
      "label": "Build once",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "promote_phase",
      "label": "Promote by retag, not rebuild",
      "fromCol": 1,
      "toCol": 3,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "build",
    "dev",
    "stage",
    "prod"
  ],
  "nodes": [
    {
      "id": "build",
      "lane": "ci",
      "col": 0,
      "type": "backend",
      "label": "Build",
