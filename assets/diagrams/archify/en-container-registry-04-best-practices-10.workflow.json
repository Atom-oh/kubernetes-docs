    "views": [
      {
        "id": "build-once",
        "label": "Build once",
        "focus": [
          "build",
          "dev"
        ],
        "note": "CI builds the image a single time and pushes it to the dev repository with a SHA-based tag."
      },
      {
        "id": "promote",
        "label": "Promote by retag",
        "focus": [
          "dev",
          "stage",
          "prod"
        ],
        "note": "Each promotion pulls, retags and pushes the same digest; nothing is rebuilt."
      }
    ]
  },
