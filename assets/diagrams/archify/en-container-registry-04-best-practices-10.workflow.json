      "label": "retag + promote",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Promotion step",
      "items": [
        "docker pull SOURCE_REPO:SOURCE_TAG",
        "docker tag to TARGET_REPO:TARGET_TAG",
        "docker push the retagged image"
      ]
    },
    {
      "dot": "amber",
      "title": "Why not rebuild",
      "items": [
        "The same image digest travels through every environment",
        "What was tested in stage is bit-for-bit what runs in prod",
        "Production and staging tags are immutable SemVer; dev tags are SHA-based"
      ]
    }
  ]
