    {
      "id": "start",
      "lane": "preview_stage",
      "col": 0,
      "width": 160,
      "type": "frontend",
      "label": "새 버전 배포 시작",
      "sublabel": "Rollout 업데이트"
    },
    {
      "id": "preview",
      "lane": "preview_stage",
      "col": 1,
      "width": 160,
