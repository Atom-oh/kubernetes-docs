      "label": "promote 명령",
      "variant": "emphasis"
    },
    {
      "id": "switch-post",
      "from": "switch",
      "to": "post_analysis"
    },
    {
      "id": "post-rollback",
      "from": "post_analysis",
      "to": "rollback",
      "label": "실패",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "post-scale",
      "from": "post_analysis",
      "to": "scale_down",
      "label": "성공",
      "variant": "emphasis"
    },
    {
