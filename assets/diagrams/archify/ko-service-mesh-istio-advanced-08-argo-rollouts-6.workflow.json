    },
    {
      "id": "switch",
      "lane": "promote_stage",
      "col": 4,
      "width": 160,
      "type": "cloud",
      "label": "Active Service 전환",
      "sublabel": "Blue → Green",
      "tag": "트래픽 전환"
    },
    {
      "id": "post_analysis",
      "lane": "verify_stage",
      "col": 4,
      "width": 160,
      "type": "security",
      "label": "사후 분석",
      "sublabel": "comprehensive-analysis"
    },
    {
      "id": "scale_down",
