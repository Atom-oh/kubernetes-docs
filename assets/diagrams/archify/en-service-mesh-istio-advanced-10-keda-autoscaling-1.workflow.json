    },
    {
      "from": "check2",
      "to": "scaleIn",
      "label": "Yes",
      "role": "branch"
    },
    {
      "from": "check2",
      "to": "wait",
      "label": "No",
      "role": "branch"
    },
    {
      "from": "scaleOut",
      "to": "wait",
