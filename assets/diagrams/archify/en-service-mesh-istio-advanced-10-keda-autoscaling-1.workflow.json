      "width": 120
    },
    {
      "id": "scaleOut",
      "lane": "scale",
      "col": 3,
      "type": "cloud",
      "label": "Increase replicas",
      "sublabel": "scale out · max 20",
      "width": 170
    },
    {
      "id": "scaleIn",
      "lane": "scale",
      "col": 4,
      "type": "cloud",
      "label": "Decrease replicas",
      "sublabel": "scale in · min 2",
      "width": 170
    }
  ],
  "edges": [
    {
      "from": "collect",
      "to": "query",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "from": "query",
