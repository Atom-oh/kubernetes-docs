{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How RPS-based KEDA Scaling Works",
    "output": "public/archmaps/en-service-mesh-istio-advanced-10-keda-autoscaling-1.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": {
          "label": "KEDA polling"
        },
        "database": {
          "label": "PromQL query"
        },
        "security": {
          "label": "Threshold check"
        },
        "cloud": {
          "label": "HPA scaling"
        }
      }
    },
    "views": [
      {
        "id": "scale-out",
        "label": "Scale-out path",
        "focus": [
          "collect",
          "query",
          "check",
          "scaleOut",
          "wait"
        ],
        "note": "When RPS exceeds the threshold of 100, replicas are increased and KEDA waits out the cooldownPeriod."
      },
      {
        "id": "scale-in",
        "label": "Scale-in path",
        "focus": [
          "check",
          "check2",
          "scaleIn",
          "wait"
        ],
        "note": "When RPS drops below the activationThreshold of 50, replicas are decreased; in between, it simply waits."
      },
      {
        "id": "loop",
        "label": "Polling loop",
        "focus": [
          "wait",
          "collect"
        ],
        "note": "Every pollingInterval (30 s) metrics are collected again and the same evaluation repeats."
      }
    ],
    "locale": "en",
    "viewBox": [
      1240,
      560
    ]
  },
  "lanes": [
    {
      "id": "poll",
      "label": "KEDA polling loop"
    },
    {
      "id": "decide",
      "label": "Threshold check"
    },
    {
      "id": "scale",
      "label": "HPA replica adjustment"
    }
  ],
  "mainPath": [
    "collect",
    "query",
    "check",
    "scaleOut",
    "wait"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "collect"
    ],
    "requiredPaths": [
      {
        "from": "collect",
        "to": "scaleOut"
      },
      {
        "from": "collect",
        "to": "scaleIn"
      },
      {
        "from": "wait",
        "to": "collect"
      }
    ]
  },
  "nodes": [
    {
      "id": "collect",
      "lane": "poll",
      "col": 0,
      "type": "backend",
      "label": "Collect metrics",
