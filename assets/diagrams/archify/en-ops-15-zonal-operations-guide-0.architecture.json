  "cards": [
    {
      "dot": "cyan",
      "title": "Why the load balancer lives outside the cluster",
      "items": [
        "Create the NLB/ALB and target group outside the cluster with IaC such as Terraform",
        "Deleting or rebuilding the cluster leaves the load balancer and its DNS name intact",
        "Bind each zonal cluster's Service to that target group with the TargetGroupBinding CRD"
      ]
    },
    {
      "dot": "emerald",
      "title": "Weighted shift",
      "items": [
        "Route 53 weighted records adjust the traffic split between cells",
        "Roll a new version into one cell and move its weight 20% → 50% → 100%",
        "If something looks wrong, drop the weight to 0 to isolate that cell immediately"
      ]
    },
    {
      "dot": "amber",
      "title": "Cell isolation",
      "items": [
        "Align cells with AZ boundaries so a failure stays inside one AZ",
        "Isolation only holds if shared resources between cells are minimized",
        "Application Recovery Controller (ARC) can automate the zonal shift"
      ]
    }
  ]
