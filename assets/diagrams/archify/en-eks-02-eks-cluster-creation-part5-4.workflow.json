  "cards": [
    {
      "dot": "cyan",
      "title": "Why the order matters",
      "items": [
        "Leave LoadBalancer Services and Ingresses behind and the ALBs and NLBs keep billing",
        "Deleting PVCs first lets the reclaim policy clean up the EBS volumes",
        "Cluster deletion fails while node groups or Fargate profiles still exist"
      ]
    },
    {
      "dot": "emerald",
      "title": "Commands",
      "items": [
        "kubectl delete svc --all-namespaces --field-selector spec.type=LoadBalancer",
        "eksctl delete cluster --name my-cluster removes stacks in the right order",
        "If you built it with the CLI, delete in this order: delete-nodegroup → delete-fargate-profile → delete-cluster"
      ]
    },
    {
      "dot": "amber",
      "title": "After deletion",
      "items": [
        "A hand-built VPC, security groups, and IAM roles survive and need separate cleanup",
        "Check CloudWatch log groups and EBS snapshots against your retention policy",
        "Back up anything you need before deleting and confirm it can be restored"
      ]
    }
  ]
}