  "cards": [
    {
      "dot": "orange",
      "title": "Cluster Creation Failure",
      "items": [
        "Troubleshooting steps: check IAM permissions → service quotas → network configuration → CloudTrail logs → AWS service status",
        "Common solutions: add IAM permissions, request a quota increase, fix network configuration, try a different region"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cluster Endpoint Access Issues",
      "items": [
        "Troubleshooting steps: check the cluster endpoint → endpoint access policy → kubeconfig → authentication",
        "Common solutions: modify endpoint access policy, regenerate kubeconfig, configure IAM auth (aws-auth), create a VPC endpoint, use CloudShell one-click access"
      ]
    },
    {
      "dot": "rose",
      "title": "Cluster Deletion Issues",
      "items": [
        "Troubleshooting steps: check cluster status → node groups, Fargate profiles, add-ons → CloudTrail logs",
        "Common solutions: delete dependent resources, force delete with eksctl, manual resource cleanup, AWS resource cleanup (ELB, security groups)"
      ]
    }
  ]
