  "cards": [
    {
      "dot": "cyan",
      "title": "Snapshot object model",
      "items": [
        "The VolumeSnapshotClass decides which CSI driver takes the snapshot",
        "VolumeSnapshot is the user request; VolumeSnapshotContent points at the real snapshot",
        "EBS snapshots are incremental, so later snapshots store only changed blocks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Restore procedure",
      "items": [
        "Name the VolumeSnapshot and its kind in the new PVC's spec.dataSource",
        "The restored volume must be the same size as the original or larger",
        "A restored PV inherits the region and AZ constraints of the snapshot"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational automation",
      "items": [
        "Velero manages snapshot schedules and restore jobs declaratively",
        "Include PVC snapshots in namespace-level backups",
        "Rehearse restores regularly to confirm recovery actually works"
      ]
    }
  ]
