  "cards": [
    {
      "dot": "cyan",
      "title": "How selectors work",
      "items": [
        "A pod matching both the profile's namespace and label selector is scheduled onto Fargate",
        "With only a namespace and no labels, every pod in that namespace matches",
        "If several profiles match, one is chosen arbitrarily, so design rules that do not overlap"
      ]
    },
    {
      "dot": "emerald",
      "title": "Limitations",
      "items": [
        "DaemonSets, privileged containers, and HostNetwork or HostPort are unavailable",
        "GPUs and EBS volumes are unsupported, so use EFS for persistent volumes",
        "Pods land only in private subnets, and Classic Load Balancers are not supported"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational tips",
      "items": [
        "A pod execution role is required before images can be pulled",
        "Requested CPU and memory round up to a Fargate size, so state resource requests precisely",
        "You skip node management, but pod startup is slower than on node groups"
      ]
    }
  ]
}