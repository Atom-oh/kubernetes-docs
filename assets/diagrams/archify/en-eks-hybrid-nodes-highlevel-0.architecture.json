  "cards": [
    {
      "dot": "cyan",
      "title": "How it connects",
      "items": [
        "The EKS control plane creates ENIs in the cluster VPC to reach nodes",
        "Hybrid nodes must reach those ENIs from on-premises over a private path",
        "Cloud nodes and hybrid nodes can coexist in the same cluster"
      ]
    },
    {
      "dot": "emerald",
      "title": "Required private connectivity",
      "items": [
        "Either AWS Direct Connect or Site-to-Site VPN is mandatory",
        "Going over the public internet is unsupported, and routing must work both ways",
        "Add routes for the remote node and pod CIDRs to the gateway in the VPC route table"
      ]
    },
    {
      "dot": "amber",
      "title": "Reaching AWS services",
      "items": [
        "Hybrid nodes also need credentials, through SSM or IAM Roles Anywhere",
        "Services such as ECR and S3 can be reached privately through VPC endpoints",
        "The DNS resolution path out of on-premises needs designing too"
      ]
    }
  ]
