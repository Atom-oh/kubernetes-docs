{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Traditional Deployment vs Feature Flag Deployment",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "traditional",
        "label": "Traditional deployment",
        "focus": [
          "deploy_t",
          "release_t",
          "all_users"
        ],
        "note": "Deploying the code is the release: the moment the new version rolls out, every user sees the new feature."
      },
      {
        "id": "flagged",
        "label": "Feature flag deployment",
        "focus": [
          "deploy_f",
          "flag",
          "target_users",
          "existing"
        ],
        "note": "Deployment and release are decoupled: the flag value alone controls when and to whom the feature is exposed, with no code change."
      },
      {
        "id": "decision",
        "label": "Flag evaluation outcome",
        "focus": [
          "flag",
          "target_users",
          "existing"
        ],
        "note": "Only target users whose flag evaluates ON see the new feature; users with OFF keep the existing experience."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Code deployment"
        },
        "backend": {
          "label": "Release decision"
        },
        "cloud": {
          "label": "User exposure"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "trad",
      "label": "Traditional deployment"
    },
    {
      "id": "ff",
      "label": "Feature flag deployment"
    }
  ],
