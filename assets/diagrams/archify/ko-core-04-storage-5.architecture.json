        "secret db-credentials: username → db-username, password → db-password",
        "configMap app-config: config.yaml → app-config.yaml",
        "downwardAPI: metadata.labels → labels, metadata.namespace → namespace",
        "serviceAccountToken: path token, expirationSeconds 3600, audience api"
