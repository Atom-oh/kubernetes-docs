  "meta": {
    "title": "How spark-submit Works on Kubernetes",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1060,
      620
    ],
    "animation": "trace",
    "views": [
      {
        "id": "driver",
        "label": "Driver pod creation",
        "focus": [
          "user",
          "api",
          "driver"
        ],
        "note": "spark-submit talks to the API server and creates the driver pod directly — no intermediate scheduling process."
      },
      {
        "id": "executors",
        "label": "Executor pod creation",
        "focus": [
          "driver",
          "api",
          "exec"
        ],
        "note": "The driver itself calls back into the Kubernetes API to create executor pods (per spark.executor.instances or DRA)."
      },
      {
        "id": "tasks",
        "label": "Task execution and cleanup",
        "focus": [
          "driver",
          "exec",
          "api"
        ],
        "note": "Executors register with the driver, pull tasks, run them and report results; when the job finishes the driver cleans up the executor pods."
      }
    ]
  },
