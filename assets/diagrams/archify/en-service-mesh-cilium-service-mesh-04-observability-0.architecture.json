  "cards": [
    {
      "dot": "cyan",
      "title": "Flow path",
      "items": [
        "Hubble Observer is embedded in the Cilium Agent and collects flows per node",
        "Hubble Relay (Deployment) aggregates flows across the whole cluster",
        "Hubble UI (Deployment) and the locally installed Hubble CLI show the aggregated result"
      ]
    },
    {
      "dot": "amber",
      "title": "Metrics path",
      "items": [
        "Hubble Metrics are also embedded in the Cilium Agent and expose Prometheus metrics",
        "dns, drop, tcp, flow, icmp and http metrics are enabled through Helm values",
        "Grafana dashboards visualize the metrics scraped by Prometheus"
      ]
    }
