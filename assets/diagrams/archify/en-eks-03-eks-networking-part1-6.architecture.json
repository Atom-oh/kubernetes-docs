    {
      "dot": "cyan",
      "title": "Public subnet tags",
      "items": [
        "kubernetes.io/role/elb: 1 — marks subnets for internet-facing load balancers",
        "kubernetes.io/cluster/<cluster-name>: shared or owned",
        "shared allows other clusters to use it; owned is exclusive to this cluster"
      ]
    },
    {
      "dot": "emerald",
      "title": "Private subnet tags",
      "items": [
        "kubernetes.io/role/internal-elb: 1 — marks subnets for internal load balancers",
        "These subnets host worker nodes and carry internal traffic only",
        "Add operational tags such as Name and Environment alongside them"
      ]
    },
    {
      "dot": "amber",
      "title": "Watch out for",
      "items": [
        "Tag values are case-sensitive and the cluster name must match exactly",
        "Without the tags the controller cannot find subnets and load balancer creation fails",
        "Apply them per subnet with aws ec2 create-tags and audit them regularly"
      ]
    }
