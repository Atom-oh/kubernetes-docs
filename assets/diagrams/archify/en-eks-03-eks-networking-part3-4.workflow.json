  "cards": [
    {
      "dot": "cyan",
      "title": "Step 1 — inspect state",
      "items": [
        "kubectl get pods -o wide shows which node each pod landed on and with what IP",
        "kubectl describe pod and describe node reveal events and allocatable IPs",
        "Read the CNI logs with kubectl logs -n kube-system -l k8s-app=aws-node"
      ]
    },
    {
      "dot": "emerald",
      "title": "Step 2 — test the path",
      "items": [
        "Run ping, curl, and telnet via kubectl exec to narrow down how far traffic gets",
        "nslookup kubernetes.default isolates whether DNS resolution itself works",
        "kubectl get networkpolicy and describe networkpolicy expose blocking rules"
      ]
    },
    {
      "dot": "amber",
      "title": "Step 3 — remediate",
      "items": [
        "IP shortage: raise WARM_IP_TARGET and MINIMUM_IP_TARGET on aws-node",
        "Restart with kubectl rollout restart daemonset aws-node and deployment coredns",
        "Restarting a node is the last resort; drain first and uncordon afterwards"
      ]
    }
  ]
}