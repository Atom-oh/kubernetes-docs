      "to": "classify",
      "label": "combine"
    },
    {
      "id": "e4",
      "from": "classify",
      "to": "ipfix",
      "label": "IP shortage",
      "role": "branch"
    },
    {
      "id": "e5",
      "from": "ipfix",
      "to": "restart",
      "label": "applied"
    },
