      "lane": "diag",
      "col": 2,
      "type": "backend",
      "label": "Step 2 test path",
      "sublabel": "ping · nslookup",
      "width": 150
    },
    {
      "id": "classify",
      "lane": "diag",
      "col": 3,
      "type": "security",
      "label": "Cause class",
      "sublabel": "IP · policy · DNS",
      "width": 150
    },
    {
      "id": "ipfix",
      "lane": "fix",
      "col": 4,
      "type": "backend",
      "label": "Resize IP pool",
      "sublabel": "WARM_IP_TARGET",
      "width": 150
    },
    {
      "id": "restart",
      "lane": "fix",
      "col": 5,
      "type": "backend",
      "label": "Restart config",
      "sublabel": "aws-node · CoreDNS",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "alert",
