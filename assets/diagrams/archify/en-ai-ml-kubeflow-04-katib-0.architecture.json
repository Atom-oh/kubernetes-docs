{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "How an Experiment Runs, End to End",
    "locale": "en",
    "output": "en-ai-ml-kubeflow-04-katib-0.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1200,
      740
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "Experiment input"
        },
        "backend": {
          "label": "Katib components"
        },
        "cloud": {
          "label": "Trial training jobs"
        },
        "messagebus": {
          "label": "Metrics reporting"
        },
        "database": {
          "label": "Experiment status"
        }
      }
    },
    "views": [
      {
        "id": "submit",
        "label": "Submit and start Suggestion",
        "focus": [
          "experiment",
          "controller",
          "suggestion"
        ],
        "note": "The controller reconciles the Experiment and starts a Suggestion service for the requested algorithm."
      },
      {
        "id": "loop",
        "label": "Search loop",
        "focus": [
          "suggestion",
          "propose",
          "trial1",
          "trial2",
          "trialn",
          "sidecar"
        ],
        "note": "Each proposal becomes a Trial training job; metrics reported by the sidecar inform the next round of proposals."
      },
      {
        "id": "finish",
        "label": "Stop and record",
        "focus": [
          "suggestion",
          "succeeded",
          "record"
        ],
        "note": "Once maxTrialCount or the target objective is reached, the best Trial's hyperparameters and metric are recorded on status."
      }
    ]
  },
  "components": [
    {
      "id": "experiment",
      "type": "frontend",
      "label": "Experiment CRD created",
