      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "sugg-propose",
      "from": "suggestion",
      "to": "propose",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "propose-t1",
      "from": "propose",
      "to": "trial1",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "propose-t2",
      "from": "propose",
      "to": "trial2",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "propose-tn",
      "from": "propose",
      "to": "trialn",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "t1-sidecar",
      "from": "trial1",
      "to": "sidecar",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "t2-sidecar",
      "from": "trial2",
      "to": "sidecar",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "tn-sidecar",
      "from": "trialn",
      "to": "sidecar",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "sidecar-sugg",
      "from": "sidecar",
      "to": "suggestion",
      "label": "results feed back",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "left",
      "via": [
        [
          230,
          612
        ],
        [
          230,
          182
        ]
      ]
    },
    {
      "id": "sugg-succeeded",
      "from": "suggestion",
      "to": "succeeded",
      "label": "maxTrialCount reached or target objective hit",
      "variant": "emphasis"
    },
    {
      "id": "succeeded-record",
      "from": "succeeded",
      "to": "record",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ]
