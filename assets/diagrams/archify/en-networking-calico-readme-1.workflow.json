      {
        "id": "xsub",
        "label": "Cross-subnet traffic",
        "focus": [
          "l2",
          "xsub",
          "ipip",
          "direct"
        ],
        "note": "Nodes in different subnets use IPIP CrossSubnet (MTU 1480); same-subnet nodes still route directly."
      },
      {
        "id": "apply",
        "label": "Apply the mode",
        "focus": [
          "vxlan",
          "ipip",
          "direct",
          "ippool"
        ],
        "note": "Every branch ends by setting the chosen encapsulation on the IPPool."
      }
    ]
