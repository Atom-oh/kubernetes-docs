        "id": "bgp",
        "label": "BGP availability",
        "focus": [
          "start",
          "bgp",
          "vxlan"
        ],
        "note": "Without a BGP peer, Calico falls back to VXLAN encapsulation (UDP 4789, MTU 1450)."
      },
      {
        "id": "l2",
        "label": "L2 adjacency",
        "focus": [
          "bgp",
          "l2",
          "direct"
