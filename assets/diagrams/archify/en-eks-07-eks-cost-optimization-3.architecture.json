      "title": "EBS Volume Types",
      "items": [
        "gp3: General purpose SSD recommended for most workloads",
        "gp2: Previous generation general purpose SSD, migrate to gp3",
        "io1/io2: Provisioned IOPS SSD",
        "st1: Throughput optimized HDD",
        "sc1: Cold HDD"
      ]
    },
    {
      "dot": "emerald",
      "title": "EFS Throughput Modes",
      "items": [
        "Bursting Throughput: intermittent access patterns",
        "Provisioned Throughput: predictable performance",
        "Elastic Throughput: highly variable workloads"
      ]
    },
    {
      "dot": "amber",
      "title": "S3 Storage Classes",
      "items": [
        "S3 Standard: frequently accessed data",
        "S3 Intelligent-Tiering: data with changing access patterns",
        "S3 Standard-IA: infrequently accessed data",
        "S3 One Zone-IA: infrequently accessed, non-critical data",
        "S3 Glacier: archive data"
      ]
