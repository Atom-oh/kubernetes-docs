{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "SNS diagnostic processing",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1060,
      650
    ],
    "animation": "trace",
    "views": [
      {
        "id": "trigger",
        "label": "Normalize",
        "focus": [
          "alertmanager",
          "lambda"
        ],
        "note": "Validate input topic, allowlists and SNS message ID; check DynamoDB idempotency."
      },
      {
        "id": "collect",
        "label": "Collect evidence",
        "focus": [
          "lambda",
          "telemetry"
        ],
        "note": "Metrics/log aggregates use two workers; diagram rows identify calls, not mandatory serial scheduling."
      },
      {
        "id": "analyze",
        "label": "Deliver hypotheses",
        "focus": [
          "lambda",
          "bedrock",
          "sns",
          "oncall"
        ],
        "note": "Publish to a separate SNS topic; successful message IDs deduplicate for 24 hours."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "emphasis": {
          "label": "headline call"
        },
        "default": {
          "label": "query call"
        },
        "return": {
          "label": "return"
        },
        "dashed": {
          "label": "async email notify"
        }
      }
    }
  },
  "participants": [
    {
      "id": "alertmanager",
      "type": "external",
      "label": "Input SNS",
      "sublabel": "allowed alerts"
    },
    {
      "id": "lambda",
      "type": "backend",
      "label": "Lambda",
      "sublabel": "Diagnostic reporter"
    },
    {
      "id": "telemetry",
      "type": "database",
      "label": "Telemetry",
      "sublabel": "CW metrics · log counts"
    },
    {
      "id": "bedrock",
      "type": "cloud",
      "label": "Bedrock",
      "sublabel": "Converse"
    },
    {
      "id": "sns",
      "type": "messagebus",
      "label": "Output SNS",
      "sublabel": "different topic"
    },
    {
      "id": "oncall",
      "type": "external",
      "label": "On-call team",
      "sublabel": "configured subscription"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 205,
      "label": "Alert intake"
    },
    {
      "from": 220,
      "to": 410,
      "label": "Configured sources · 2 workers"
    },
    {
      "from": 425,
      "to": 577,
      "label": "AI analysis · notify"
    }
  ],
  "messages": [
    {
      "id": "webhook",
      "from": "alertmanager",
      "to": "lambda",
      "y": 180,
      "label": "SNS delivery · idempotency check",
      "variant": "emphasis"
    },
    {
      "id": "logs-query",
      "from": "lambda",
      "to": "telemetry",
      "y": 245,
      "label": "Start aggregate log query",
      "variant": "default"
    },
    {
      "id": "logs-result",
      "from": "telemetry",
      "to": "lambda",
      "y": 275,
      "label": "Complete status or missing data",
      "variant": "return"
    },
    {
      "id": "promql-query",
      "from": "lambda",
      "to": "telemetry",
      "y": 305,
      "label": "Configured CloudWatch metrics",
      "variant": "default"
    },
    {
      "id": "promql-result",
      "from": "telemetry",
      "to": "lambda",
      "y": 335,
      "label": "Actual values and timestamps",
      "variant": "return"
    },
    {
      "id": "claude-invoke",
      "from": "lambda",
      "to": "bedrock",
      "y": 455,
      "label": "Converse only with usable evidence",
      "variant": "emphasis"
    },
    {
      "id": "analysis-result",
      "from": "bedrock",
      "to": "lambda",
      "y": 500,
      "label": "Hypotheses and evidence gaps",
      "variant": "return"
    },
    {
      "id": "publish",
      "from": "lambda",
      "to": "sns",
      "y": 535,
      "label": "Publish to separate result topic",
      "variant": "emphasis"
    },
    {
      "id": "email",
      "from": "sns",
      "to": "oncall",
      "y": 560,
      "label": "Notification for human review",
      "variant": "dashed"
    }
  ],
  "activations": [
    {
      "participant": "lambda",
      "from": 175,
      "to": 542,
      "type": "backend"
    },
    {
      "participant": "telemetry",
      "from": 240,
      "to": 402,
      "type": "database"
    },
    {
      "participant": "bedrock",
      "from": 450,
      "to": 507,
