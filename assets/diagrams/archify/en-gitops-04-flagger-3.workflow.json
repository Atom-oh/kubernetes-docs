{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Canary CRD and Deployment Process",
    "locale": "en",
    "output": "public/archmaps/en-gitops-04-flagger-3.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "views": [
      {
        "id": "crd-fields",
        "label": "CRD fields",
        "focus": [
          "targetRef",
          "service",
          "provider",
          "analysis",
          "init"
        ],
        "note": "See how the Canary CRD's targetRef, service, provider and analysis feed each deployment step."
      },
      {
        "id": "traffic-steps",
        "label": "Traffic shifting and analysis",
        "focus": [
          "scale",
          "route",
          "metric"
        ],
        "note": "Traffic climbs by stepWeight 10 up to maxWeight 50, with metrics analyzed at a 1-minute interval at each step."
      },
      {
        "id": "promote-or-rollback",
        "label": "Promote or roll back",
        "focus": [
          "metric",
          "promote",
          "init"
        ],
        "note": "Final success promotes; reached cumulative failure limits restore primary during analysis and await another revision."
      }
    ]
  },
  "lanes": [
    {
      "id": "crd",
      "label": "Canary CRD"
    },
    {
      "id": "process",
      "label": "Deployment process"
    }
  ],
  "mainPath": [
    "init",
    "detect",
    "scale",
    "route",
    "metric",
    "promote"
  ],
  "nodes": [
    {
      "id": "targetRef",
      "lane": "crd",
      "col": 0,
      "type": "database",
      "label": "targetRef",
      "sublabel": "Deployment",
      "width": 150
    },
    {
      "id": "service",
      "lane": "crd",
      "col": 1,
      "type": "database",
      "label": "service",
      "sublabel": "port · protocol",
      "width": 150
    },
    {
      "id": "provider",
      "lane": "crd",
      "col": 3,
      "type": "database",
      "label": "provider",
      "sublabel": "mesh / ingress",
      "width": 150
    },
    {
      "id": "analysis",
      "lane": "crd",
      "col": 4,
      "type": "database",
      "label": "analysis",
      "sublabel": "metrics · thresholds · webhooks",
      "width": 170
    },
    {
      "id": "init",
      "lane": "process",
      "col": 0,
      "type": "backend",
      "label": "Primary ready",
      "sublabel": "initial / restored",
      "width": 150
    },
    {
      "id": "detect",
      "lane": "process",
      "col": 1,
      "type": "backend",
      "label": "Detect change",
      "sublabel": "Pod spec / tracked config",
      "width": 150
    },
    {
      "id": "scale",
      "lane": "process",
      "col": 2,
      "type": "backend",
      "label": "Scale up canary",
      "sublabel": "start canary pods",
      "width": 150
    },
    {
      "id": "route",
      "lane": "process",
      "col": 3,
      "type": "messagebus",
      "label": "Shift traffic",
      "sublabel": "10% → 50% · stepWeight 10",
      "width": 170
    },
    {
      "id": "metric",
      "lane": "process",
      "col": 4,
      "type": "security",
      "label": "Repeated analysis",
      "sublabel": "success rate ≥ 99% · P99 ≤ 500ms",
      "tag": "every 1m",
      "width": 190
    },
    {
      "id": "promote",
      "lane": "process",
      "col": 5,
      "type": "cloud",
      "label": "Promote",
      "sublabel": "ready / switch",
      "width": 138
    }
  ],
  "edges": [
    {
      "from": "targetRef",
      "to": "init",
      "label": "target ref",
      "role": "branch"
    },
    {
      "from": "service",
      "to": "init",
      "label": "create services",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "provider",
      "to": "route",
      "label": "routing control",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "analysis",
      "to": "metric",
      "label": "analysis rules",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "init",
      "to": "detect",
      "role": "main"
    },
    {
      "from": "detect",
      "to": "scale",
      "role": "main"
    },
    {
      "from": "scale",
      "to": "route",
      "role": "main"
    },
    {
      "from": "route",
      "to": "metric",
      "label": "each step",
      "role": "main"
    },
    {
      "from": "metric",
      "to": "promote",
      "label": "final pass",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "metric",
      "to": "init",
      "label": "threshold / restore",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Weight steps",
      "items": [
        "Analysis: 10 → 20 → 30 → 40 → 50%",
        "Promotion includes primary update and readiness waiting"
      ]
    },
    {
      "dot": "amber",
      "title": "Metrics and timing",
      "items": [
        "analysis.interval schedules; metric.interval is the query window",
        "99% / 500ms are illustrative SLO bounds"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "failedChecks >= threshold; success does not reset it",
        "Readiness deadlines and promotion failures need separate checks"
      ]
    }
  ]
}
