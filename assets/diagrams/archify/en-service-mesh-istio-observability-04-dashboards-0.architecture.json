          "grafana"
        ],
        "note": "Prometheus scrapes Envoy sidecar metrics, which the Kiali service graph and the Grafana metrics dashboards query."
      },
      {
        "id": "logs-path",
        "label": "Logs path",
        "focus": [
          "envoy",
          "loki",
          "grafana-logs"
        ],
        "note": "Envoy access logs are stored in Loki and analyzed in the Grafana log dashboards."
      },
      {
        "id": "traces-path",
        "label": "Traces path",
        "focus": [
          "envoy",
          "jaeger",
          "tempo",
          "jaeger-ui",
          "grafana"
        ],
        "note": "Envoy spans are sent to Jaeger or Tempo; distributed traces are viewed in Jaeger UI and Grafana."
      },
      {
        "id": "config-path",
        "label": "Config validation",
        "focus": [
          "istiod",
          "kiali"
        ],
        "note": "Kiali reads Istio configuration from istiod to validate CRDs such as VirtualService and DestinationRule."
      }
    ]
  },
