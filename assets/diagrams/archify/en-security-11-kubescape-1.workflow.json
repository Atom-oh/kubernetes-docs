        "id": "input-framework",
        "label": "Input and framework",
        "focus": [
          "cli",
          "fw",
          "parse"
        ],
        "note": "Choose explicit local manifests or a live cluster and a verified framework bundle."
      },
      {
        "id": "evaluation",
        "label": "Control evaluation",
        "focus": [
          "parse",
          "evalc",
          "check",
          "calc"
        ],
        "note": "Parse resources and evaluate applicable controls; unavailable coverage is not a pass."
      },
      {
        "id": "scoring-output",
        "label": "Scores and reports",
        "focus": [
          "calc",
          "sev",
          "prio",
          "pretty",
          "json",
          "sarif",
          "htmlpdf"
        ],
        "note": "Keep score and complianceScore separate. --format selects a type; --output names the file."
      }
    ],
