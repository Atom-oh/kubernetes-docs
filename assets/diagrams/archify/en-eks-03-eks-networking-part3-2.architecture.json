    {
      "dot": "cyan",
      "title": "Pod affinity",
      "items": [
        "Use podAffinity to co-locate chatty pairs such as web server and cache in one zone",
        "preferredDuringSchedulingIgnoredDuringExecution + topologyKey: topology.kubernetes.io/zone",
        "Intra-AZ traffic has lower latency than cross-AZ and no data transfer charge"
      ]
    },
    {
      "dot": "emerald",
      "title": "Node affinity",
      "items": [
        "nodeAffinity on node.kubernetes.io/instance-type pins workloads to the instance types they need",
        "Use requiredDuringScheduling for hard constraints and preferredDuringScheduling for soft ones"
      ]
    },
    {
      "dot": "amber",
      "title": "Topology spread",
      "items": [
        "topologySpreadConstraints with maxSkew: 1 spreads pods evenly across zones and nodes",
        "whenUnsatisfiable: DoNotSchedule is strict; ScheduleAnyway is permissive",
        "Keep only durability-driven traffic, such as DB replication, deliberately cross-AZ"
      ]
    }
