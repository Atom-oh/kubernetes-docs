  "cards": [
    {
      "dot": "cyan",
      "title": "Two clusters",
      "items": [
        "The management cluster in VPC 1 hosts ArgoCD, Argo Rollouts, and the observability stack",
        "The service cluster in VPC 2 runs the MSA applications and load generators",
        "Separating what you observe from what observes keeps monitoring alive during an incident"
      ]
    },
    {
      "dot": "emerald",
      "title": "Telemetry path",
      "items": [
        "The OTel Agent runs as a DaemonSet and gathers metrics, logs, and traces per node",
        "The OTel Collector fans each signal out to Prometheus, Loki, and Tempo",
        "A single Grafana explores all three signals together"
      ]
    },
    {
      "dot": "amber",
      "title": "Managed backend integration",
      "items": [
        "Prometheus remote-writes to AMP for long retention and high availability",
        "Logs can also go to CloudWatch Logs or OpenSearch",
        "Include the scaling events Karpenter and KEDA produce in what you observe"
      ]
    }
  ]
