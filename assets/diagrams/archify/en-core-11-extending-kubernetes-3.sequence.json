        "focus": [
          "user",
          "auth",
          "mac"
        ],
        "note": "The user's API request passes authentication and authorization first, then enters the admission phase."
      },
      {
        "id": "mutating",
        "label": "Mutating admission",
        "focus": [
          "mac",
          "mwh",
          "vac"
        ],
        "note": "The mutating admission controller calls the mutating webhook to modify the resource, then hands it to validation."
      },
      {
        "id": "validating",
        "label": "Validating admission · store",
        "focus": [
          "vac",
          "vwh",
          "api",
          "stor"
        ],
        "note": "The validating admission controller only validates via its webhook; the validated request is processed by the API and stored in etcd."
      }
    ],
