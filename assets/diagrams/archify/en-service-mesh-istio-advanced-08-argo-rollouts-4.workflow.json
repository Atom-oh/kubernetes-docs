    {
      "id": "pause10",
      "label": "pause: 10m",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "done",
      "label": "Complete",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "w0",
    "w10",
    "w30",
    "w50",
    "w80",
    "w100"
