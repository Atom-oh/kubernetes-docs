{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Basic Canary Traffic Transition Graph",
    "locale": "en",
    "output": "public/archmaps/en-service-mesh-istio-advanced-08-argo-rollouts-4.html",
