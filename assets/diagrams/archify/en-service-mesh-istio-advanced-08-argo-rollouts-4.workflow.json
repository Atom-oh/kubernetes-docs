        "frontend": {
          "label": "Canary start"
        },
        "backend": {
          "label": "setWeight step"
        },
        "cloud": {
          "label": "100% auto transition"
        }
      }
    },
    "views": [
      {
        "id": "short-pause",
        "label": "5-minute wait steps",
        "focus": [
          "w0",
          "w10",
          "w30"
        ],
        "note": "The 10% and 30% steps each pause for 5 minutes before the next weight increase."
      },
      {
        "id": "long-pause",
        "label": "10-minute wait steps",
        "focus": [
          "w50",
          "w80",
          "w100"
        ],
        "note": "The 50% and 80% steps pause for 10 minutes; after the last step traffic shifts to 100% automatically."
      }
    ]
  },
