{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Recursive DNS Resolution — Root to Authoritative",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1000,
      620
    ],
    "animation": "trace"
  },
  "participants": [
    {
      "id": "client",
