      "label": "Client",
      "sublabel": "stub resolver"
    },
    {
      "id": "resolver",
      "type": "backend",
      "label": "Recursive Resolver",
      "sublabel": "ISP / org"
    },
    {
      "id": "root",
      "type": "database",
      "label": "Root NS",
      "sublabel": "."
    },
    {
      "id": "tld",
      "type": "database",
      "label": "TLD NS",
      "sublabel": ".com"
    },
    {
      "id": "auth",
      "type": "database",
      "label": "Authoritative NS",
      "sublabel": "example.com"
    }
  ],
  "messages": [
    {
      "id": "q0",
      "from": "client",
      "to": "resolver",
      "y": 180,
      "label": "example.com A?",
      "variant": "emphasis"
    },
    {
      "id": "q1",
      "from": "resolver",
      "to": "root",
      "y": 225,
      "label": "A? (cache miss)"
    },
    {
      "id": "r1",
      "from": "root",
      "to": "resolver",
      "y": 265,
      "label": "delegate to .com TLD",
      "variant": "return"
    },
    {
      "id": "q2",
      "from": "resolver",
      "to": "tld",
      "y": 310,
      "label": "A?"
    },
    {
      "id": "r2",
      "from": "tld",
      "to": "resolver",
      "y": 350,
      "label": "delegate to authoritative",
      "variant": "return"
    },
    {
      "id": "q3",
      "from": "resolver",
      "to": "auth",
      "y": 395,
      "label": "A?"
    },
    {
      "id": "r3",
      "from": "auth",
      "to": "resolver",
      "y": 435,
      "label": "93.184.216.34 · TTL 300",
      "variant": "return"
    },
    {
      "id": "ans",
      "from": "resolver",
      "to": "client",
      "y": 490,
      "label": "answer + cached",
      "variant": "emphasis",
      "note": "For the TTL, the resolver cache answers instantly — no trip back to the root"
    }
  ],
  "activations": [
