  "cards": [
    {
      "dot": "cyan",
      "title": "Pod CIDR per node",
      "items": [
        "Each hybrid node receives a slice of the Remote Pod CIDR",
        "Node 10.80.0.2 uses 10.85.1.0/24 and node 10.80.0.3 uses 10.85.2.0/24",
        "The CNI on the node allocates pod IPs from that range (10.85.1.10, 10.85.1.11, and so on)"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the router must know",
      "items": [
        "The on-prem router has to know which pod CIDR sits on which node",
        "Three mechanisms convey that: static routes, BGP, and ARP proxy",
        "Without it, traffic addressed to a pod IP never arrives"
      ]
    },
    {
      "dot": "amber",
      "title": "Toward AWS",
      "items": [
        "The gateway owns the route toward the VPC range (10.0.0.0/16)",
        "In the other direction, the VPC route table needs routes for the remote node and pod ranges",
        "Pod-to-VPC traffic works only when both directions are routed"
      ]
    }
  ]
