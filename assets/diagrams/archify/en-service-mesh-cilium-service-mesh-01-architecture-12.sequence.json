        "focus": [
          "client",
          "ebpf-client",
          "envoy",
          "ebpf-server",
          "server"
        ],
        "note": "Only requests matching an L7 policy are redirected by eBPF to the node Envoy before reaching the server Pod."
      },
      {
        "id": "response-path",
        "label": "Response path",
        "focus": [
          "server",
          "ebpf-server",
          "envoy",
          "ebpf-client",
          "client"
        ],
        "note": "The response takes the same detour through Envoy, updating metrics before reaching the client Pod."
      }
    ],
    "legend": {
      "mode": "all",
      "entries": {
        "default": {
          "label": "Internal proxy hop"
        },
        "emphasis": {
