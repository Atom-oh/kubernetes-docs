  "cards": [
    {
      "dot": "cyan",
      "title": "Write path",
      "items": [
        "Distributor: receives trace data, validates and hashes it (scales horizontally)",
        "Ingester: buffers in memory, builds blocks and writes them to S3 (scales horizontally with replication)"
      ]
    },
    {
      "dot": "violet",
      "title": "Read path",
      "items": [
        "Query Frontend: query splitting, caching, queue management (scales horizontally)",
        "Querier: searches traces in storage and cache (scales horizontally)"
      ]
    },
    {
      "dot": "amber",
      "title": "Background components",
      "items": [
        "Metrics Generator: generates RED metrics from traces (scales horizontally)",
        "Compactor: block compaction, retention policy enforcement (single instance)"
      ]
    }
  ]
