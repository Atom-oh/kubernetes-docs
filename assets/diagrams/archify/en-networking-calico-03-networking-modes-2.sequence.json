      {
        "id": "encap",
        "label": "Node 1: encapsulate",
        "focus": [
          "podA",
          "felix1",
          "tunl1"
        ],
        "note": "Felix finds the tunl0 route in the routing table and tunl0 wraps the packet in an outer IP header."
      },
      {
        "id": "transit",
        "label": "Network transit",
        "focus": [
          "tunl1",
          "net",
          "tunl2"
        ],
        "note": "The IP Protocol 4 packet crosses the physical network between node IPs (10.0.1.10 to 10.0.1.11)."
      },
      {
        "id": "decap",
        "label": "Node 2: decapsulate",
        "focus": [
          "tunl2",
          "felix2",
          "podB"
        ],
        "note": "tunl0 strips the outer header, Felix runs the policy check, and the inner packet reaches Pod B."
      }
    ]
  },
