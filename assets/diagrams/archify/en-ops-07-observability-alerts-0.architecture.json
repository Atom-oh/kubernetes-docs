  "cards": [
    {
      "dot": "cyan",
      "title": "From rule to notification",
      "items": [
        "A PrometheusRule CRD declares the condition, the for duration, and its labels and annotations",
        "Prometheus picks up its own rules through a label selector such as release, then evaluates them on an interval",
        "Once the condition holds for the whole for duration, the alert turns Firing and goes to Alertmanager"
      ]
    },
    {
      "dot": "emerald",
      "title": "What Alertmanager does",
      "items": [
        "It groups alerts with a shared cause so notifications do not flood",
        "It inhibits downstream alerts while an upstream failure is active",
        "It routes to receivers based on the severity label"
      ]
    },
    {
      "dot": "amber",
      "title": "Response by severity",
      "items": [
        "critical — outage or data-loss risk, within 5 minutes, PagerDuty and phone",
        "warning — degradation or a latent problem, within business hours, Slack and email",
        "info — informational, weekly review, email and dashboards"
      ]
    }
  ]
