{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "How DSR Works — Normal Mode vs DSR Mode",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1000,
      640
    ],
    "animation": "trace",
    "legend": {
      "entries": {
        "emphasis": {
          "label": "Direct reply (skips LB)"
        }
      }
    },
    "views": [
      {
        "id": "non-dsr",
        "label": "Normal mode (Non-DSR)",
        "focus": [
          "client",
          "lb",
          "pod"
        ],
        "note": "The response returns to the LB node, is SNAT'd, then reaches the client — the LB node handles traffic in both directions."
      },
      {
        "id": "dsr",
        "label": "DSR mode",
        "focus": [
          "client",
          "lb",
          "pod"
        ],
        "note": "The backend Pod replies straight to the client with the VIP as source IP — the LB node handles requests only."
      }
    ]
  },
