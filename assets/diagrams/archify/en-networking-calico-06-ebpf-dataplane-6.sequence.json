      "label": "Node 1",
      "sublabel": "LB node (VIP:80)"
    },
    {
      "id": "pod",
      "type": "backend",
      "label": "Node 2",
      "sublabel": "Backend Pod (:8080)"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 355,
