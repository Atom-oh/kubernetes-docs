  "cards": [
    {
      "dot": "cyan",
      "title": "테스트와 검증",
      "items": [
        "kyverno test ./policy.yaml --resource=./resource.yaml 로 정책을 시뮬레이션",
        "kubectl kyverno apply ./policy.yaml --cluster 로 클러스터 대상 검증",
        "검증 실패 시 정책을 수정하고 다시 테스트"
      ]
    },
    {
      "dot": "amber",
      "title": "Audit 모드 먼저",
      "items": [
        "Audit 모드는 위반을 기록만 하고 차단하지 않음",
        "ClusterPolicyReport / PolicyReport 로 위반 사항 확인",
        "영향 평가 후 준비가 끝나면 Enforce 모드로 전환"
      ]
    },
    {
      "dot": "emerald",
      "title": "운영과 정기 검토",
      "items": [
        "Kyverno Prometheus 메트릭으로 정책 위반 모니터링",
        "정기 검토에서 업데이트가 필요하면 정책 작성으로 복귀",
        "업데이트가 필요 없으면 메트릭 모니터링을 계속"
      ]
    }
  ]
