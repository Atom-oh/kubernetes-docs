        "id": "scale-to-zero",
        "label": "Scale-to-Zero",
        "focus": [
          "as",
          "pod",
          "gw"
        ],
        "note": "With zero requests over the stable window, the pod is terminated and the Gateway destination switches to the Activator."
      },
      {
        "id": "cold-start",
        "label": "Cold start",
        "focus": [
          "client",
          "gw",
          "act",
          "as",
          "pod"
        ],
        "note": "The Activator buffers the request, asks for a scale-up, and forwards it once the pod is Ready."
      },
      {
        "id": "direct-path",
        "label": "Later requests",
        "focus": [
          "client",
          "gw",
          "pod"
        ],
        "note": "While the pod is running, the Gateway bypasses the Activator and routes directly to the pod."
      }
    ]
  },
