    {
      "dot": "cyan",
      "title": "State와 권한",
      "items": [
        "root마다 다른 key와 use_lockfile=true를 사용",
        "TF_DATA_DIR만 바꿔서는 S3 state가 분리되지 않음",
        "remote state 권한은 전체 snapshot 접근 권한이기도 함"
      ]
    },
    {
      "dot": "emerald",
      "title": "출력 계약",
      "items": [
