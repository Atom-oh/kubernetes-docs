{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Node and Workload Attestation Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "node-attestation",
        "label": "Node Attestation",
        "focus": [
          "agent_start",
          "psat",
          "aws_iid",
          "validate",
          "node_svid"
        ],
        "note": "The SPIRE Agent submits a k8s_psat token or an aws_iid document to the Server and receives a Node SVID once validation passes."
      },
      {
        "id": "workload-attestation",
        "label": "Workload Attestation",
        "focus": [
          "node_svid",
          "wl_call",
          "collect",
          "pod_meta",
          "unix",
          "match",
          "wl_svid"
        ],
        "note": "With its Node SVID, the Agent checks the caller's Pod metadata and UID/GID, matches registration entries, and issues a Workload SVID."
      }
    ],
    "legend": {
      "entries": {
        "backend": {
          "label": "SPIRE processing step"
        },
        "cloud": {
          "label": "Attestation evidence"
        },
        "security": {
          "label": "SVID issuance"
        },
        "frontend": {
          "label": "Workload"
        }
      }
    }
  },
