  "cards": [
    { "dot": "cyan", "title": "볼륨 타입", "items": [
      "gp3는 기본 3,000 IOPS와 125 MiB/s를 제공하고 크기와 무관하게 조정 가능하다",
      "io1·io2는 최대 수십만 IOPS가 필요한 트랜잭션 워크로드용이다",
      "st1·sc1은 순차 처리량 위주의 저비용 HDD 옵션이다"
    ]},
    { "dot": "emerald", "title": "스토리지 클래스 구성", "items": [
      "provisioner: ebs.csi.aws.com, type: gp3, encrypted: \"true\"를 기본으로 둔다",
      "volumeBindingMode: WaitForFirstConsumer로 파드가 뜨는 AZ에 볼륨을 만든다",
      "allowVolumeExpansion: true를 켜두면 나중에 온라인 확장이 가능하다"
    ]},
    { "dot": "amber", "title": "모범 사례", "items": [
      "EBS 볼륨은 단일 AZ 자원이므로 파드가 다른 AZ로 옮겨가면 마운트할 수 없다",
      "드라이버는 IRSA 또는 Pod Identity로 최소 권한 IAM 역할을 부여한다",
      "스냅샷으로 백업하고 CSI VolumeSnapshot으로 복구 절차를 검증한다"
    ]}
  ]
