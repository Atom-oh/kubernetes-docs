    "views": [
      {
        "id": "submit",
        "label": "Driver pod creation",
        "focus": [
          "submit",
          "apiserver",
          "driver"
        ],
        "note": "spark-submit asks the API Server to create a single driver pod. There is no persistent cluster-manager daemon."
      },
      {
        "id": "executors",
        "label": "Executor pod request and scheduling",
        "focus": [
          "driver",
          "apiserver",
          "exec1",
          "exec2",
          "exec3"
        ],
        "note": "The driver calls the Kubernetes API itself to create executor pods, based on spark.executor.instances or DRA."
      },
      {
        "id": "report",
        "label": "Registration and status reporting",
        "focus": [
          "exec1",
          "exec2",
          "exec3",
          "driver"
        ],
        "note": "Executors connect directly to the driver to register and report results and status. Kubernetes stays out of task coordination."
      }
    ],
    "locale": "en"
  },
