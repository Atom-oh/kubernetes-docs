{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Alert Processing Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      690
    ],
    "animation": "trace",
    "views": [
      {
        "id": "routing",
        "label": "Receive and route",
        "focus": [
          "src",
          "oncall",
          "route",
          "esc"
        ],
        "note": "Related alerts are grouped, then routing rules pick an escalation chain."
      },
      {
        "id": "first-notify",
        "label": "First notification",
        "focus": [
          "esc",
          "sched",
          "notif"
        ],
        "note": "The current on-call responder is looked up in the schedule and notified."
      },
      {
        "id": "escalate",
        "label": "No-response escalation",
        "focus": [
          "esc",
          "sched",
          "notif"
        ],
        "note": "After a configured wait, evaluate the next policy step; it is not necessarily a different person."
      },
      {
        "id": "ack",
        "label": "Ack · local state",
        "focus": [
          "notif",
          "oncall"
        ],
        "note": "Acknowledgment changes OnCall state; it does not push a rule-state update to the source."
      }
    ],
    "output": "en-observability-alerting-03-grafana-oncall-1.html"
  },
  "participants": [
