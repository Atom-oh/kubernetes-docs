  "cards": [
    {
      "dot": "cyan",
      "title": "Addressing + Encryption",
      "items": [
        "IPAM hands out /26 blocks (64 IPs) per node to cut datastore round-trips",
        "WireGuard costs roughly 5-10% throughput vs 15-25% for IPsec",
        "Key rotation is automatic with WireGuard, manual or IKE with IPsec"
      ]
    },
    {
      "dot": "amber",
      "title": "Egress + Federation",
      "items": [
        "Egress Gateway presents fixed source IPs for firewall allowlists and PCI-DSS/HIPAA needs",
        "Federation connects each cluster's Typha to one shared Federation Controller",
        "Cross-cluster network policy rides on the same federated state"
      ]
    },
    {
      "dot": "slate",
      "title": "Platform + Scale",
      "items": [
        "Windows nodes support VXLAN, BGP and L3-L4 policy but not eBPF, WireGuard or L7",
        "Typha replicas = max(3, ceil(nodes / 200)), so 1000 nodes need 5",
        "Route reflectors, Felix tuning and datastore sizing complete the large-cluster design"
      ]
    }
  ]
