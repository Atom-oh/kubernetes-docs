    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "Network owns VPC, subnets, routes, and endpoints",
        "Cluster owns EKS and administrator access",
        "Platform owns optional mixed-node DNS, ESO identity, and team access"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dependency impact",
      "items": [
        "Separate state limits the configuration scope of each plan",
        "VPC, DNS, and IAM failures can still affect dependent layers",
        "Frequency and apply duration depend on the environment"
      ]
    },
    {
      "dot": "amber",
      "title": "State controls",
      "items": [
        "Choose distinct backend bucket/key values and matching initialization directories",
        "Native S3 locking needs use_lockfile=true and lock-object permissions",
        "State version recovery does not roll back AWS resources"
      ]
    }
