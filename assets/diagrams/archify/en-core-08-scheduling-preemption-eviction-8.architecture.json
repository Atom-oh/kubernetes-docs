    {
      "dot": "violet",
      "title": "Optional fields",
      "items": [
        "minDomains: minimum number of topology domains",
        "matchLabelKeys: pod label keys to match for spread calculation",
        "nodeAffinityPolicy / nodeTaintsPolicy: whether node affinity and taints are considered (Honor / Ignore)"
      ]
    },
    {
      "dot": "amber",
      "title": "whenUnsatisfiable",
      "items": [
        "DoNotSchedule: hard constraint - the pod is not scheduled if the constraint cannot be satisfied",
        "ScheduleAnyway: soft constraint - the pod is still scheduled, preferring nodes that minimize skew"
      ]
    },
    {
      "dot": "cyan",
      "title": "Availability zone spread example",
      "items": [
        "A new pod is scheduled while ap-northeast-2a holds 3 pods, 2b holds 2, and 2c holds 3",
        "With maxSkew=1 it is placed in 2b so no two domains differ by more than 1 (2 → 3 pods)"
      ]
    }
