  "cards": [
    {
      "dot": "cyan",
      "title": "EKS access entries (recommended)",
      "items": [
        "aws eks create-access-entry registers an IAM principal with the cluster",
        "aws eks associate-access-policy attaches a policy such as AmazonEKSClusterAdminPolicy",
        "Access entries are managed through the AWS API, so they fit audit logs and IaC naturally"
      ]
    },
    {
      "dot": "emerald",
      "title": "aws-auth ConfigMap (legacy)",
      "items": [
        "You edit mapRoles and mapUsers by hand in the aws-auth ConfigMap in kube-system",
        "ConfigMap size limits and hand-editing mistakes make it a poor choice for new clusters",
        "authenticationMode: API_AND_CONFIG_MAP lets both mechanisms coexist"
      ]
    },
    {
      "dot": "amber",
      "title": "Narrowing scope with RBAC",
      "items": [
        "Namespace-scoped Roles and RoleBindings split permissions per team",
        "Reach for ClusterRole and ClusterRoleBinding only when cluster-wide access is required",
        "kubectl auth can-i --as <principal> shows the effective permissions"
      ]
    }
  ]
