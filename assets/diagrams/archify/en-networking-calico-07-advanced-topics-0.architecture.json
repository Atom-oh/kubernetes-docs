  "cards": [
    {
      "dot": "cyan",
      "title": "IP Block Affinity behavior",
      "items": [
        "Block allocation: when a pod is scheduled, its IP comes from a block affine to that node",
        "Block expansion: when the existing block is exhausted, a new block is assigned to the node",
        "Block release: when all pods on the node are deleted, the block affinity is released"
      ]
    },
    {
      "dot": "amber",
      "title": "Choosing blockSize",
      "items": [
        "/26 = 64 IPs (default)",
        "/28 = 16 IPs (many nodes)",
        "/24 = 256 IPs (high pod density)"
      ]
    }
  ]
