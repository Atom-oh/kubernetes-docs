        "label": "1. Token issuance",
        "focus": [
          "pod",
          "k8s"
        ],
        "note": "The Kubernetes API server issues the service account JWT and the pod reads it from a projected volume."
      },
      {
        "id": "token-verify",
        "label": "2. Role assumption and validation",
        "focus": [
          "pod",
          "sts",
          "oidc",
          "iam"
        ],
        "note": "STS verifies the signature with the OIDC provider's JWKS and checks the OIDC condition in the IAM role trust policy."
      },
      {
        "id": "use-creds",
        "label": "3. Use temporary credentials",
        "focus": [
          "sts",
          "pod",
          "aws"
        ],
        "note": "The pod calls the AWS API with the temporary credentials (Access Key, Secret Key, Session Token)."
      }
    ]
  },
