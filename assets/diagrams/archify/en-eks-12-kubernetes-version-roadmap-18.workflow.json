  "cards": [
    {
      "dot": "cyan",
      "title": "Pre-upgrade",
      "items": [
        "Assessment: review the changelog, add-on compatibility and third-party tooling",
        "Staging Test: full upgrade rehearsal, retried until it passes",
        "Preparation: maintenance window, rollback plan and IaC changes"
      ]
    },
    {
      "dot": "rose",
      "title": "Execution and the hard gate",
      "items": [
        "Order: control plane, then add-ons, then nodes",
        "API server health is the single hard gate during execution",
        "If the API server is not healthy, contact AWS Support"
      ]
    },
    {
      "dot": "emerald",
      "title": "Validation",
      "items": [
        "Check workloads, network and storage after the upgrade",
