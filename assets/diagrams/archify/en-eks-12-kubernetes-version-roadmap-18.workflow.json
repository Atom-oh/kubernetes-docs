    "views": [
      {
        "id": "pre-upgrade",
        "label": "Pre-upgrade phases",
        "focus": [
          "begin",
          "assessment",
          "staging",
          "preparation"
        ],
        "note": "Assess changelog, add-ons and third-party tools, rehearse the full upgrade in staging (retry on fail), then fix window, rollback and IaC."
      },
      {
        "id": "execution-gate",
        "label": "Execution and health gate",
        "focus": [
          "preparation",
          "execution",
          "gate",
          "support"
        ],
        "note": "Upgrade control plane, then add-ons, then nodes. API server health is the one hard gate; if unhealthy, contact AWS Support."
      },
      {
        "id": "validation",
        "label": "Validation and completion",
        "focus": [
          "gate",
          "validation",
          "complete"
        ],
        "note": "With a healthy API server, validate workloads, network and storage (fix and retry on failure) before declaring the upgrade complete."
      }
    ]
  },
