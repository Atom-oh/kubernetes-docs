  "cards": [
    {
      "dot": "amber",
      "title": "Broker/Trigger pattern",
      "items": [
        "Broker: an event hub that receives events and routes them to consumers according to registered Triggers",
        "Trigger: filters events by CloudEvents attributes (type, source, ...) and routes matches to a specific service",
        "Dead Letter Sink: fallback destination for events that cannot be delivered after exhausting retries"
      ]
    },
    {
      "dot": "cyan",
      "title": "Channel/Subscription pattern",
      "items": [
        "Channel: a messaging channel that stores and forwards events (InMemoryChannel, KafkaChannel, ...)",
        "Subscription: subscribes a specific service to the Channel and delivers every event to it (no filtering)"
      ]
    }
  ]
