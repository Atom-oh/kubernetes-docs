  "cards": [
    {
      "dot": "amber",
      "title": "Understanding QoS Classes",
      "items": [
        "Guaranteed: request = limit (highest priority)",
        "Burstable: request < limit",
        "BestEffort: no request and limit (lowest priority)",
        "Under resource pressure, BestEffort pods are evicted first, then Burstable"
      ]
    }
