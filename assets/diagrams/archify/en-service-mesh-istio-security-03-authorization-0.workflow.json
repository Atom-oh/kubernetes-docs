{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AuthorizationPolicy Condition Evaluation Flow",
    "locale": "en",
    "output": "public/archmaps/en-service-mesh-istio-security-03-authorization-0.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "Request source"
        },
        "backend": {
          "label": "Target service"
        },
        "security": {
          "label": "Policy decision"
        }
      }
    },
    "views": [
      {
        "id": "allow-path",
        "label": "Allow path",
        "focus": [
          "request",
          "saCheck",
          "nsCheck",
          "methodCheck",
          "allow"
        ],
        "note": "A request is allowed only when the Source (Service Account, Namespace) and Operation (HTTP Method) conditions all match."
      },
      {
        "id": "deny-path",
        "label": "Deny path",
        "focus": [
          "saCheck",
          "nsCheck",
          "methodCheck",
          "deny"
        ],
        "note": "If any condition fails to match, the remaining checks are skipped and the request is denied immediately."
      }
    ]
  },
  "lanes": [
    {
      "id": "evaluation",
      "label": "Request Evaluation"
    },
    {
      "id": "rejected",
      "label": "Deny",
      "variant": "exception"
    }
  ],
  "groups": [
    {
      "id": "authzPolicy",
      "label": "Authorization Policy",
      "lane": "evaluation",
      "fromCol": 1,
      "toCol": 3,
      "variant": "security"
    }
  ],
  "mainPath": [
    "request",
    "saCheck",
    "nsCheck",
    "methodCheck",
    "allow"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "request"
    ],
    "allowedTerminals": [
      "allow",
      "deny"
    ],
    "requiredPaths": [
      {
        "from": "request",
        "to": "allow"
      },
      {
        "from": "request",
        "to": "deny"
      }
    ]
  },
  "nodes": [
    {
      "id": "request",
      "lane": "evaluation",
      "col": 0,
      "type": "frontend",
      "label": "Request",
      "sublabel": "inbound request",
      "width": 150
    },
    {
      "id": "saCheck",
      "lane": "evaluation",
      "col": 1,
      "type": "security",
      "label": "Service Account Check",
      "tag": "CHECK 1",
      "width": 200
    },
    {
      "id": "nsCheck",
      "lane": "evaluation",
      "col": 2,
      "type": "security",
      "label": "Namespace Check",
      "tag": "CHECK 2",
      "width": 180
    },
    {
      "id": "methodCheck",
      "lane": "evaluation",
      "col": 3,
      "type": "security",
      "label": "HTTP Method Check",
      "tag": "CHECK 3",
      "width": 200
    },
    {
      "id": "allow",
      "lane": "evaluation",
      "col": 4,
      "type": "backend",
      "label": "Allow",
      "sublabel": "sent to service",
      "width": 150
    },
    {
      "id": "deny",
      "lane": "rejected",
      "col": 2,
      "type": "security",
      "label": "Deny",
      "sublabel": "blocked immediately",
      "width": 160
    }
  ],
  "edges": [
    {
      "from": "request",
      "to": "saCheck",
      "role": "main"
    },
    {
      "from": "saCheck",
      "to": "nsCheck",
      "label": "Match",
      "variant": "emphasis",
      "role": "main",
      "route": "straight"
    },
    {
      "from": "nsCheck",
      "to": "methodCheck",
      "label": "Match",
      "variant": "emphasis",
      "role": "main",
      "route": "straight"
    },
    {
      "from": "methodCheck",
      "to": "allow",
      "label": "Match",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "saCheck",
      "to": "deny",
      "label": "No Match",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "nsCheck",
      "to": "deny",
      "label": "No Match",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "methodCheck",
      "to": "deny",
      "label": "No Match",
      "variant": "security",
      "role": "error"
    }
  ]
}
