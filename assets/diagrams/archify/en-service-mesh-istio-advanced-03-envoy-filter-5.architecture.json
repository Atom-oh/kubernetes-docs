      "dot": "cyan",
      "title": "Gateway's role (common to all apps)",
      "items": [
        "Extract the original client IP from the XFF header",
        "Exclude the trusted hop (ALB) with xff_num_trusted_hops",
        "Performs no access control; only identifies the IP accurately"
      ]
    },
    {
      "dot": "rose",
      "title": "AuthorizationPolicy's role (selective)",
      "items": [
        "Access control based on the original IP extracted by the Gateway",
