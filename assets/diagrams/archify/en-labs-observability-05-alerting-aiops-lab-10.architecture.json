    "views": [
      {
        "id": "detect-route",
        "label": "1. Detect and route",
        "focus": [
          "alertmanager",
          "cloudwatch",
          "oncall",
          "sns",
          "apigw"
        ],
        "note": "PrometheusRules and CloudWatch Alarms detect anomalies; alerts route to Grafana OnCall, the SNS Topic, and the API Gateway webhook."
      },
      {
        "id": "investigate",
        "label": "2. Investigate",
        "focus": [
          "sns",
          "apigw",
          "lambda",
          "context"
        ],
        "note": "The SNS subscription and API Gateway webhook invoke the Lambda AIOps Agent, which normalizes the alert into an incident context."
      },
      {
        "id": "evidence",
        "label": "3. Collect evidence",
        "focus": [
          "lambda",
          "logs",
          "metrics",
          "traces"
        ],
        "note": "The agent queries logs, metrics, and traces in parallel to gather the telemetry evidence the analysis needs."
      },
      {
        "id": "analyze",
        "label": "4. Analyze and respond",
        "focus": [
          "context",
          "bedrock",
          "responders"
        ],
        "note": "The incident context is sent to Amazon Bedrock for root-cause analysis, and the result is published through SNS to responders."
      }
    ]
  },
