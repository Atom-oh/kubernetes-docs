{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Kong Mesh Service Connection and Traffic Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "column_fit": "spread",
    "viewBox": [
      1060,
      720
    ],
    "views": [
      {
        "id": "setup",
        "label": "Initial setup",
        "focus": [
          "gcp",
          "zcp1",
          "zcp2",
          "dp1",
          "dp2"
        ],
        "note": "The Global CP syncs policy to both Zone CPs, and each Zone CP configures its Kuma DP over xDS."
      },
      {
        "id": "traffic",
        "label": "Service-to-service traffic",
        "focus": [
          "app",
          "dp1",
          "dp2",
          "target"
        ],
        "note": "The local DP resolves the Zone 2 endpoint via service discovery, mTLS-encrypts the plaintext request, and relays it via DP 2 to the target."
      },
      {
        "id": "metrics",
        "label": "Metrics and tracing",
        "focus": [
          "dp1",
          "dp2",
          "zcp1",
          "zcp2",
          "gcp"
        ],
        "note": "Each DP's metrics flow to its Zone CP and are aggregated mesh-wide at the Global CP."
      }
    ]
  },
