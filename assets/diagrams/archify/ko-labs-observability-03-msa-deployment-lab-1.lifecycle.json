{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "카나리 확인·분석·승격 또는 중단",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1080,
      650
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Rollout progression"
    },
    {
      "id": "recovery",
      "label": "Abort and explicit recovery"
    },
    {
      "id": "terminal",
      "label": "Explicit desired-state recovery"
    }
  ],
  "states": [
    {
      "id": "weight",
      "type": "start",
      "label": "SetWeight20",
      "sublabel": "replica 기반 근사",
      "lane": "main",
      "col": 0
    },
    {
      "id": "pause",
      "type": "waiting",
      "label": "Manual pause",
      "sublabel": "트래픽·설정 확인",
      "lane": "main",
      "col": 1
    },
    {
      "id": "gate",
      "type": "decision",
      "label": "Canary analysis",
      "sublabel": "requests ≥5 / success ≥99%",
      "lane": "main",
      "col": 2
    },
    {
      "id": "promote",
      "type": "success",
      "label": "SetWeight100",
      "sublabel": "조건 통과 후 승격",
      "lane": "main",
      "col": 4
    },
    {
      "id": "abort",
      "type": "failure",
      "label": "Abort",
      "sublabel": "무데이터·실패 구분",
      "lane": "recovery",
      "col": 0
    },
    {
      "id": "restore",
      "type": "active",
      "label": "Restore state",
      "sublabel": "explicit Git / image",
      "lane": "terminal",
      "col": 0
    }
  ],
  "transitions": [
    {
      "from": "weight",
      "to": "pause"
    },
    {
      "from": "pause",
      "to": "gate"
    },
    {
      "from": "gate",
      "to": "promote",
      "variant": "emphasis"
    },
    {
      "from": "gate",
      "to": "abort",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "abort",
      "to": "restore",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "분석 조건",
      "items": [
        "revision = latest pod-template hash",
        "3measurements /20s interval / failureLimit1",
        "empty/NaN/Inf는 성공이 아님",
        "abort는 Git revert가 아님"
      ]
    }
  ]
}
