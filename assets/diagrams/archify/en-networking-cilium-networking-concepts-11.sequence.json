{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Kubernetes DNS Service Discovery Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      860,
      520
    ],
    "animation": "trace"
  },
  "participants": [
    {
      "id": "pod-a",
      "type": "frontend",
      "label": "Pod A",
      "sublabel": "client"
    },
    {
      "id": "coredns",
      "type": "backend",
      "label": "CoreDNS",
      "sublabel": "cluster DNS"
    },
    {
      "id": "service-b",
      "type": "cloud",
      "label": "Service B",
      "sublabel": "ClusterIP: 10.0.0.1"
    }
  ],
  "messages": [
    {
      "id": "query",
      "from": "pod-a",
      "to": "coredns",
      "y": 205,
      "label": "1. Query service-b",
      "variant": "emphasis",
      "note": "service-b.<namespace>.svc.cluster.local"
    },
    {
      "id": "resolve",
      "from": "coredns",
      "to": "service-b",
      "y": 265,
      "label": "2. Resolve service-b"
    },
    {
      "id": "select",
      "from": "service-b",
      "to": "coredns",
      "y": 325,
      "label": "3. Select backend pod",
      "variant": "return",
      "note": "backends: Pod B1, B2, B3"
    },
    {
      "id": "answer",
      "from": "coredns",
      "to": "pod-a",
      "y": 395,
      "label": "4. Receive 10.0.0.1",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "coredns",
      "from": 200,
      "to": 400,
      "type": "backend"
    },
    {
      "participant": "service-b",
      "from": 260,
      "to": 330,
      "type": "cloud"
    }
  ]
}