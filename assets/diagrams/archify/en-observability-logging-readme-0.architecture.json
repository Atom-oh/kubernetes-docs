  "cards": [
    {
      "dot": "cyan",
      "title": "Collection Layer",
      "items": [
        "DaemonSet: one per node, resource efficient, centrally managed",
        "Sidecar: per-application isolation and custom processing",
        "OTEL Collector: unified OpenTelemetry-based collection"
      ]
    },
    {
      "dot": "orange",
      "title": "Processing Layer",
      "items": [
        "Merge Kubernetes metadata and parse records (Parse)",
        "Add fields such as cluster_name and environment (Enrich)",
        "Drop noise like HealthCheck (Filter), then buffer (Buffer)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage and Analysis Layers",
      "items": [
        "Loki and ClickHouse store on S3 at low cost and are queried from Grafana",
        "OpenSearch excels at full-text search and is queried from OpenSearch Dashboards",
        "CloudWatch Logs is queried with Logs Insights in the CloudWatch console"
      ]
    }
  ]
