    {
      "dot": "cyan",
      "title": "Selection by traffic pattern",
      "items": [
        "Uniform small requests (< 10ms) → ROUND_ROBIN",
        "Variable requests (10ms ~ 1s+) → LEAST_REQUEST",
        "Very high traffic (10,000+ RPS) → RANDOM",
        "Session-based (user state) → consistentHash.httpCookie",
        "Multi-region → LEAST_REQUEST + localityLbSetting"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recommended by service type",
      "items": [
        "REST / GraphQL / gRPC API → LEAST_REQUEST",
        "Web frontend → CONSISTENT_HASH (cookie)",
        "WebSocket, cache service → CONSISTENT_HASH (header)",
        "Analytics / log collection → RANDOM",
        "Static content → ROUND_ROBIN"
      ]
    }
