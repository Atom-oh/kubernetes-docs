  "cards": [
    {
      "dot": "cyan",
      "title": "수집 계층",
      "items": [
        "DaemonSet: 노드당 하나, 리소스 효율적이며 중앙 관리",
        "Sidecar: 애플리케이션별 격리와 커스텀 처리",
        "OTEL Collector: OpenTelemetry 기반 통합 수집"
      ]
    },
    {
      "dot": "orange",
      "title": "처리 계층",
      "items": [
        "Kubernetes 메타데이터 병합과 파싱(Parse)",
        "cluster_name·environment 같은 필드 추가(Enrich)",
        "HealthCheck 등 노이즈 제외(Filter) 후 버퍼링(Buffer)"
      ]
    },
    {
      "dot": "emerald",
      "title": "저장·분석 계층",
      "items": [
        "Loki·ClickHouse는 S3 기반으로 저장 비용이 낮고 Grafana로 조회",
        "OpenSearch는 전문 검색에 강하며 OpenSearch Dashboards로 조회",
        "CloudWatch Logs는 CloudWatch 콘솔의 Logs Insights로 조회"
      ]
    }
  ]
