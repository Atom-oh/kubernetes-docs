{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Rule State and Incident Response",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "detection",
        "label": "Detection",
        "focus": [
          "inactive",
          "pending",
          "firing"
        ],
        "note": "This example has for: 5m. Without for, a matching rule can fire on its first evaluation."
      },
      {
        "id": "notification",
        "label": "Notification",
        "focus": [
          "firing",
          "notified",
          "acknowledged"
        ],
        "note": "Notification and acknowledgment are integration/incident states, not Prometheus rule states."
      },
      {
        "id": "resolution",
        "label": "Resolution",
        "focus": [
          "acknowledged",
          "in_progress",
          "resolved",
          "inactive"
        ],
        "note": "Closing an incident does not clear a firing rule. Missing series can clear a rule without recovery."
      }
    ],
    "legend": {
      "entries": {
        "start": {
          "label": "inactive"
        },
        "waiting": {
          "label": "waiting"
        },
        "failure": {
          "label": "firing"
        },
        "active": {
          "label": "handled"
        },
        "success": {
          "label": "resolved"
        }
      }
    },
    "output": "en-observability-alerting-readme-1.html"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Detection + notification"
    },
    {
      "id": "respond",
      "label": "Responder action"
    },
    {
      "id": "terminal",
      "label": "Outcome"
    }
  ],
  "states": [
    {
      "id": "inactive",
      "type": "start",
      "label": "Inactive",
      "sublabel": "condition not met",
      "lane": "main",
      "col": 0
    },
    {
      "id": "pending",
      "type": "waiting",
      "label": "Pending",
      "sublabel": "held for the for: duration",
      "lane": "main",
      "col": 1,
      "tag": "for: 5m"
    },
    {
      "id": "firing",
      "type": "failure",
      "label": "Firing",
      "sublabel": "rule condition active",
      "lane": "main",
      "col": 2
    },
    {
      "id": "notified",
      "type": "waiting",
      "label": "Notified",
      "sublabel": "Slack, Email, PagerDuty",
      "lane": "main",
      "col": 3
    },
    {
      "id": "acknowledged",
      "type": "active",
      "label": "Acknowledged",
      "sublabel": "responder confirmed",
      "lane": "main",
      "col": 4
    },
    {
      "id": "in_progress",
      "type": "active",
      "label": "In Progress",
      "sublabel": "responder fixing the problem",
      "lane": "respond",
      "col": 2
    },
    {
      "id": "resolved",
      "type": "success",
      "label": "Incident Closed",
      "sublabel": "verify rule + signal health",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    {
      "from": "inactive",
      "to": "pending",
      "label": "Threshold exceeded",
      "route": "straight",
      "labelDy": -25
    },
    {
      "from": "pending",
      "to": "firing",
      "label": "Wait elapsed",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": -25
    },
    {
      "from": "firing",
      "to": "notified",
      "label": "Alert sent",
      "route": "straight",
      "labelDy": -25
    },
    {
      "from": "notified",
      "to": "acknowledged",
      "label": "Responder confirmed",
      "route": "straight",
      "labelDy": -25
    },
    {
      "from": "acknowledged",
      "to": "in_progress",
      "label": "Action in progress",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "in_progress",
      "to": "resolved",
      "label": "Problem solved",
      "variant": "emphasis",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "pending",
      "to": "inactive",
      "label": "Returns within threshold",
      "variant": "dashed",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "from": "firing",
      "to": "inactive",
      "label": "No active series",
      "variant": "dashed",
      "fromSide": "top",
      "toSide": "left",
      "via": [
        [
          402,
          78
        ],
        [
          20,
          78
        ],
        [
          20,
          157
        ]
      ]
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Rule",
      "items": [
        "inactive / pending / firing",
        "for delays firing while the condition persists"
      ]
    },
    {
      "dot": "cyan",
      "title": "Delivery",
      "items": [
        "Grouping, inhibition and reminders are configured",
        "No exactly-once delivery guarantee"
      ]
    },
    {
      "dot": "emerald",
      "title": "Incident",
      "items": [
        "Acknowledgment and closure belong to the incident tool",
        "A cleared rule is not proof of recovery"
      ]
    }
  ]
}
