      "dot": "rose",
      "title": "Taint Effects",
      "items": [
        "NoSchedule: pods without a toleration are not scheduled on the node",
        "PreferNoSchedule: prefer not to schedule pods without a toleration on the node",
        "NoExecute: pods without a toleration are evicted from the node"
      ]
    },
    {
      "dot": "cyan",
      "title": "Use Cases",
      "items": [
        "Dedicated nodes: designate nodes that run only specific workloads",
        "Special hardware: manage nodes with special hardware such as GPUs",
        "Node maintenance: prevent new pods from being scheduled on nodes under maintenance",
        "Node issues: evict pods from nodes with problems"
      ]
    }
