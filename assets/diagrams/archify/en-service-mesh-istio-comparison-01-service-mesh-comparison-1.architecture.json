      {
        "id": "kong",
        "label": "Kong Mesh - Multi-zone",
        "focus": [
          "kong-global",
          "kong-zone1",
          "kong-zone2",
          "kong-pod",
          "kong-vm"
        ],
        "note": "Multi-cloud with equal K8s + VM support, but enterprise features are paid and the community is small."
      }
    ]
