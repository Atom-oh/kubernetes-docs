      "title": "Pod Security Context",
      "items": [
        "runAsUser — user ID the container process runs as",
        "runAsGroup — group ID the container process runs as",
        "fsGroup — group ID used when accessing volumes",
        "supplementalGroups — additional groups granted to the process"
      ]
    },
    {
      "dot": "orange",
      "title": "Container Security Context",
      "items": [
        "privileged — privileged mode",
        "allowPrivilegeEscalation — whether a process can gain more privileges than its parent",
        "readOnlyRootFilesystem — mount the root filesystem read-only",
        "capabilities — add or drop Linux kernel capabilities",
        "seLinuxOptions — SELinux options"
      ]
    },
    {
      "dot": "slate",
      "title": "Pod Security Standards",
      "items": [
        "Privileged — no restrictions, all privileges allowed",
        "Baseline — blocks known privilege escalation paths",
        "Restricted — strongly hardened security policy",
        "Applied via namespace labels pod-security.kubernetes.io/enforce, audit and warn"
      ]
    }
