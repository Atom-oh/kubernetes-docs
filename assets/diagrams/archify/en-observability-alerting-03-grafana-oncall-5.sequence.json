{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Slack Workflow — Alert Posting and Acknowledge/Resolve Handling",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      640
    ],
    "animation": "trace",
    "views": [
      {
        "id": "post",
        "label": "Alert posting",
        "focus": [
          "alert",
          "oncall",
          "slack",
          "user"
        ],
        "note": "The alert passes through OnCall and is posted to the Slack channel as a message with action buttons."
      },
      {
        "id": "ack",
        "label": "Acknowledge",
        "focus": [
          "user",
          "slack",
          "oncall"
        ],
        "note": "An Acknowledge click round-trips through Slack to update OnCall's status and the channel message."
      },
      {
        "id": "resolve",
        "label": "Resolve",
        "focus": [
          "user",
          "slack",
          "oncall",
          "alert"
        ],
        "note": "Resolve also updates status and message, and additionally notifies the alert source."
      }
    ]
