  "cards": [
    {
      "dot": "cyan",
      "title": "Flux Image Automation",
      "items": [
        "ImageRepository scans the ECR repository every 5m (provider: aws)",
        "ImagePolicy selects the latest tag matching semver range \">=1.0.0\"",
        "ImageUpdateAutomation commits \"Automated image update\" to main using the Setters strategy on the # {\"$imagepolicy\": ...} marker"
      ]
    },
    {
      "dot": "orange",
      "title": "Flagger Canary Analysis",
      "items": [
        "On a Deployment change Flagger shifts traffic in stepWeight 10 increments up to maxWeight 50",
        "Every interval 1m it checks request-success-rate ≥ 99% and request-duration ≤ 500ms; threshold 5 failures triggers rollback",
        "The Kustomization ships deployment.yaml, service.yaml, hpa.yaml, canary.yaml and alert-providers.yaml into the production namespace"
      ]
    }
  ]
