      {
        "id": "prioritize-phase",
        "label": "Prioritize phase",
        "focus": [
          "scheduler",
          "extender"
        ],
        "note": "After internal scoring, HTTP POST /prioritize fetches the extender's node scores to combine"
      },
      {
        "id": "bind-phase",
        "label": "Node selection and binding",
        "focus": [
          "scheduler",
          "api",
          "node"
        ],
        "note": "The final node is selected, the API server is asked to bind, and the pod is scheduled on the node"
      }
    ]
