  "cards": [
    {
      "dot": "cyan",
      "title": "Core components",
      "items": [
        "kube-apiserver: frontend of the control plane that exposes the Kubernetes API",
        "etcd: consistent, highly available key-value store for all cluster data",
        "kube-scheduler: selects the node that runs each new pod"
      ]
    },
    {
      "dot": "emerald",
      "title": "kube-controller-manager",
      "items": [
        "Node Controller: notices and responds when nodes go down",
        "Replication Controller: maintains the correct number of pod replicas",
        "Endpoints Controller: connects services and pods",
        "Service Account & Token Controller: creates default accounts and API tokens"
      ]
    },
    {
      "dot": "amber",
      "title": "cloud-controller-manager",
      "items": [
        "Node Controller: checks with the cloud provider whether a node was deleted",
        "Route Controller: sets up routes in the cloud infrastructure",
        "Service Controller: creates, updates, deletes cloud load balancers",
        "Volume Controller: creates, attaches, mounts volumes"
      ]
    }
  ]
