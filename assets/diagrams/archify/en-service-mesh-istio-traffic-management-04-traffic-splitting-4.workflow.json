          "label": "Argo Rollouts step"
        },
        "security": {
          "label": "Verification"
        },
        "frontend": {
          "label": "Approval gate"
        },
        "external": {
          "label": "Final state"
        },
        "messagebus": {
          "label": "Rollback"
        }
      }
    },
    "views": [
