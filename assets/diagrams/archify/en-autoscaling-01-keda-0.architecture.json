  "cards": [
    {
      "dot": "cyan",
      "title": "Key Components",
      "items": [
        "KEDA Operator: watches ScaledObject/ScaledJob resources and manages HPA",
        "KEDA Metrics Server: collects metrics from external sources and exposes them to the Kubernetes API",
        "ScaledObject/ScaledJob: define scaling configuration for Deployments, StatefulSets and Jobs"
      ]
    },
    {
      "dot": "emerald",
      "title": "How It Works",
      "items": [
        "User creates a ScaledObject or ScaledJob defining the target and triggers",
        "The Operator detects it and creates the corresponding HPA",
        "The Metrics Server polls external sources; the HPA scales the workload on those metrics",
        "With no activity, KEDA scales replicas down to 0 (which HPA alone cannot do)"
      ]
    }
  ]
