        "id": "order-flow",
        "label": "Create order (POST /orders)",
        "focus": [
          "client",
          "gw",
          "order",
          "aurora",
          "mq"
        ],
        "note": "The API gateway routes the request to order-service, which writes to Aurora and then publishes an order_created event to SQS."
      },
      {
        "id": "payment-flow",
        "label": "Process payment (POST /payments)",
        "focus": [
          "client",
          "gw",
          "payment",
          "aurora",
          "mq"
        ],
        "note": "payment-service follows the same pattern: it writes to Aurora and publishes a payment_completed event to SNS."
      },
      {
        "id": "async-notify",
        "label": "Async notification",
        "focus": [
          "mq",
          "notif"
        ],
        "note": "notification-service consumes SQS messages and sends email/SMS without delaying the client response."
      }
    ]
  },
