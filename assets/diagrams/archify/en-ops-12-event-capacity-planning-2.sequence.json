        "focus": [
          "keda",
          "hpa",
          "scheduler"
        ],
        "note": "The cron trigger pushes desiredReplicas to 200; 195 new Pods cannot fit on existing Nodes and go Pending."
      },
      {
        "id": "node-provision",
        "label": "Node provisioning",
        "focus": [
          "scheduler",
          "karpenter",
          "ec2"
        ],
        "note": "Karpenter detects the Pending Pods and requests 20 EC2 Nodes; once they are Ready after 60-90s the Pending Pods get scheduled."
      },
      {
        "id": "event-start",
        "label": "Event starts (metric)",
        "focus": [
          "keda",
          "hpa",
          "scheduler",
          "karpenter",
          "ec2"
        ],
        "note": "The metric trigger raises the target to 250, and only 5 more Nodes are needed for the 50 additional Pending Pods."
      }
    ],
