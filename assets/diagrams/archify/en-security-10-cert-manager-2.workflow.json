    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "HTTP-01 solver",
      "items": [
        "Proves domain ownership through a web server (Ingress controller)",
        "The /.well-known/acme-challenge/ token path must be reachable on port 80"
      ]
    },
    {
      "dot": "amber",
      "title": "DNS-01 solver",
      "items": [
        "Proves domain ownership with a DNS TXT record",
        "Required for wildcard certificates",
        "On EKS, Route53 + IRSA manages records without static credentials"
      ]
    }
  ]
}
