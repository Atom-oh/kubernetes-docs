      "sublabel": "HTTP request or DNS query"
    },
    {
      "id": "issue",
      "lane": "le",
      "col": 5,
      "width": 160,
      "type": "external",
      "label": "Issue certificate",
      "sublabel": "returns signed certificate"
    },
    {
      "id": "secret",
      "lane": "output",
      "col": 5,
      "width": 160,
      "type": "database",
      "label": "Store in Secret",
      "sublabel": "tls.crt + tls.key"
    }
  ],
  "edges": [
