      "dot": "cyan",
      "title": "Pod spec precedence",
      "items": [
        "pod_template_file supplies the shared defaults",
        "Constructor arguments such as image, cmds/arguments and service_account_name override the same fields in the template",
        "Jinja templates ({{ ds }}) are rendered before the Pod is built"
      ]
    },
    {
      "dot": "amber",
      "title": "Dedicated node pool",
      "items": [
        "tolerations + nodeAffinity match the workload=airflow-tasks taint",
        "Avoids competing with unrelated workloads on shared nodes and scales purely on task pod demand"
      ]
    },
    {
      "dot": "rose",
      "title": "IRSA per task",
      "items": [
        "Annotate the ServiceAccount with eks.amazonaws.com/role-arn",
        "A permission boundary separate from the Airflow control-plane components' role"
      ]
