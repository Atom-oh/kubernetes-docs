  "cards": [
    {
      "dot": "orange",
      "title": "Flink Kubernetes Operator",
      "items": [
        "Desired state is declared with FlinkDeployment (Application/Session clusters) and FlinkSessionJob CRs",
        "Applies changes safely via stateless, savepoint, or last-state upgrade modes",
        "Built-in autoscaler rescales individual job-graph vertices"
      ]
    },
    {
      "dot": "cyan",
      "title": "JobManager",
      "items": [
        "Control plane: builds the job graph, coordinates checkpoints, schedules work",
        "Does not process any records itself",
        "Its Kubernetes ResourceManager talks directly to the API server to request and release TaskManager pods dynamically"
      ]
    },
    {
      "dot": "emerald",
      "title": "TaskManager",
      "items": [
        "Workers that execute operator subtasks inside task slots",
        "No fixed worker pool has to be pre-provisioned (unlike YARN node managers)"
      ]
    }
  ]
