    "views": [
      {
        "id": "dp",
        "label": "Data Parallelism",
        "focus": [
          "dp-shards",
          "dp-replicas",
          "dp-sync"
        ],
        "note": "Each data shard trains a full model replica; gradients are synchronized with AllReduce."
      },
      {
        "id": "tp",
        "label": "Tensor Parallelism",
        "focus": [
          "tp-layer",
          "tp-gpus",
          "tp-combine"
        ],
        "note": "A single layer's weights are split by columns across GPUs, then the partial results are combined."
      },
      {
        "id": "pp",
        "label": "Pipeline Parallelism",
        "focus": [
          "pp-micro",
          "pp-stage1",
          "pp-stage23"
        ],
        "note": "Layers are grouped into stages on separate GPUs and micro-batches flow through the stages in order."
      },
      {
        "id": "ep",
        "label": "Expert Parallelism (MoE)",
        "focus": [
          "ep-router",
          "ep-experts",
          "ep-output"
        ],
        "note": "The router/gating sends each token to a subset of experts, whose outputs are then combined."
      }
    ]
  },
