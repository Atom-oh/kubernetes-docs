      "title": "Alert pipeline",
      "items": [
        "Dispatcher routes alerts to the appropriate receivers based on the routing tree",
        "Inhibitor suppresses related alerts according to inhibition rules",
        "Silencer filters alerts matching silence rules",
        "Aggregation Group bundles alerts of the same group for processing",
        "Notification Pipeline handles the actual alert sending"
      ]
    },
