          "gw",
          "vpc"
        ],
        "note": "A new hybrid node becomes NodeReady; the leader programs FDB, ARP and a local route, then adds the Pod CIDR route to the VPC route table."
      },
      {
        "id": "leave",
        "label": "Node leaves",
        "focus": [
          "k8s",
          "gw",
          "vpc"
        ],
        "note": "When the node is removed, the leader tears down the same entries and deletes the stale Pod CIDR route."
      }
    ]
