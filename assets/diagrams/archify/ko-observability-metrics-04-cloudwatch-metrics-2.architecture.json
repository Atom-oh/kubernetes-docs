  "cards": [
    {
      "dot": "orange",
      "title": "메트릭",
      "items": [
        "metrics_collection_interval를 30초 대신 60초로 조정",
        "aggregation_dimensions에서 불필요한 차원 조합 제거",
        "enhanced_container_insights는 필요할 때만 활성화"
      ]
    },
    {
      "dot": "cyan",
      "title": "로그",
      "items": [
        "put-retention-policy로 로그 그룹별 보존 기간(7·14·30일) 설정",
        "보존 기간이 없는 로그 그룹을 찾아 일괄 정리",
        "INFREQUENT_ACCESS 로그 클래스로 약 50% 절감"
      ]
    },
    {
      "dot": "violet",
      "title": "대시보드",
      "items": [
        "대시보드는 처음 3개 무료, 이후 $3.00/개/월",
        "GetMetricData API는 1,000 요청당 $0.01 — 쿼리 수를 줄인다"
      ]
    }
