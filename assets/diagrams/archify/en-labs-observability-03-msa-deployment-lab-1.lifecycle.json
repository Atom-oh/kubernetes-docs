{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Canary inspection, analysis, promotion or abort",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1080,
      650
    ],
    "locale": "en"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Rollout progression"
    },
    {
      "id": "recovery",
      "label": "Abort and explicit recovery"
    },
    {
      "id": "terminal",
      "label": "Explicit desired-state recovery"
    }
  ],
  "states": [
    {
      "id": "weight",
      "type": "start",
      "label": "SetWeight20",
      "sublabel": "replica approximation",
      "lane": "main",
      "col": 0
    },
    {
      "id": "pause",
      "type": "waiting",
      "label": "Manual pause",
      "sublabel": "inspect / generate traffic",
      "lane": "main",
      "col": 1
    },
    {
      "id": "gate",
      "type": "decision",
      "label": "Canary analysis",
      "sublabel": "requests ≥5 / success ≥99%",
      "lane": "main",
      "col": 2
    },
    {
      "id": "promote",
      "type": "success",
      "label": "SetWeight100",
      "sublabel": "promote after checks",
      "lane": "main",
      "col": 4
    },
    {
      "id": "abort",
      "type": "failure",
      "label": "Abort",
      "sublabel": "missing / failed evidence",
      "lane": "recovery",
      "col": 0
    },
    {
      "id": "restore",
      "type": "active",
      "label": "Restore state",
      "sublabel": "explicit Git / image",
      "lane": "terminal",
      "col": 0
    }
  ],
  "transitions": [
    {
      "from": "weight",
      "to": "pause"
    },
    {
      "from": "pause",
      "to": "gate"
    },
    {
      "from": "gate",
      "to": "promote",
      "variant": "emphasis"
    },
    {
      "from": "gate",
      "to": "abort",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "abort",
      "to": "restore",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Analysis conditions",
      "items": [
        "revision = latest pod-template hash",
        "3measurements /20s interval / failureLimit1",
        "Empty/NaN/Inf do not satisfy success",
        "Abort does not revert Git"
      ]
    }
  ]
}
