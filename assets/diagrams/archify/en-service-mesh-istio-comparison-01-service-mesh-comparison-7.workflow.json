    "views": [
      {
        "id": "global-scope",
        "label": "Global-scope path",
        "focus": [
          "decide",
          "globalStore",
          "sync",
          "zoneRecv"
        ],
        "note": "Global policies such as Mesh, TrafficRoute and TrafficPermission are stored in the Global CP and then synced to every Zone CP."
      },
      {
        "id": "zone-scope",
        "label": "Zone-scope path",
        "focus": [
          "decide",
          "zoneStore",
          "dpUpdate"
        ],
        "note": "Zone policies such as HealthCheck and ProxyTemplate are stored only in that Zone CP and update only that zone's data plane."
      },
      {
        "id": "enforce",
        "label": "Data plane enforcement",
        "focus": [
          "zoneRecv",
          "dpUpdate",
          "envoy"
        ],
        "note": "On both paths the Zone CP updates the data plane over xDS, and Envoy applies the new config to live traffic control."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Operator action"
        },
