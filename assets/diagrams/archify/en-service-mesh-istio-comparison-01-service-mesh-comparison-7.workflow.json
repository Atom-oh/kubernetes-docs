{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Kong Mesh Policy Propagation Mechanism",
    "locale": "en",
    "output": "public/archmaps/en-service-mesh-istio-comparison-01-service-mesh-comparison-7.html",
    "animation": "trace",
