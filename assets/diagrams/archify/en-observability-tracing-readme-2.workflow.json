{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Anatomy of a Single Span",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "identifiers",
        "label": "Identifier header",
        "focus": [
          "header"
        ],
        "note": "TraceID identifies the trace, SpanID this span, and the parent identifier is absent for a root. The representation depends on the API."
      },
      {
        "id": "timing",
        "label": "Timing",
        "focus": [
          "header",
          "timing"
        ],
        "note": "Start time is known at creation; duration follows from end minus start after the span ends. 150 ms is illustrative."
      },
      {
        "id": "metadata",
        "label": "Operational metadata",
        "focus": [
          "timing",
          "metadata"
        ],
        "note": "OpenTelemetry uses attributes and timestamped events. Events are not an automatic copy of application logs."
      },
      {
        "id": "outcome",
        "label": "Final status",
        "focus": [
          "metadata",
          "status"
        ],
        "note": "Status is UNSET, OK or ERROR. Successful HTTP instrumentation commonly leaves UNSET; exception recording and setting ERROR are separate."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Identifiers"
        },
        "backend": {
          "label": "Timing"
        },
        "database": {
          "label": "Metadata"
        },
        "security": {
          "label": "Status"
        }
      }
    },
    "locale": "en",
    "output": "en-observability-tracing-readme-2.html"
  },
