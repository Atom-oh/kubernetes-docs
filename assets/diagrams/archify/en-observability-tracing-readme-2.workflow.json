{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Anatomy of a Single Span",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "identifiers",
        "label": "Identifier header",
        "focus": [
          "header"
        ],
        "note": "TraceID names the whole trace, SpanID this span, and ParentSpanID its parent. A root span has ParentSpanID null."
      },
      {
        "id": "timing",
        "label": "Timing",
        "focus": [
          "header",
          "timing"
        ],
        "note": "Start Time and Duration record when this unit of work began and how long it took, e.g. start 10:30:00, 150 ms."
      },
      {
        "id": "metadata",
        "label": "Operational metadata",
        "focus": [
          "timing",
          "metadata"
        ],
        "note": "Holds the Operation Name (HTTP GET /users), Tags (service=api, http.method=GET) and Logs (request received, response sent)."
      },
      {
        "id": "outcome",
        "label": "Final status",
        "focus": [
          "metadata",
          "status"
        ],
        "note": "When the work completes, Status records the outcome. The example span closes with Status: OK."
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "Identifiers"
        },
        "backend": {
          "label": "Timing"
        },
        "database": {
          "label": "Metadata"
        },
        "security": {
          "label": "Status"
        }
      }
    },
    "locale": "en"
  },
  "lanes": [
    {
      "id": "identity",
      "label": "Identification · timing — filled when the span starts"
    },
    {
      "id": "outcome",
      "label": "Metadata · status — filled during work and at completion"
