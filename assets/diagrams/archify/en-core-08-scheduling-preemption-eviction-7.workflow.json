        "label": "PDB Components",
        "focus": [
          "pdb",
          "minAvailable",
          "maxUnavailable",
          "selector"
        ],
        "note": "minAvailable or maxUnavailable sets the disruption limit, and selector picks the target pods."
      },
      {
        "id": "operation",
        "label": "PDB Operation",
        "focus": [
          "disruption",
          "check",
          "allow",
          "deny"
        ],
        "note": "On a voluntary disruption such as node drain, the PDB condition is checked and eviction is allowed or denied."
      },
      {
        "id": "example",
        "label": "PDB Example",
        "focus": [
          "deployment",
          "pdbMin",
          "pdbMax"
        ],
        "note": "For a Deployment with 5 replicas, minAvailable 3 and maxUnavailable 2 have the same effect."
      }
    ]
  },
