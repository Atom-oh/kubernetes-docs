  "cards": [
    {
      "dot": "cyan",
      "title": "Metadata DB",
      "items": [
        "PostgreSQL is always required — stores DAG/task state, serialized_dag, connections, variables, XComs",
        "DAG file access is isolated to the dag-processor pod(s); the scheduler and api-server never parse files directly"
      ]
    },
    {
      "dot": "amber",
      "title": "Executors",
      "items": [
        "KubernetesExecutor: a fresh pod per task, near-zero idle cost",
        "CeleryExecutor: warm worker pool + Redis (or RabbitMQ) broker required"
      ]
    }
