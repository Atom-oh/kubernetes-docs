        "id": "celery-path",
        "label": "CeleryExecutor path",
        "focus": [
          "sch",
          "redis",
          "w1",
          "w2"
        ],
        "note": "The scheduler queues tasks on the Redis broker and warm Celery worker pods pull them. Only needed with CeleryExecutor."
      },
      {
        "id": "k8s-path",
        "label": "KubernetesExecutor path",
        "focus": [
          "sch",
          "kpod"
        ],
        "note": "The scheduler creates a dedicated pod per task instance; the pod is torn down on completion."
      }
    ]
  },
