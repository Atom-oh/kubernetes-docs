    "views": [
      {
        "id": "ingest",
        "label": "Ingestion and hot indexing",
        "focus": [
          "app",
          "fb",
          "os",
          "ebs"
        ],
        "note": "Application logs reach OpenSearch through FluentBit's Bulk API calls and are indexed on EBS as hot data."
      },
      {
        "id": "warm",
        "label": "After 7 days: UltraWarm",
        "focus": [
          "os",
          "uw"
        ],
        "note": "An ISM policy moves indices older than 7 days to the read-only UltraWarm tier."
      },
      {
        "id": "cold",
        "label": "After 30 days: cold storage",
        "focus": [
          "uw",
          "s3"
        ],
        "note": "After 30 days the data moves on to S3-backed cold storage to cut retention cost."
      }
    ]
  },
