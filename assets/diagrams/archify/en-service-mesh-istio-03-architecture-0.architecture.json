  "cards": [
    {
      "dot": "cyan",
      "title": "Control plane (Istiod)",
      "items": [
        "It watches Services and Istio resources on the Kubernetes API server",
        "Pilot translates routing configuration into xDS and pushes it to every Envoy",
        "Citadel issues workload certificates and rotates them automatically"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data plane (Envoy)",
      "items": [
        "A sidecar per pod intercepts all inbound and outbound traffic",
        "Service-to-service traffic is encrypted with mTLS by default",
        "The Ingress Gateway is the entry point; the Egress Gateway is where outbound traffic is controlled"
      ]
    },
    {
      "dot": "amber",
      "title": "Configuration flow",
      "items": [
        "VirtualService and DestinationRule changes propagate through Istiod as xDS",
        "Configuration lands without restarting the proxy, which is the sidecar model's advantage",
        "istioctl proxy-status shows each proxy's configuration sync state"
      ]
    }
  ]
