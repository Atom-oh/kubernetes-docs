  "cards": [
    {
      "dot": "cyan",
      "title": "Canary CRD",
      "items": [
        "References the existing Deployment via targetRef (no Deployment replacement needed)",
        "analysis defines traffic weights, metric thresholds, and pre/post-rollout webhooks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Created by Flagger",
      "items": [
        "The app-primary Deployment/Service serves stable-version traffic",
        "The original app Deployment is used as the canary and stays at 0 replicas when no rollout is running",
        "A VirtualService / TrafficSplit manages the traffic ratio"
      ]
    },
    {
      "dot": "amber",
      "title": "Analysis and alerting",
      "items": [
        "Queries metrics from Prometheus, Datadog, or CloudWatch",
        "Advances and promotes when thresholds pass; rolls back automatically on failure",
        "Reports the result through Slack / Teams webhooks"
      ]
