          "flagger",
          "canary"
        ],
        "note": "Flagger watches the Canary CRD and, when a new deployment is detected, starts the new version in the canary Deployment."
      },
      {
        "id": "shift",
        "label": "2. Shift traffic",
        "focus": [
          "flagger",
          "traffic"
        ],
        "note": "Updates the mesh/ingress provider's routing rules to raise the canary traffic weight step by step."
      },
      {
        "id": "analyze",
        "label": "3. Analyze metrics",
        "focus": [
          "flagger",
          "metrics"
        ],
        "note": "Queries the metrics backend for success rate and latency to decide whether to advance or roll back."
      },
      {
        "id": "promote",
        "label": "4. Promote and notify",
        "focus": [
          "flagger",
          "primary",
          "alerts"
        ],
        "note": "Once every step passes, the canary spec is copied to the primary and the result is sent to the alert channels."
      }
    ]
  },
