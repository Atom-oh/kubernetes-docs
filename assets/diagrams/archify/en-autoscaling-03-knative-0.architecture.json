  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "With traffic, the Gateway forwards directly to Queue Proxy → User Container",
        "At scale-to-zero the first request is buffered by the Activator and forwarded once a pod is ready"
      ]
    },
    {
      "dot": "amber",
      "title": "Autoscaling",
      "items": [
        "The Queue Proxy sidecar queues requests, enforces containerConcurrency, and reports real-time concurrency",
        "KPA scales on concurrency/RPS and supports scale-to-zero; HPA scales on CPU/memory and does not"
      ]
    },
    {
      "dot": "violet",
      "title": "Control plane",
      "items": [
        "The Controller reconciles Service, Configuration, Revision, Route into Deployments, Services, and Ingress objects",
        "The Webhook validates and defaults Knative resource specs on admission"
      ]
    }
  ]
