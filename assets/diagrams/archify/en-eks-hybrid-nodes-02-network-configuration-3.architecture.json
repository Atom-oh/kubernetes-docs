  "cards": [
    {
      "dot": "cyan",
      "title": "How ARP proxy works",
      "items": [
        "The router sends an ARP REQUEST asking for the MAC of a pod IP (10.85.1.10)",
        "The node hosting that pod answers with an ARP REPLY carrying its own MAC",
        "The router then treats the pod IP as a host on the same link"
      ]
    },
    {
      "dot": "emerald",
      "title": "Router routing table",
      "items": [
        "10.80.0.0/16 [local] via eth0 (CONNECTED)",
        "10.85.1.10/32 · 10.85.1.11/32 · 10.85.2.10/32 [local] via eth0 (CONNECTED)",
        "10.0.0.0/16 [static] via Gateway (STATIC)"
      ]
    },
    {
      "dot": "amber",
      "title": "Strengths and limits",
      "items": [
        "No route configuration on the router, so it needs the least coordination with the network team",
        "Every pod produces a /32 host route, so the ARP table grows with pod count",
        "The node's CNI must support ARP proxy and the subnet must be one broadcast domain"
      ]
    }
  ]
}