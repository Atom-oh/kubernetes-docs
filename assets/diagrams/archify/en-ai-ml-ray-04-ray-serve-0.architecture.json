    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Ray Serve routes HTTP/gRPC requests to a deployment's actor replicas",
        "The Preprocess → Model Inference deployments compose one application",
        "Each deployment is scaled, versioned, and resourced independently"
      ]
    },
    {
      "dot": "amber",
      "title": "Three-tier autoscaling",
      "items": [
        "Ray Serve Autoscaler: compares ongoing requests per replica (queued + in-flight) against a target and adjusts replicas",
        "Ray/KubeRay Autoscaler: decides worker Pod count from pending actor placement",
        "Karpenter: decides how many EC2 nodes are needed to run the pending worker Pods"
      ]
    }
