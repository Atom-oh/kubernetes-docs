    {
      "dot": "cyan",
      "title": "EBS tuning",
      "items": [
        "gp3 decouples IOPS and throughput from capacity, so you avoid buying size you do not need",
        "For hundreds of thousands of IOPS, use io2 Block Express on an EBS-optimized instance",
        "If the instance's EBS bandwidth ceiling is below the volume's, the instance is the bottleneck"
      ]
    },
    {
      "dot": "emerald",
      "title": "EFS tuning",
      "items": [
        "Default to elastic throughput and switch to provisioned only when you need steady performance",
        "Many-small-file reads are latency-sensitive, so add a caching layer",
        "Tune read and write buffer sizes in the mount options to raise throughput"
      ]
    },
    {
      "dot": "amber",
      "title": "FSx and LLM workloads",
      "items": [
        "Decide deployment type and provisioned throughput (125-1,000 MB/s per TiB) first",
        "Striping spreads large files across storage targets to widen parallel reads",
        "Workloads that reload model weights repeatedly, such as vLLM, favor FSx for Lustre"
      ]
    }
  ]
