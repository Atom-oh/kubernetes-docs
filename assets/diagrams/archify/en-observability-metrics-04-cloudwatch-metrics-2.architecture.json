    {
      "dot": "orange",
      "title": "Metrics",
      "items": [
        "Set metrics_collection_interval to 60s instead of 30s",
        "Remove unnecessary dimension combinations from aggregation_dimensions",
        "Enable enhanced_container_insights only when needed"
      ]
    },
    {
      "dot": "cyan",
      "title": "Logs",
      "items": [
        "Set per-log-group retention (7, 14, or 30 days) with put-retention-policy",
        "Find log groups with no retention and fix them in bulk",
        "Use the INFREQUENT_ACCESS log class for about 50% savings"
      ]
    },
    {
      "dot": "violet",
      "title": "Dashboards",
      "items": [
        "First 3 dashboards are free, then $3.00 per dashboard per month",
        "GetMetricData API costs $0.01 per 1,000 requests; reduce query volume"
      ]
    }
