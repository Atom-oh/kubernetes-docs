    {
      "dot": "cyan",
      "title": "Receivers",
      "items": [
        "OTLP gRPC 4317 / HTTP 4318",
        "Jaeger (14268/14250) and Zipkin (9411) compatibility",
        "Prometheus scraping, k8s_cluster metrics"
      ]
    },
    {
      "dot": "amber",
      "title": "Processors",
      "items": [
        "memory_limiter: limit 1500 MiB, spike 500 MiB",
        "filter: drops /health, /ready, /metrics spans",
        "tail_sampling: keeps 100% of error requests, decision_wait 10s",
        "batch: flushes every 5s or 1000 items"
      ]
    },
    {
      "dot": "emerald",
      "title": "Exporters",
      "items": [
        "traces -> otlp/tempo, awsxray",
        "metrics -> prometheusremotewrite",
