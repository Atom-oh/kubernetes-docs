          "receivers",
          "memory-limiter"
        ],
        "note": "Data accepted by the OTLP (4317/4318), Jaeger, Zipkin and Prometheus receivers passes through memory_limiter first."
      },
      {
        "id": "enrich-filter",
        "label": "Enrich and filter",
        "focus": [
          "resource",
          "attributes",
          "filter"
        ],
        "note": "Resource detection and attribute upserts enrich the data; health-check spans such as /health, /ready and /metrics are dropped."
      },
      {
        "id": "sample-export",
        "label": "Sampling decision and export",
        "focus": [
          "tail-sampling",
          "batch",
          "exporters"
        ],
        "note": "tail_sampling decides on the whole trace, then batch sends sampled traces to Tempo and X-Ray; metrics go to Prometheus, logs to Loki."
      }
    ]
  },
