      "title": "Network Security",
      "items": [
        "Microsegmentation prevents lateral movement and applies least privilege",
        "Transparent inter-node IPsec or WireGuard encryption",
        "DNS-based policies and malicious domain blocking"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application Security",
      "items": [
        "API-aware filtering on HTTP method/path/header, gRPC and Kafka",
        "Service identity-based policies with mTLS and SPIFFE/SPIRE integration"
      ]
    },
    {
      "dot": "amber",
      "title": "Detection and Runtime",
