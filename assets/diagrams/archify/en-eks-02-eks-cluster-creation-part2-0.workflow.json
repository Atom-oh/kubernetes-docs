  "cards": [
    {
      "dot": "cyan",
      "title": "Creation order",
      "items": [
        "eksctl creates everything as CloudFormation stacks, which makes tracking and rollback possible",
        "Order: VPC and subnets → IAM roles and security groups → control plane → node group",
        "It refreshes kubeconfig at the end, so kubectl works immediately"
      ]
    },
    {
      "dot": "emerald",
      "title": "Timing and checks",
      "items": [
        "The control plane usually takes about 10 minutes; with the node group, 15-20 minutes",
        "aws cloudformation describe-stack-events shows where it stalled",
        "eksctl utils write-kubeconfig regenerates the kubeconfig"
      ]
    },
    {
      "dot": "amber",
      "title": "Using a config file",
      "items": [
        "eksctl create cluster -f cluster.yaml keeps the definition declarative and reproducible",
        "A config file covers add-ons, IRSA, and logging in one place, unlike command-line flags",
        "Keep the config file in Git so the cluster definition lives as code"
      ]
    }
  ]
