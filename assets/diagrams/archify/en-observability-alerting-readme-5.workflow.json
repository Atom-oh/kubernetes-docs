  "cards": [
    {
      "dot": "rose",
      "title": "Severity Decides the Channel",
      "items": [
        "Critical alerts page a phone immediately and continue matching (continue: true)",
        "High alerts reach Slack and PagerDuty; warnings stay in a Slack channel",
        "Info alerts end at email and are never routed to a team"
      ]
    },
    {
      "dot": "cyan",
      "title": "Team Receivers in the Route Tree",
      "items": [
        "alertname ^(Node|Disk|CPU|Memory).* goes to sre-team",
        "namespace ^(app|api|web).* goes to dev-team",
        "alertname ^(MySQL|PostgreSQL|Redis|MongoDB).* goes to dba-team"
      ]
    },
    {
      "dot": "amber",
      "title": "Escalation After Delivery",
      "items": [
        "0 min: primary on-call via Slack and PagerDuty",
        "15 min: secondary on-call, SMS added",
        "30 min: team lead by phone; 45 and 60 min escalate to management"
      ]
    }
