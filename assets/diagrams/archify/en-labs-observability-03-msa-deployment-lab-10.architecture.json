        "focus": [
          "client",
          "gateway",
          "order",
          "payment",
          "aurora"
        ],
        "note": "Client requests are routed through the API Gateway to the order and payment services, both of which write to Aurora PostgreSQL."
      },
      {
        "id": "event-path",
        "label": "Asynchronous event path",
        "focus": [
          "order",
          "sqs",
          "notification",
          "payment",
          "sns"
        ],
        "note": "order-service publishes to SQS and payment-service to SNS; notification-service consumes the SQS messages."
      },
      {
        "id": "batch-path",
        "label": "Batch analytics",
        "focus": [
          "mwaa",
          "analytics"
        ],
        "note": "Amazon MWAA triggers analytics-batch on a schedule."
      },
      {
        "id": "telemetry-path",
        "label": "Telemetry path",
        "focus": [
          "order",
          "payment",
          "notification",
          "otel",
          "backends"
        ],
        "note": "Each service's OTel SDK exports traces to the OpenTelemetry Agent, which forwards them to the observability backends."
      }
    ]
  },
