      "title": "Control plane components",
      "items": [
        "controller: watches Certificate and Issuer resources and manages the certificate lifecycle",
        "webhook: validates CRDs, sets defaults, converts versions",
        "cainjector: injects CA bundles into ValidatingWebhookConfiguration and MutatingWebhookConfiguration"
      ]
    },
    {
      "dot": "amber",
      "title": "Issuance flow",
      "items": [
        "Issued automatically when a Certificate CR is created; renewed 30 days before expiry",
        "Multiple issuers: Let's Encrypt, Vault, AWS Private CA, Self-Signed",
        "Result stored as a Secret holding tls.crt and tls.key"
      ]
