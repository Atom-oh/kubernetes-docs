  "cards": [
    {
      "dot": "cyan",
      "title": "Pull model",
      "items": [
        "Prometheus controls collection targets and intervals centrally",
        "Target availability is detected automatically; endpoints can be queried directly for debugging",
        "Hard for short-lived jobs and targets behind NAT/firewalls; needs service discovery"
      ]
    },
    {
      "dot": "orange",
      "title": "Push model",
      "items": [
        "Datadog, CloudWatch, Graphite send metrics from the client",
        "Works for short-lived jobs and firewall/NAT environments; event-driven transmission",
        "Collector can be overloaded; availability detection is harder; client needs transmission logic"
      ]
    }
  ]
