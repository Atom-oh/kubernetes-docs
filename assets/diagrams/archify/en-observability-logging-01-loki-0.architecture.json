      "dot": "cyan",
      "title": "Write Path",
      "items": [
        "The Distributor validates log streams, normalizes labels, and applies rate limits",
        "The Ingester buffers logs in memory into chunks, manages the WAL, and flushes to storage"
      ]
    },
    {
      "dot": "amber",
      "title": "Read Path",
      "items": [
        "The Query Frontend splits large queries and caches results",
        "The Querier fetches live data from Ingesters and historical data from storage, then merges and deduplicates"
      ]
    },
    {
      "dot": "violet",
      "title": "Backend",
      "items": [
        "TSDB index compaction and retention deletion",
        "Authenticate clients and assign tenants before write/query APIs",
