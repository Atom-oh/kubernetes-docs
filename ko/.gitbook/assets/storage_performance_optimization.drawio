        <!-- Performance Optimization Guide -->
        <mxCell id="optimization-guide" value="성능 최적화 가이드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=3;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
