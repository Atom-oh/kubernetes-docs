        <!-- Troubleshooting Steps -->
        <mxCell id="troubleshooting" value="문제 해결 단계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=3;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="1000" height="280" as="geometry" />
        </mxCell>
        
        <!-- Step 1: Diagnosis -->
        <mxCell id="step1" value="1단계: 문제 진단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="280" height="220" as="geometry" />
        </mxCell>
        
        <mxCell id="step1-content" value="포드 상태 확인:&#xa;kubectl get pods -o wide&#xa;kubectl describe pod &lt;pod-name&gt;&#xa;&#xa;노드 상태 확인:&#xa;kubectl describe node &lt;node-name&gt;&#xa;kubectl get nodes -o wide&#xa;&#xa;CNI 로그 확인:&#xa;kubectl logs -n kube-system \\&#xa;  -l k8s-app=aws-node&#xa;&#xa;이벤트 확인:&#xa;kubectl get events --sort-by=.metadata.creationTimestamp&#xa;&#xa;리소스 사용량 확인:&#xa;kubectl top nodes&#xa;kubectl top pods" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;spacingTop=5;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="130" y="570" width="260" height="180" as="geometry" />
        </mxCell>
        
        <!-- Step 2: Network Testing -->
        <mxCell id="step2" value="2단계: 네트워크 테스트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E8;strokeColor=#388E3C;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="280" height="220" as="geometry" />
        </mxCell>
        
        <mxCell id="step2-content" value="연결 테스트:&#xa;kubectl exec -it &lt;pod&gt; -- ping &lt;target-ip&gt;&#xa;kubectl exec -it &lt;pod&gt; -- curl &lt;service-name&gt;&#xa;kubectl exec -it &lt;pod&gt; -- telnet &lt;host&gt; &lt;port&gt;&#xa;&#xa;DNS 테스트:&#xa;kubectl exec -it &lt;pod&gt; -- nslookup kubernetes.default&#xa;kubectl exec -it &lt;pod&gt; -- dig &lt;service-name&gt;.&lt;namespace&gt;.svc.cluster.local&#xa;&#xa;네트워크 정책 확인:&#xa;kubectl get networkpolicy&#xa;kubectl describe networkpolicy &lt;policy-name&gt;&#xa;&#xa;라우팅 테스트:&#xa;kubectl exec -it &lt;pod&gt; -- traceroute &lt;target-ip&gt;&#xa;kubectl exec -it &lt;pod&gt; -- ip route" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;spacingTop=5;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="570" width="260" height="180" as="geometry" />
        </mxCell>
        
        <!-- Step 3: Resolution -->
        <mxCell id="step3" value="3단계: 문제 해결" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="540" width="280" height="220" as="geometry" />
        </mxCell>
        
        <mxCell id="step3-content" value="IP 할당 문제 해결:&#xa;kubectl set env daemonset aws-node \\&#xa;  -n kube-system WARM_IP_TARGET=10&#xa;kubectl set env daemonset aws-node \\&#xa;  -n kube-system MINIMUM_IP_TARGET=5&#xa;&#xa;CNI 재시작:&#xa;kubectl rollout restart daemonset aws-node \\&#xa;  -n kube-system&#xa;&#xa;CoreDNS 재시작:&#xa;kubectl rollout restart deployment coredns \\&#xa;  -n kube-system&#xa;&#xa;네트워크 정책 수정:&#xa;kubectl edit networkpolicy &lt;policy-name&gt;&#xa;&#xa;노드 재시작 (최후 수단):&#xa;kubectl drain &lt;node-name&gt; --ignore-daemonsets&#xa;# 노드 재부팅 후&#xa;kubectl uncordon &lt;node-name&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;spacingTop=5;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="570" width="260" height="180" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
