        <!-- kubelet Section -->
        <mxCell id="kubelet_section" value="kubelet" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="200" height="200" as="geometry" />
