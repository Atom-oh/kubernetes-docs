        <mxCell id="kubelet_icon" value="kubelet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="110" width="160" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="kubelet_desc" value="- 노드의 주요 에이전트&#xa;- 컨테이너 생명주기 관리&#xa;- 노드 상태 모니터링&#xa;- 컨트롤 플레인과 통신&#xa;- 리소스 사용량 관리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="160" width="160" height="100" as="geometry" />
        </mxCell>
        
        <!-- kube-proxy Section -->
        <mxCell id="kube_proxy_section" value="kube-proxy" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="70" width="200" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="kube_proxy_icon" value="kube-proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="160" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="kube_proxy_desc" value="- 네트워크 프록시&#xa;- 서비스 추상화 구현&#xa;- 로드 밸런싱&#xa;- 네트워크 규칙 관리&#xa;- Pod 간 통신 지원" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="160" height="100" as="geometry" />
        </mxCell>
        
        <!-- Container Runtime Section -->
        <mxCell id="container_runtime_section" value="Container Runtime" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="200" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="container_runtime_icon" value="Container Runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00C7B7;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="110" width="160" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="container_runtime_desc" value="- 컨테이너 실행 환경&#xa;- 이미지 관리&#xa;- 컨테이너 생성/삭제&#xa;- 리소스 격리&#xa;- 볼륨 마운트" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="160" height="100" as="geometry" />
        </mxCell>
        
        <!-- Pod Section -->
        <mxCell id="pod_section" value="Pod" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="290" width="640" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="pod_containers" value="컨테이너 그룹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00C7B7;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="330" width="600" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="pod_desc" value="특징:&#xa;- 동일한 네트워크 네임스페이스 공유&#xa;- 동일한 IPC 네임스페이스 공유&#xa;- 동일한 볼륨 마운트 가능&#xa;- 함께 스케줄링되는 배포 단위&#xa;- 동일한 노드에서 실행&#xa;- 고유한 IP 주소 할당" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="380" width="600" height="100" as="geometry" />
        </mxCell>
        
        <!-- Interactions -->
        <mxCell id="interaction_title" value="구성 요소 간 상호작용" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="250" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="interactions" value="1. kubelet은 API 서버로부터 Pod 스펙을 받음&#xa;2. kubelet은 Container Runtime에 컨테이너 생성을 요청&#xa;3. Container Runtime은 이미지를 다운로드하고 컨테이너를 실행&#xa;4. kube-proxy는 서비스에 대한 네트워크 규칙을 설정&#xa;5. Pod 내의 컨테이너들은 리소스를 공유" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="550" width="640" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
