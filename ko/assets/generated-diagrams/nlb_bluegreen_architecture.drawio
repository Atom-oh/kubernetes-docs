          <mxGeometry x="100" y="300" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Green Target Group -->
        <mxCell id="tg-green" value="Target Group (Green)&#xa;Weight: 20%" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Amazon Ember;fontSize=11;fontColor=#2E7D32;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="140" height="50" as="geometry"/>
