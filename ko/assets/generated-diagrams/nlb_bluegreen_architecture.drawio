<mxfile host="app.diagrams.net" agent="Claude">
  <diagram name="NLB Blue/Green Architecture" id="nlb-bluegreen-ko">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="0" background="none" defaultFontFamily="Amazon Ember">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

