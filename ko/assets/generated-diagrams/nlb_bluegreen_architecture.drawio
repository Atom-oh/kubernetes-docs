        <!-- Green AZ Container -->
        <mxCell id="az-green" value="ap-northeast-2c" style="rounded=1;fillColor=#E6F2F8;strokeColor=#147EBA;strokeWidth=1;dashed=1;verticalAlign=top;fontFamily=Amazon Ember;fontSize=12;fontColor=#147EBA;align=left;spacingLeft=5;" vertex="1" parent="1">
