        <mxCell id="vpc" value="VPC: 10.0.0.0/16" style="rounded=1;fillColor=none;strokeColor=#248814;strokeWidth=2;dashed=1;verticalAlign=top;fontFamily=Amazon Ember;fontSize=14;fontColor=#248814;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="720" height="380" as="geometry"/>
        </mxCell>

        <!-- Route 53 -->
        <mxCell id="route53" value="Route 53&#xa;api.example.com" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;fontFamily=Amazon Ember;" vertex="1" parent="1">
