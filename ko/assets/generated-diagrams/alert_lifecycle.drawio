<mxfile host="app.diagrams.net" agent="Claude">
  <diagram name="Alert Lifecycle" id="alert-lifecycle-1">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" page="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="title" value="알림 라이프사이클" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Amazon Ember;fontSize=16;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="200" height="30" as="geometry"/>
        </mxCell>
        <!-- Start state -->
        <mxCell id="start" value="" style="ellipse;fillColor=#333;strokeColor=#333;fontFamily=Amazon Ember;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="30" height="30" as="geometry"/>
        </mxCell>
        <!-- Inactive state -->
        <mxCell id="inactive" value="Inactive" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="90" height="70" as="geometry"/>
        </mxCell>
        <!-- Pending state -->
        <mxCell id="pending" value="Pending" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="90" height="70" as="geometry"/>
        </mxCell>
        <!-- Firing state -->
        <mxCell id="firing" value="Firing" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#F44336;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="90" height="70" as="geometry"/>
        </mxCell>
        <!-- Resolved state -->
        <mxCell id="resolved" value="Resolved" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="130" width="90" height="70" as="geometry"/>
        </mxCell>
        <!-- End state -->
        <mxCell id="end" value="" style="ellipse;fillColor=#333;strokeColor=#333;fontFamily=Amazon Ember;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="30" height="30" as="geometry"/>
        </mxCell>
        <!-- Connections -->
        <!-- Start to Inactive -->
        <mxCell id="e1" value="조건 미충족" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Amazon Ember;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="start" target="inactive">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Inactive to Pending -->
        <mxCell id="e2" value="조건 충족" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Amazon Ember;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="inactive" target="pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Pending to Firing -->
        <mxCell id="e3" value="for 기간 경과" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Amazon Ember;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pending" target="firing">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Firing to Resolved -->
        <mxCell id="e4" value="조건 해소" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Amazon Ember;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="firing" target="resolved">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Resolved to Inactive (loop back) -->
        <mxCell id="e5" value="알림 종료" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Amazon Ember;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="resolved" target="inactive">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="645" y="260"/>
              <mxPoint x="165" y="260"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Pending to Inactive (condition cleared before for) -->
        <mxCell id="e6" value="조건 해소&#xa;(for 이전)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Amazon Ember;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pending" target="inactive">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="80"/>
              <mxPoint x="165" y="80"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Resolved to End -->
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="resolved" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
