          <mxGeometry x="150" y="170" width="540" height="30" as="geometry" />
        </mxCell>
        
        <!-- Containers -->
        <mxCell id="container1" value="애플리케이션 컨테이너" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#00C7B7;strokeColor=#333333;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="220" width="250" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="container1_desc" value="- 주요 애플리케이션 로직&#xa;- 사용자 정의 코드&#xa;- 비즈니스 기능 제공" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
