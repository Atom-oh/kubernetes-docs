          <mxGeometry x="170" y="360" width="120" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="volume2" value="configMap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;fontColor=#000000;" vertex="1" parent="1">
