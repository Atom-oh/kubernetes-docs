        <!-- Shared Volumes -->
        <mxCell id="shared_volumes" value="공유 볼륨" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0277BD;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
