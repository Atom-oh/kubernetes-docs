<mxfile host="app.diagrams.net" agent="Claude">
  <diagram name="Custom Metrics Pipeline" id="custom-metrics-pipeline-1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Container Box -->
        <mxCell id="container" value="Custom Metrics Pipeline" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontColor=#333;fontFamily=Amazon Ember;fontSize=14;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="760" height="260" as="geometry"/>
        </mxCell>
        <!-- Application Metrics -->
        <mxCell id="app" value="Application&#xa;Metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#607D8B;fontColor=#FFFFFF;strokeColor=#333;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;" vertex="1" parent="container">
          <mxGeometry x="30" y="80" width="100" height="60" as="geometry"/>
        </mxCell>
        <!-- Prometheus Server -->
        <mxCell id="prometheus" value="Prometheus&#xa;Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6522C;fontColor=#FFFFFF;strokeColor=#333;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;" vertex="1" parent="container">
          <mxGeometry x="180" y="80" width="100" height="60" as="geometry"/>
        </mxCell>
        <!-- Prometheus Adapter -->
        <mxCell id="adapter" value="Prometheus&#xa;Adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6522C;fontColor=#FFFFFF;strokeColor=#333;fontFamily=Amazon Ember;fontSize=12;fontStyle=1;" vertex="1" parent="container">
          <mxGeometry x="330" y="80" width="100" height="60" as="geometry"/>
        </mxCell>
        <!-- K8s API Server -->
        <mxCell id="apiserver" value="Kubernetes API Server&#xa;&#xa;custom.metrics.k8s.io&#xa;external.metrics.k8s.io" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;fontColor=#FFFFFF;strokeColor=#333;fontFamily=Amazon Ember;fontSize=11;fontStyle=0;align=center;" vertex="1" parent="container">
          <mxGeometry x="480" y="60" width="140" height="100" as="geometry"/>
        </mxCell>
        <!-- HPA -->
        <mxCell id="hpa" value="HPA&#xa;&#xa;Custom Metrics&#xa;External Metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;fontColor=#FFFFFF;strokeColor=#333;fontFamily=Amazon Ember;fontSize=11;fontStyle=0;align=center;" vertex="1" parent="container">
          <mxGeometry x="620" y="170" width="120" height="70" as="geometry"/>
        </mxCell>
        <!-- Connections -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="container" source="app" target="prometheus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="container" source="prometheus" target="adapter">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="container" source="adapter" target="apiserver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="container" source="apiserver" target="hpa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
