                </mxCell>
                <mxCell id="create-commands" value="클러스터 생성:&#10;• eksctl create cluster --name=my-cluster&#10;• eksctl create cluster -f cluster.yaml&#10;&#10;노드 그룹 추가:&#10;• eksctl create nodegroup --cluster=my-cluster&#10;&#10;Fargate 프로필 추가:&#10;• eksctl create fargateprofile --cluster=my-cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;strokeWidth=2;fontFamily=Noto Sans CJK KR;" parent="1" vertex="1">
                    <mxGeometry x="80" y="340" width="280" height="140" as="geometry" />
                </mxCell>
                <mxCell id="update-commands" value="클러스터 업데이트:&#10;• eksctl upgrade cluster --name=my-cluster --version=1.27&#10;&#10;노드 그룹 업그레이드:&#10;• eksctl upgrade nodegroup --cluster=my-cluster --name=my-nodegroup&#10;&#10;애드온 업데이트:&#10;• eksctl update addon --cluster=my-cluster --name=vpc-cni" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;strokeWidth=2;fontFamily=Noto Sans CJK KR;" parent="1" vertex="1">
                    <mxGeometry x="400" y="340" width="320" height="140" as="geometry" />
                </mxCell>
                <mxCell id="delete-commands" value="클러스터 삭제:&#10;• eksctl delete cluster --name=my-cluster&#10;• eksctl delete cluster --name=my-cluster --region=us-west-2&#10;&#10;노드 그룹 삭제:&#10;• eksctl delete nodegroup --cluster=my-cluster --name=my-nodegroup&#10;&#10;Fargate 프로필 삭제:&#10;• eksctl delete fargateprofile --cluster=my-cluster --name=my-fargate-profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;strokeWidth=2;fontFamily=Noto Sans CJK KR;" parent="1" vertex="1">
