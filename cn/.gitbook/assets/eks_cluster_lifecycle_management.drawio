                <mxCell id="best-practices-title" value="모범 사례" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontFamily=Noto Sans CJK KR;" parent="1" vertex="1">
