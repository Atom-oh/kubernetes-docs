        </mxCell>
        
        
        <mxCell id="deletion-commands" value="삭제 명령어" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="command-examples" value="# LoadBalancer 서비스 삭제&#10;kubectl delete svc --all --field-selector spec.type=LoadBalancer&#10;&#10;# PVC 삭제&#10;kubectl delete pvc --all --all-namespaces&#10;&#10;# 노드 그룹 삭제&#10;eksctl delete nodegroup --cluster=my-cluster --name=my-nodegroup&#10;&#10;# 클러스터 삭제&#10;eksctl delete cluster --name=my-cluster" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Noto Sans CJK KR;spacingTop=5;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="200" height="90" as="geometry" />
        </mxCell>
        
        
        <mxCell id="cost-considerations" value="비용 고려사항" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="180" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="cost-items" value="💰 EBS 볼륨 자동 삭제 안됨&#10;💰 LoadBalancer 요금 지속&#10;💰 NAT Gateway 요금 지속&#10;💰 Elastic IP 요금 지속&#10;💰 CloudWatch 로그 보관 요금&#10;💰 백업 스냅샷 요금&#10;💰 미사용 보안 그룹 정리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;spacingTop=5;spacingLeft=10;strokeWidth=2;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1">
